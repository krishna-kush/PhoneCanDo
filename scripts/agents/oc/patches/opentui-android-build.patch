diff --git a/packages/native/src/android-pthread-shim.c b/packages/native/src/android-pthread-shim.c
new file mode 100644
index 0000000..bac3ef1
--- /dev/null
+++ b/packages/native/src/android-pthread-shim.c
@@ -0,0 +1,14 @@
+// Bionic compatibility shim (Android only).
+//
+// glibc's pthread_tryjoin_np does not exist on Android, but
+// src/clipboard/host.zig references it, which fails dlopen of the whole
+// library. Semantics preserved: join iff already terminated (never blocks),
+// EBUSY while the thread is still alive.
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+
+int pthread_tryjoin_np(pthread_t thread, void **retval) {
+  if (pthread_kill(thread, 0) == 0) return EBUSY;
+  return pthread_join(thread, retval);
+}
