#!/usr/bin/env python3
"""PhoneCanDo: one entry point for the repo's scripts.

  ./manage release 0.1.2 --notes "What changed."   build full + lite, draft GitHub release
  ./manage release 0.1.2 --notes "..." --publish   same, then publish
  ./manage release 0.1.2 --dry-run                 check env, edits, CI and Linux payloads, no build
  ./manage release 0.1.2 --upload-only [--publish] re-upload staged assets, no build
  ./manage release 0.1.2 --allow-red-ci            release despite red CI (noted in the release notes)
  ./manage release 0.1.2 --without-linux           full + lite with no proot/Default image staged
  ./manage build lite|full [--clean]               signed local APK -> dist/<channel>/
  ./manage prebuild [--clean]                      re-apply config plugins to app/android
  ./manage android lite|full|play                  dev build + install on the adb device
  ./manage check                                   tsc + key/reconcile vectors
  ./manage logos                                   regenerate brand assets from theme/
  ./manage xterm                                   re-inline the terminal page bundle
  ./manage web dev|build                           the website
  ./manage engine oc build|stage [args]            opencode payload (scripts/agents/oc)
  ./manage image fetch|stage                       locked Default env image -> dist/images/ -> app assets
  ./manage image build|stage --local               unlocked local image -> dist/images/local/ -> debug builds only
  ./manage image lock <run-id>                     lock what a green lre-image run published
  ./manage apk info <file.apk>                     package, version, channel, signer, a11y
  ./manage device push <file.apk>                  copy to /sdcard/Download/phonecando/
  ./manage device log                              logcat for update / install / Play Protect
  ./manage stats [--d1]                            GitHub download counts; --d1 adds D1 usage (cf CLI)
  ./manage limits [--strict]                       usage vs the Cloudflare free plan (warns at 70%)
  ./manage data [--days N] [--testers] [--report]  usage data from Cloudflare, interactive in a terminal

Defaults: GITHUB_REPO from app/src/engine/updates.ts, PHONECANDO_RELEASE_ENV
from the repo-root .env (release signing, TCE_READ_TOKEN; .env.example lists
the keys), ANDROID_HOME from /opt/android-sdk.
build and release run the limits check and print the data report first;
neither ever blocks them.
Never runs git itself; release-android.mjs runs read-only git (rev-parse,
status) in its preflight.
"""
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
APP = ROOT / "app"
WEB = ROOT / "web"
SCRIPTS = ROOT / "scripts"
TCE = ROOT / "tce"
CHANNELS = ("lite", "full", "play")
# Agent kinds whose engine payload builds here (scripts/agents/<kind>/).
ENGINE_KINDS = ("oc",)
# The baked Default env image: its build and its lock (lock/<action>.sh).
IMAGE = ROOT / "lre" / "images" / "default"
IMAGE_LOCK = IMAGE / "lock"


def sh(cmd, cwd=ROOT, env=None):
    print("$ " + " ".join(cmd), flush=True)
    r = subprocess.run(cmd, cwd=str(cwd), env=env or os.environ.copy())
    if r.returncode != 0:
        sys.exit(r.returncode)


def capture(cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=False).stdout


def die(msg):
    print(f"manage: {msg}", file=sys.stderr)
    sys.exit(2)


def local_env_file():
    # The repo-root .env (gitignored) holds the release signing settings and
    # TCE_READ_TOKEN. The old ~/.config path is used only while .env is absent.
    local = ROOT / ".env"
    legacy = Path.home() / ".config/phonecando/release.env"
    return local if local.exists() or not legacy.exists() else legacy


def release_env():
    env = os.environ.copy()
    env.setdefault("ANDROID_HOME", "/opt/android-sdk")
    env.setdefault("PHONECANDO_RELEASE_ENV", str(local_env_file()))
    if "GITHUB_REPO" not in env:
        m = re.search(r"const REPO = '([^']+)'", (APP / "src/engine/updates.ts").read_text())
        if m:
            env["GITHUB_REPO"] = m.group(1)
    return env


def build_tools():
    sdk = os.environ.get("ANDROID_HOME") or os.environ.get("ANDROID_SDK_ROOT") or "/opt/android-sdk"
    bt = Path(sdk) / "build-tools"
    versions = sorted(
        (p for p in bt.iterdir() if re.fullmatch(r"\d+(\.\d+)+", p.name)),
        key=lambda p: [int(x) for x in p.name.split(".")],
    )
    if not versions:
        die(f"no build-tools under {bt}")
    return versions[-1]


def channel_arg(args):
    if not args or args[0] not in CHANNELS:
        die(f"channel must be one of {', '.join(CHANNELS)}")
    return args[0]


def limits_first():
    # The free-plan check (tce/scripts/check-limits.mjs) and the usage data
    # report (tce/scripts/data.mjs --report, aggregates only) run on every
    # build. Never blocks: a failure or a missing node only prints a note
    # before the build goes on.
    for name, script, args in (("limits check", "check-limits.mjs", []), ("data report", "data.mjs", ["--report"])):
        try:
            sh(["node", str(TCE / "scripts" / script), *args], env=release_env())
        except SystemExit:
            print(f"manage: {name} failed; continuing", file=sys.stderr)
        except OSError as e:
            print(f"manage: {name} skipped ({e}); continuing", file=sys.stderr)


def cmd_release(args):
    if not args or args[0].startswith("--"):
        die("usage: manage release <version> [--notes TEXT] [--publish] [--dry-run] "
            "[--upload-only] [--allow-red-ci] [--without-linux]")
    limits_first()
    sh(["node", str(SCRIPTS / "release-android.mjs"), "--version", args[0], *args[1:]], env=release_env())


def cmd_build(args):
    ch = channel_arg(args)
    if ch == "play":
        die("play is a later feature; build lite or full")
    limits_first()
    sh(["node", str(SCRIPTS / "build-android.mjs"), ch, *args[1:]], env=release_env())


def cmd_prebuild(args):
    sh(["pnpm", "prebuild:clean" if "--clean" in args else "prebuild"], cwd=APP)


def cmd_android(args):
    sh(["pnpm", f"android:{channel_arg(args)}"], cwd=APP)


def cmd_check(args):
    sh(["npx", "tsc", "--noEmit", "-p", "."], cwd=APP)
    sh(["pnpm", "check:vectors"], cwd=APP)


def cmd_logos(args):
    sh(["node", str(SCRIPTS / "make-logos.mjs")])


def cmd_xterm(args):
    sh(["node", "scripts/inline-xterm.js"], cwd=APP)


def cmd_web(args):
    if not args or args[0] not in ("dev", "build", "preview"):
        die("usage: manage web dev|build|preview")
    sh(["pnpm", args[0]], cwd=WEB)


def cmd_engine(args):
    if len(args) < 2 or args[0] not in ENGINE_KINDS or args[1] not in ("build", "stage"):
        die(f"usage: manage engine {'|'.join(ENGINE_KINDS)} build|stage [args]")
    sh([str(SCRIPTS / "agents" / args[0] / f"{args[1]}.sh"), *args[2:]])


def cmd_image(args):
    # fetch/stage: the image lock.json names (sha256-checked); lock: write
    # lock.json from a green run (read-only gh api; you commit the file).
    # build: our own image (docker; on an x86_64 host arm64 runs under
    # qemu-user, 15-20 min); stage --local puts it on debug builds only.
    valid = args in (["fetch"], ["stage"], ["build"], ["stage", "--local"]) or (
        len(args) == 2 and args[0] == "lock")
    if not valid:
        die("usage: manage image fetch|stage | build|stage --local | lock <run-id>")
    if args[0] == "build":
        sh([str(IMAGE / "build.sh"), str(ROOT / "dist" / "images" / "local")])
    else:
        sh([str(IMAGE_LOCK / f"{args[0]}.sh"), *args[1:]])


def cmd_apk(args):
    if len(args) < 2 or args[0] != "info":
        die("usage: manage apk info <file.apk>")
    apk = Path(args[1])
    if not apk.is_file():
        die(f"no such file: {apk}")
    bt = build_tools()
    badging = capture([str(bt / "aapt"), "dump", "badging", str(apk)])
    pkg = next((l for l in badging.splitlines() if l.startswith("package:")), "package: ?")
    manifest = capture([str(bt / "aapt"), "dump", "xmltree", str(apk), "AndroidManifest.xml"])
    chan = re.search(r'com\.phonecando\.channel.*?\n.*?android:value.*?"([a-z]+)"', manifest, re.S)
    certs = capture([str(bt / "apksigner"), "verify", "--print-certs", str(apk)])
    signer = next((l.strip() for l in certs.splitlines() if "SHA-256" in l), "signer: ?")
    print(pkg)
    print(f"channel: {chan.group(1) if chan else '?'}")
    print(f"accessibility service: {'yes' if 'BIND_ACCESSIBILITY_SERVICE' in manifest else 'no'}")
    print(f"size: {apk.stat().st_size} bytes")
    print(signer)


def cmd_device(args):
    if not args:
        die("usage: manage device push <file.apk> | log")
    if args[0] == "push":
        if len(args) < 2 or not Path(args[1]).is_file():
            die("usage: manage device push <file.apk>")
        sh(["adb", "shell", "mkdir", "-p", "/sdcard/Download/phonecando"])
        sh(["adb", "push", args[1], "/sdcard/Download/phonecando/"])
        print("Open it from Files → Downloads → phonecando on the phone (not adb install).")
    elif args[0] == "log":
        sh(["adb", "logcat", "-c"])
        sh(["adb", "logcat", "-v", "time", "-s", "phonecando-update", "ReactNativeJS:I",
            "PackageInstaller:V", "PackageManager:I", "Finsky:I"])
    else:
        die("usage: manage device push <file.apk> | log")



def cmd_stats(args):
    # Read-only. GITHUB_TOKEN (optional) raises the API rate limit; --d1 needs
    # the cf CLI logged in. See tce/README.md.
    sh(["node", str(TCE / "scripts" / "stats.mjs"), *args])


def cmd_data(args):
    # Read-only: D1 through TCE_READ_TOKEN (from .env; it also adds the
    # Analytics Engine detail) or else the cf CLI login. Interactive in a
    # terminal; --report prints the plain report. See tce/README.md, Usage data.
    sh(["node", str(TCE / "scripts" / "data.mjs"), *args], env=release_env())


def cmd_limits(args):
    # Read-only: GET /v1/health on the live API host; with CLOUDFLARE_API_TOKEN
    # and CLOUDFLARE_ACCOUNT_ID also today's D1 rows and Worker requests.
    sh(["node", str(TCE / "scripts" / "check-limits.mjs"), *args])


COMMANDS = {
    "release": cmd_release,
    "build": cmd_build,
    "prebuild": cmd_prebuild,
    "android": cmd_android,
    "check": cmd_check,
    "logos": cmd_logos,
    "xterm": cmd_xterm,
    "web": cmd_web,
    "engine": cmd_engine,
    "image": cmd_image,
    "apk": cmd_apk,
    "device": cmd_device,
    "stats": cmd_stats,
    "limits": cmd_limits,
    "data": cmd_data,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    fn = COMMANDS.get(argv[0])
    if fn is None:
        die(f"unknown command {argv[0]!r}; run ./manage help")
    fn(argv[1:])


if __name__ == "__main__":
    main(sys.argv[1:])
