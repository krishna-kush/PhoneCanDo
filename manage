#!/bin/sh
# PhoneCanDo: one entry point for the repo's scripts (scripts/manage/main.mjs).
# Needs Node 22+, as pnpm does. ./manage help lists every command.
command -v node > /dev/null 2>&1 || { echo "manage: needs Node 22+ (node is not on PATH)" >&2; exit 2; }
exec node "$(dirname "$0")/scripts/manage/main.mjs" "$@"
