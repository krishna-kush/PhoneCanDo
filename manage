#!/usr/bin/env python3
"""PhoneCanDo: one entry point for the repo's scripts. ./manage help lists every
command, grouped (scripts/manage/usage.py)."""
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "scripts"))

from manage import usage
from manage.args import channel_arg, die
from manage.before_build import agents_first, limits_first, proot_first, split_agent_flags
from manage.env import build_tools, release_env
from manage.paths import AGENT_KIT, AGENTS, APP, IMAGE, IMAGE_LOCK, ROOT, SCRIPTS, TCE, WEB
from manage.run import capture, sh

# What a release ships; build makes one of them.
RELEASED = ["full", "lite"]


def cmd_release(args):
    if not args or args[0].startswith("--"):
        die("usage: manage release <version> [--notes TEXT] [--publish] [--dry-run] "
            "[--upload-only] [--allow-red-ci] [--without-linux] [--rebuild <ids>] [--download <ids>]")
    flags, rest = split_agent_flags(args[1:])
    limits_first()
    proot_first(rest)
    agents_first(rest, RELEASED, flags, release=True)
    sh(["node", str(SCRIPTS / "release-android.mjs"), "--version", args[0], *rest], env=release_env())


def cmd_build(args):
    ch = channel_arg(args)
    if ch == "play":
        die("play is a later feature; build lite or full")
    flags, rest = split_agent_flags(args[1:])
    limits_first()
    proot_first(rest)
    agents_first(rest, [ch], flags)
    sh(["node", str(SCRIPTS / "build-android.mjs"), ch, *rest], env=release_env())


def cmd_prebuild(args):
    sh(["pnpm", "prebuild:clean" if "--clean" in args else "prebuild"], cwd=APP)


def cmd_android(args):
    sh(["pnpm", f"android:{channel_arg(args)}"], cwd=APP)


def cmd_check(args):
    sh(["npx", "tsc", "--noEmit", "-p", "."], cwd=APP)
    sh(["pnpm", "check:vectors"], cwd=APP)


def cmd_logos(args):
    sh(["node", str(SCRIPTS / "make-logos.mjs")])


def cmd_xterm(args):
    sh(["node", "scripts/inline-xterm.js"], cwd=APP)


def cmd_web(args):
    if not args or args[0] not in ("dev", "build", "preview"):
        die("usage: manage web dev|build|preview")
    sh(["pnpm", args[0]], cwd=WEB)


def agent_kinds():
    # id -> its folder, for every agents/<native|image>/<id>/agent.json.
    return {p.parent.name: p.parent for p in sorted(AGENTS.glob("*/*/agent.json"))
            if p.parent.parent.name in ("native", "image")}


AGENT_USAGE = ("usage: manage agent list|check | status|sync [channel...] | new <id> --native|--image "
               "| <id> build|stage|lock|test [args]")
NATIVE = AGENT_KIT / "native"


def cmd_agent(args):
    # list/check/new go to the kit's CLI (agents/kit/cli/), status and sync
    # to the payloads' ensure step (agents/kit/native/ensure.mjs: status only
    # reports, sync makes them current, as build does first); <id>
    # build|stage|lock|test act on one kind. The ids new/list/check/status/
    # sync/kit are reserved, so they never shadow a kind.
    if not args:
        die(AGENT_USAGE)
    if args[0] in ("list", "check"):
        sh(["node", str(AGENT_KIT / "cli" / f"{args[0]}.mjs"), *args[1:]])
        return
    if args[0] in ("status", "sync"):
        flags, channels = split_agent_flags(args[1:])
        channels = channels or RELEASED
        if any(ch not in ("full", "lite", "play") for ch in channels) or (flags and args[0] == "status"):
            die("usage: manage agent status [channel...] | sync [channel...] [--rebuild <ids>] [--download <ids>]")
        check = ["--check"] if args[0] == "status" else []
        sh(["node", str(NATIVE / "ensure.mjs"), *check, *channels, *flags], env=release_env())
        return
    if args[0] == "new":
        if len(args) < 3 or "--native" not in args and "--image" not in args:
            die("usage: manage agent new <id> --native|--image [--prefix <p>]")
        sh(["node", str(AGENT_KIT / "cli" / "new.mjs"), *args[1:]])
        return
    kinds = agent_kinds()
    if args[0] not in kinds or len(args) < 2 or args[1] not in ("build", "stage", "lock", "test"):
        die(f"{AGENT_USAGE}; kinds: {', '.join(kinds) or 'none'}")
    kind_id, action, rest = args[0], args[1], args[2:]
    folder = kinds[kind_id]
    native = folder.parent.name == "native"
    if action in ("build", "stage", "lock") and not native:
        die(f"{kind_id} is an image kind: it installs into the Linux image, nothing to {action}")
    if action == "build":
        sh(["node", str(NATIVE / "build.mjs"), kind_id, *rest])
    elif action == "stage":
        if not rest:
            die(f"usage: manage agent {kind_id} stage <build-out> [dest]")
        sh(["node", str(NATIVE / "stage.mjs"), kind_id, *rest])
    elif action == "lock":
        sh(["node", str(NATIVE / "lock.mjs"), kind_id])
    else:
        if (folder / "kotlin" / "build.gradle.kts").exists():
            sh([str(AGENTS / "gradlew"), f":{kind_id}:test"], cwd=AGENTS)
        sh(["pnpm", "test"], cwd=AGENTS)


def cmd_image(args):
    # fetch/stage: the image lock.json names (sha256-checked); lock: write
    # lock.json from a green run (read-only gh api; you commit the file).
    # build: our own image (docker; on an x86_64 host arm64 runs under
    # qemu-user, 15-20 min); stage --local puts it on debug builds only.
    valid = args in (["fetch"], ["stage"], ["build"], ["stage", "--local"]) or (
        len(args) == 2 and args[0] == "lock")
    if not valid:
        die("usage: manage image fetch|stage | build|stage --local | lock <run-id>")
    if args[0] == "build":
        sh([str(IMAGE / "build.sh"), str(ROOT / "dist" / "images" / "local")])
    else:
        sh([str(IMAGE_LOCK / f"{args[0]}.sh"), *args[1:]])


def cmd_apk(args):
    if len(args) < 2 or args[0] != "info":
        die("usage: manage apk info <file.apk>")
    apk = Path(args[1])
    if not apk.is_file():
        die(f"no such file: {apk}")
    bt = build_tools()
    badging = capture([str(bt / "aapt"), "dump", "badging", str(apk)])
    pkg = next((line for line in badging.splitlines() if line.startswith("package:")), "package: ?")
    manifest = capture([str(bt / "aapt"), "dump", "xmltree", str(apk), "AndroidManifest.xml"])
    chan = re.search(r'com\.phonecando\.channel.*?\n.*?android:value.*?"([a-z]+)"', manifest, re.S)
    certs = capture([str(bt / "apksigner"), "verify", "--print-certs", str(apk)])
    signer = next((line.strip() for line in certs.splitlines() if "SHA-256" in line), "signer: ?")
    print(pkg)
    print(f"channel: {chan.group(1) if chan else '?'}")
    print(f"accessibility service: {'yes' if 'BIND_ACCESSIBILITY_SERVICE' in manifest else 'no'}")
    print(f"size: {apk.stat().st_size} bytes")
    print(signer)


def cmd_device(args):
    if not args:
        die("usage: manage device push <file.apk> | log")
    if args[0] == "push":
        if len(args) < 2 or not Path(args[1]).is_file():
            die("usage: manage device push <file.apk>")
        sh(["adb", "shell", "mkdir", "-p", "/sdcard/Download/phonecando"])
        sh(["adb", "push", args[1], "/sdcard/Download/phonecando/"])
        print("Open it from Files → Downloads → phonecando on the phone (not adb install).")
    elif args[0] == "log":
        sh(["adb", "logcat", "-c"])
        sh(["adb", "logcat", "-v", "time", "-s", "phonecando-update", "ReactNativeJS:I",
            "PackageInstaller:V", "PackageManager:I", "Finsky:I"])
    else:
        die("usage: manage device push <file.apk> | log")


def cmd_stats(args):
    # Read-only. GITHUB_TOKEN (optional) raises the API rate limit; --d1 needs
    # the cf CLI logged in. See tce/README.md.
    sh(["node", str(TCE / "scripts" / "stats.mjs"), *args])


def cmd_data(args):
    # Read-only: D1 through TCE_READ_TOKEN (from .env; it also adds the
    # Analytics Engine detail) or else the cf CLI login. Interactive in a
    # terminal; --report prints the plain report. See tce/README.md, Usage data.
    sh(["node", str(TCE / "scripts" / "data.mjs"), *args], env=release_env())


def cmd_limits(args):
    # Read-only: GET /v1/health on the live API host; with CLOUDFLARE_API_TOKEN
    # and CLOUDFLARE_ACCOUNT_ID also today's D1 rows and Worker requests.
    sh(["node", str(TCE / "scripts" / "check-limits.mjs"), *args])


COMMANDS = {
    "release": cmd_release,
    "build": cmd_build,
    "prebuild": cmd_prebuild,
    "android": cmd_android,
    "check": cmd_check,
    "logos": cmd_logos,
    "xterm": cmd_xterm,
    "web": cmd_web,
    "agent": cmd_agent,
    "image": cmd_image,
    "apk": cmd_apk,
    "device": cmd_device,
    "stats": cmd_stats,
    "limits": cmd_limits,
    "data": cmd_data,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(usage.render())
        return
    fn = COMMANDS.get(argv[0])
    if fn is None:
        die(f"unknown command {argv[0]!r}; run ./manage help")
    fn(argv[1:])


if __name__ == "__main__":
    main(sys.argv[1:])
