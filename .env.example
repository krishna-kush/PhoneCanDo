# Local secrets for this repo. Copy to .env (gitignored), `chmod 600 .env`,
# fill in. Never commit .env. ./manage and scripts/build-android.mjs read it by
# default (PHONECANDO_RELEASE_ENV points to another file); the Android release
# scripts source it with bash, so keep plain KEY=value lines.

# Release signing (app/plugins/withReleaseSigning.js, docs/release/android.md).
PHONECANDO_STORE_FILE=/absolute/path/to/phonecando-release.keystore
PHONECANDO_STORE_PASSWORD=
PHONECANDO_KEY_ALIAS=phonecando
PHONECANDO_KEY_PASSWORD=

# Usage data (./manage data; tce/README.md, Usage data): a read-only Cloudflare
# API token with D1: Read and Account Analytics: Read. Without it, the logged-in
# cf CLI is used (D1 only). Never a Cloudflare build secret.
TCE_READ_TOKEN=
# The account the token reads (dashboard → Account home → Account ID; not a
# secret). A read-only token usually cannot look it up by itself.
CLOUDFLARE_ACCOUNT_ID=
