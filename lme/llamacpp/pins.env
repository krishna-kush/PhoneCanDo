# Pinned inputs for our llama.cpp build (lme/llamacpp). Plain KEY=value
# lines: build.sh sources this file and CI reads it into the job env
# (llamacpp.yml), so keep values literal (no $expansions). Every download is
# sha256-verified before use; a bump edits the version, URL and sha256
# together, and checks lme/host's LlamaCppRuntime flags against the new
# server's --help.

# llama.cpp (MIT), release tag v0.9.0, GitHub's tag archive. The version our
# device spike ran on the Moto g96 (2026-11-08).
LLAMACPP_VERSION=0.9.0
LLAMACPP_URL=https://github.com/ggml-org/llama.cpp/archive/refs/tags/v0.9.0.tar.gz
LLAMACPP_SHA256=5d0f1aaf55fd8629c29a55e81b7cb63b80239f83c33a580963071204896836a8

# KleidiAI (Apache-2.0), Arm's CPU kernels ggml dispatches to at run time.
# The release llama.cpp v0.9.0 names (ggml/src/ggml-cpu/CMakeLists.txt,
# which only checks an MD5); we fetch it ourselves and check the sha256.
KLEIDIAI_VERSION=1.32.0
KLEIDIAI_URL=https://github.com/ARM-software/kleidiai/releases/download/v1.32.0/kleidiai-v1.32.0-src.tar.gz
KLEIDIAI_SHA256=a48d373e7c5d721a0aecbf5ddaf0bdf245bc8064e6b84086f13db0e102b553a6

# Android target: aarch64, our minSdk, the NDK proot builds with too.
ANDROID_API=29
NDK_VERSION=r28c

# The CPU the build may assume: ARMv8.2 with dot product and fp16
# (Cortex-A55/A75 and newer). lme/host's LlamaCppRuntime refuses a phone
# without them (REQUIRED_CPU_FEATURES) instead of letting it crash.
CPU_ARCH=armv8.2-a+dotprod+fp16
