+// PhoneCanDo patch, used only when the template refused the messages as sent
+// (common_chat_templates_apply): templates such as Qwen3.5's allow one system
+// message, first, but agents send more (Codex starts with two developer
+// messages, Claude Code puts its environment block after the user turn). The
+// leading run of system messages becomes one, their text a blank line apart.
+// A later one becomes "[System note]\n<text>": at the end of the user or tool
+// message before it, else at the start of the user message after it, else
+// (after an assistant turn) a user message of its own. Blank ones are dropped.
+
+static json text_content(const std::string & text, bool typed) {
+    return typed ? json::array({ json{ {"type", "text"}, {"text", text} } }) : json(text);
+}
+
+// text added before or after content, a blank line apart; in text parts it
+// joins the part next to it (templates such as Gemma 4's trim each part)
+static json add_text(const json & content, const std::string & text, bool before) {
+    if (!content.is_array()) {
+        const std::string s = content.is_string() ? content.get<std::string>() : "";
+        return json(s.empty() ? text : before ? text + "\n\n" + s : s + "\n\n" + text);
+    }
+    json parts = content;
+    if (!parts.empty()) {
+        json & edge = before ? parts.front() : parts.back();
+        if (edge.value("type", "") == "text") {
+            const std::string t = edge.value("text", "");
+            edge["text"]        = before ? text + "\n\n" + t : t + "\n\n" + text;
+            return parts;
+        }
+    }
+    if (!before) {
+        parts.push_back(text_content(text, true).at(0));
+        return parts;
+    }
+    json out = text_content(text, true);
+    out.insert(parts);
+    return out;
+}
+
+static void fold_system_messages(json & messages) {
+    json   out = json::array();
+    size_t i   = 0;
+    while (i < messages.size()) {
+        if (messages.at(i).at("role") != "system") {
+            out.push_back(messages.at(i++));
+            continue;
+        }
+        const bool  leading = i == 0;
+        std::string text;
+        bool        typed = false;
+        for (; i < messages.size() && messages.at(i).at("role") == "system"; i++) {
+            const json        content = messages.at(i).value("content", json());
+            const std::string t       = trim_whitespace(
+                content.is_array()  ? messages_inp_normalizer::concat_content_parts(content) :
+                content.is_string() ? content.get<std::string>() : "");
+            typed = typed || content.is_array();
+            if (!t.empty()) {
+                text += text.empty() ? t : "\n\n" + t;
+            }
+        }
+        if (text.empty()) {
+            continue;
+        }
+        const std::string note = "[System note]\n" + text;
+        if (leading) {
+            out.push_back({ {"role", "system"}, {"content", text_content(text, typed)} });
+        } else if (out.back().at("role") == "user" || out.back().at("role") == "tool") {
+            out.back()["content"] = add_text(out.back().value("content", json()), note, false);
+        } else if (i < messages.size() && messages.at(i).at("role") == "user") {
+            json next       = messages.at(i++);
+            next["content"] = add_text(next.value("content", json()), note, true);
+            out.push_back(next);
+        } else {
+            out.push_back({ {"role", "user"}, {"content", text_content(note, typed)} });
+        }
+    }
+    messages = std::move(out);
+}
+
 
