{
  "general": {
    "enableAutoUpdate": false
  },
  "mcpServers": {
    "phonecando": {
      "httpUrl": "${PHONECANDO_BRIDGE_URL}/mcp",
      "headers": {
        "Authorization": "Bearer ${PHONECANDO_BRIDGE_TOKEN}"
      }
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /root/.phonecando/bin/phonecando-event UserPromptSubmit",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /root/.phonecando/bin/phonecando-inbox UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /root/.phonecando/bin/phonecando-inbox PostToolBatch",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh /root/.phonecando/bin/phonecando-event PermissionRequest",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /root/.phonecando/bin/phonecando-event Stop",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -q '\"stop_hook_active\": *true' || sh /root/.phonecando/bin/phonecando-inbox Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /root/.phonecando/bin/phonecando-event StopFailure",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
