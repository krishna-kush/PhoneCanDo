{
  "schema": 1,
  "id": "cline",
  "label": "Cline",
  "version": "1",
  "type": "image",
  "channels": ["full", "lite"],
  "stability": "preview",
  "licence": {
    "spdx": "Apache-2.0",
    "redistributed": false,
    "notice": "NOTICE.md",
    "terms": "https://cline.bot/tos",
    "source": "https://github.com/cline/cline"
  },
  "about": {
    "checked": "2026-11-17",
    "maker": "Cline Bot Inc.",
    "links": {
      "home": "https://cline.bot",
      "guide": "https://docs.cline.bot/usage/cli-overview",
      "keys": "https://app.cline.bot",
      "plans": "https://cline.bot/pricing"
    },
    "free": { "via": "models", "note": "Free promo models with a Cline account; they rotate" },
    "move": { "keys": "Tab", "does": "Flips between Plan and Act modes" }
  },
  "requires": {
    "linux": "required",
    "commands": ["bash", "git", "rg"],
    "runtimes": ["node>=22"]
  },
  "config": {
    "dir": "config",
    "into": ".phonecando/cline",
    "keep": ["cline_mcp_settings.json"],
    "required": ["cline_mcp_settings.json", "phonecando-mcp.mjs", "phonecando.js", "launch.sh"]
  },
  "install": {
    "families": ["apt", "dnf", "pacman", "zypper"],
    "packages": {
      "apt": ["bash", "ca-certificates", "git", "ripgrep"],
      "dnf": ["bash", "ca-certificates", "git", "ripgrep"],
      "pacman": ["bash", "ca-certificates", "git", "ripgrep"],
      "zypper": ["bash", "ca-certificates", "git", "ripgrep"]
    },
    "steps": [
      "npm install -g --prefix \"$HOME/.local\" cline@latest"
    ],
    "timeoutSec": 1800
  },
  "update": {
    "steps": [
      "npm install -g --prefix \"$HOME/.local\" cline@latest"
    ]
  },
  "versionCheck": {
    "argv": ["/root/.local/bin/cline", "--version"],
    "pattern": "(\\d+\\.\\d+\\.\\d+)"
  },
  "state": {
    "env": { "CLINE_DIR": "{{stateDir}}/cline" }
  },
  "userState": [".cline"],
  "engine": {
    "style": "tui",
    "launch": {
      "argv": ["sh", "/root/.phonecando/cline/launch.sh"],
      "env": {
        "CLINE_NO_AUTO_UPDATE": "1",
        "CLINE_MCP_SETTINGS_PATH": "/root/.phonecando/cline/cline_mcp_settings.json",
        "CLINE_PLUGIN_IDLE_TIMEOUT_MS": "2147483647"
      },
      "cwd": "{{projectDir}}"
    },
    "readiness": { "output": { "settleMs": 500, "timeoutSec": 120 } },
    "resume": { "args": ["--phonecando-continue"] },
    "prompt": { "args": ["--tui", "--", "{{prompt}}"] },
    "acp": {
      "argv": ["sh", "/root/.phonecando/cline/launch.sh", "--acp"],
      "env": { "CLINE_SESSION_BACKEND_MODE": "local" },
      "tools": "config",
      "optionsHook": "cline.model",
      "chat": { "args": ["--tui", "--id", "{{chatId}}"] }
    }
  },
  "events": [
    {
      "hook": {
        "map": {
          "RunStart": "working",
          "AskUser": "waiting",
          "AskDone": "working",
          "RunDone": "finished",
          "RunFailed": "failed",
          "RunStopped": "stopped"
        }
      }
    }
  ],
  "inbox": { "reader": true, "wake": "reader" },
  "idle": { "from": ["output", "events"], "quietSec": 120 },
  "surfaces": {
    "home": "tui",
    "terminal": { "shell": true },
    "chatTitle": "^(?!Cline$)(?:> )?(.+)$"
  },
  "phoneTools": "mcp:config",
  "phoneToolsTrust": { "in": "phonecando.js", "has": "phonecando__" },
  "hooks": ["cline.model"],
  "signIn": [
    { "method": "device-code", "note": "Pick \"Sign in with Cline\" on first start: it shows a code and authkit.cline.bot/device; open that page and enter the code." },
    { "method": "api-key", "note": "Or pick \"Bring your own provider\" and paste an API key (or run cline auth in this machine's terminal)." }
  ]
}
