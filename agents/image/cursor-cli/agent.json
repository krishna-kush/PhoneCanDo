{
  "schema": 1,
  "id": "cursor-cli",
  "label": "Cursor CLI",
  "version": "1",
  "type": "image",
  "channels": ["full", "lite"],
  "stability": "preview",
  "licence": {
    "spdx": null,
    "redistributed": false,
    "notice": "NOTICE.md",
    "terms": "https://cursor.com/terms-of-service",
    "source": "https://cursor.com/cli"
  },
  "requires": {
    "linux": "required",
    "commands": ["bash", "git"]
  },
  "config": {
    "dir": "config",
    "into": ".phonecando/cursor",
    "required": [".cursor-plugin/plugin.json", "hooks/hooks.json", "mcp.json"]
  },
  "install": {
    "families": ["apt", "dnf", "pacman", "zypper"],
    "packages": {
      "apt": ["bash", "ca-certificates", "curl", "git", "tar"],
      "dnf": ["bash", "ca-certificates", "git", "tar"],
      "pacman": ["bash", "ca-certificates", "curl", "git", "tar"],
      "zypper": ["bash", "ca-certificates", "curl", "git", "tar"]
    },
    "steps": [
      "curl -fsS https://cursor.com/install -o /tmp/cursor-install.sh",
      "bash /tmp/cursor-install.sh",
      "rm -f /tmp/cursor-install.sh"
    ],
    "timeoutSec": 1200
  },
  "update": {
    "steps": [
      "curl -fsS https://cursor.com/install -o /tmp/cursor-install.sh",
      "bash /tmp/cursor-install.sh",
      "rm -f /tmp/cursor-install.sh"
    ]
  },
  "versionCheck": {
    "argv": ["/root/.local/bin/cursor-agent", "--version"],
    "pattern": "(\\d{4}\\.\\d{2}\\.\\d{2}-[0-9a-f]+)"
  },
  "userState": [".cursor", ".config/cursor"],
  "engine": {
    "style": "tui",
    "launch": {
      "argv": ["/root/.local/bin/cursor-agent", "--plugin-dir", "/root/.phonecando/cursor"],
      "cwd": "{{projectDir}}"
    },
    "readiness": { "output": { "settleMs": 500, "timeoutSec": 120 } },
    "resume": { "args": ["--continue"], "at": 1 },
    "prompt": { "args": ["--", "{{prompt}}"] }
  },
  "events": [
    {
      "hook": {
        "map": {
          "beforeSubmitPrompt": "working",
          "stop": "finished"
        }
      }
    }
  ],
  "inbox": {
    "hooks": {
      "postToolUse": {
        "format": "json",
        "template": { "additional_context": "{{messages}}" }
      },
      "stop": {
        "format": "json",
        "template": { "followup_message": "{{messages}}" }
      }
    }
  },
  "idle": { "from": ["output", "events"], "quietSec": 120 },
  "surfaces": {
    "home": "tui",
    "terminal": { "shell": true }
  },
  "phoneTools": "mcp:config",
  "signIn": [
    { "method": "browser", "note": "Press a key at \"Press any key to log in\" (or run /login): open the Cursor link it shows and sign in with your Cursor account." },
    { "method": "api-key", "note": "A Cursor API key works too: set CURSOR_API_KEY in this machine's environment." }
  ]
}
