{
  "schema": 1,
  "id": "pi",
  "label": "pi",
  "version": "1",
  "type": "image",
  "channels": ["full", "lite"],
  "stability": "preview",
  "licence": {
    "spdx": "MIT",
    "redistributed": false,
    "notice": "NOTICE.md",
    "source": "https://github.com/earendil-works/pi"
  },
  "requires": {
    "linux": "required",
    "commands": ["bash", "git", "rg"],
    "runtimes": ["node>=22"]
  },
  "config": {
    "dir": "config",
    "into": ".phonecando/pi",
    "required": ["phonecando.ts", "messages.ts", "inbox.ts"]
  },
  "install": {
    "families": ["apt", "apk", "dnf", "pacman", "zypper"],
    "packages": {
      "apt": ["bash", "ca-certificates", "fd-find", "git", "ripgrep"],
      "apk": ["bash", "ca-certificates", "fd", "git", "ripgrep"],
      "dnf": ["bash", "ca-certificates", "fd-find", "git", "ripgrep"],
      "pacman": ["bash", "ca-certificates", "fd", "git", "ripgrep"],
      "zypper": ["bash", "ca-certificates", "fd", "git", "ripgrep"]
    },
    "steps": [
      "npm install -g --prefix \"$HOME/.local\" @earendil-works/pi-coding-agent@latest"
    ],
    "timeoutSec": 1800
  },
  "update": {
    "steps": [
      "npm install -g --prefix \"$HOME/.local\" @earendil-works/pi-coding-agent@latest"
    ]
  },
  "versionCheck": {
    "argv": ["/root/.local/bin/pi", "--version"],
    "pattern": "(?:^|\\n)(\\d+\\.\\d+\\.\\d+)"
  },
  "instructions": ".pi/agent/AGENTS.md",
  "state": {
    "env": { "PI_CODING_AGENT_DIR": "{{stateDir}}/pi" },
    "instructions": "pi/AGENTS.md"
  },
  "userState": [".pi/agent"],
  "engine": {
    "style": "tui",
    "launch": {
      "argv": ["/root/.local/bin/pi", "-e", "/root/.phonecando/pi/phonecando.ts"],
      "env": {
        "PI_SKIP_VERSION_CHECK": "1"
      },
      "cwd": "{{projectDir}}"
    },
    "readiness": { "output": { "settleMs": 500, "timeoutSec": 120 } },
    "resume": { "args": ["--continue"], "at": 1 }
  },
  "events": [
    {
      "hook": {
        "map": {
          "AgentStart": "working",
          "PromptStart": "waiting",
          "AgentSettled": "finished",
          "AgentFailed": "failed"
        }
      }
    },
    {
      "pty": {
        "rules": [
          { "on": "osc7501", "match": "^state=working", "event": "working" },
          { "on": "osc7501", "match": "^state=blocked", "event": "waiting" },
          { "on": "osc7501", "match": "^state=done", "event": "finished" },
          { "on": "osc7501", "match": "^state=error", "event": "failed" },
          { "on": "osc7501", "match": "^state=idle", "event": "stopped" }
        ]
      }
    }
  ],
  "inbox": { "reader": true, "wake": "reader" },
  "idle": { "from": ["output", "events"], "quietSec": 120 },
  "surfaces": {
    "home": "tui",
    "terminal": { "shell": true },
    "chatTitle": "^π - (.+) - [^/]*$"
  },
  "phoneTools": "plugin",
  "signIn": [
    { "method": "in-tui", "note": "Run /login in pi and pick a provider: paste an API key, or sign in with that provider's account (pi shows the link; paste back the code or final page address it asks for)." }
  ]
}
