{
  "schema": 1,
  "id": "mistral-vibe",
  "label": "Mistral Vibe",
  "version": "1",
  "type": "image",
  "channels": [
    "full",
    "lite"
  ],
  "stability": "preview",
  "licence": {
    "spdx": "Apache-2.0",
    "redistributed": false,
    "notice": "NOTICE.md",
    "terms": "https://legal.mistral.ai/terms",
    "source": "https://github.com/mistralai/mistral-vibe"
  },
  "about": {
    "checked": "2026-11-17",
    "maker": "Mistral AI",
    "links": {
      "home": "https://mistral.ai/products/vibe/",
      "guide": "https://docs.mistral.ai/vibe/code/cli/install-setup",
      "keys": "https://chat.mistral.ai/code/extensions",
      "plans": "https://mistral.ai/pricing/"
    },
    "free": { "via": "tier", "note": "Mistral's Free plan: a few coding sessions" },
    "move": { "keys": "/loop every 5m …", "does": "Repeats a prompt on a timer" }
  },
  "requires": {
    "linux": "required",
    "commands": [
      "bash",
      "git",
      "rg"
    ],
    "runtimes": [
      "python"
    ]
  },
  "config": {
    "dir": "config",
    "into": ".vibe-agent",
    "keep": [
      "AGENTS.md"
    ],
    "required": [
      "hooks.toml",
      "AGENTS.md"
    ]
  },
  "install": {
    "families": [
      "apt",
      "dnf",
      "pacman",
      "zypper"
    ],
    "packages": {
      "apt": [
        "bash",
        "ca-certificates",
        "git",
        "ripgrep"
      ],
      "dnf": [
        "bash",
        "ca-certificates",
        "git",
        "ripgrep"
      ],
      "pacman": [
        "bash",
        "ca-certificates",
        "git",
        "ripgrep"
      ],
      "zypper": [
        "bash",
        "ca-certificates",
        "git",
        "ripgrep"
      ]
    },
    "steps": [
      "UV_LINK_MODE=copy uv tool install --force --python 3.12 mistral-vibe@latest",
      "uv cache clean"
    ],
    "timeoutSec": 2400
  },
  "update": {
    "steps": [
      "UV_LINK_MODE=copy uv tool install --force --python 3.12 mistral-vibe@latest",
      "uv cache clean"
    ]
  },
  "versionCheck": {
    "argv": [
      "/root/.local/bin/vibe",
      "--version"
    ],
    "pattern": "vibe (\\d+\\.\\d+\\.\\d+)"
  },
  "instructions": ".vibe-agent/AGENTS.md",
  "state": {
    "env": {
      "VIBE_HOME": "{{stateDir}}/vibe"
    },
    "instructions": "vibe/AGENTS.md",
    "config": "vibe"
  },
  "userState": [
    ".vibe-agent"
  ],
  "engine": {
    "style": "tui",
    "launch": {
      "argv": [
        "sh",
        "-c",
        "if [ -n \"${PHONECANDO_BRIDGE_URL:-}\" ]; then VIBE_MCP_SERVERS='[{\"name\":\"phonecando\",\"transport\":\"streamable-http\",\"url\":\"'\"$PHONECANDO_BRIDGE_URL\"'/mcp\",\"auth\":{\"type\":\"static\",\"api_key_env\":\"PHONECANDO_BRIDGE_TOKEN\"}}]'; export VIBE_MCP_SERVERS; p='{\"permission\":\"always\"}'; t=; for n in mobile_ping mobile_battery mobile_notify mobile_focus mobile_share mobile_open mobile_clipboard agents_list agents_send agents_status agents_inbox agents_wait agents_keep_running schedule_add schedule_list schedule_cancel mobile_describe mobile_observe mobile_act mobile_pack mobile_return mobile_request_unlock mobile_open_accessibility mobile_hand_over mobile_wait_for_user; do t=\"$t${t:+,}\\\"phonecando_$n\\\":$p\"; done; VIBE_TOOLS=\"{$t}\"; export VIBE_TOOLS; fi; exec /root/.local/bin/vibe \"$@\"",
        "vibe"
      ],
      "env": {
        "VIBE_ENABLE_UPDATE_CHECKS": "false",
        "VIBE_HOME": "/root/.vibe-agent"
      },
      "cwd": "{{projectDir}}"
    },
    "readiness": {
      "output": {
        "settleMs": 500,
        "timeoutSec": 180
      }
    },
    "resume": {
      "args": [
        "--continue"
      ]
    },
    "prompt": {
      "args": [
        "--",
        "{{prompt}}"
      ]
    },
    "acp": {
      "argv": [
        "sh",
        "-c",
        "if [ -n \"${PHONECANDO_BRIDGE_URL:-}\" ]; then VIBE_MCP_SERVERS='[{\"name\":\"phonecando\",\"transport\":\"streamable-http\",\"url\":\"'\"$PHONECANDO_BRIDGE_URL\"'/mcp\",\"auth\":{\"type\":\"static\",\"api_key_env\":\"PHONECANDO_BRIDGE_TOKEN\"}}]'; export VIBE_MCP_SERVERS; p='{\"permission\":\"always\"}'; t=; for n in mobile_ping mobile_battery mobile_notify mobile_focus mobile_share mobile_open mobile_clipboard agents_list agents_send agents_status agents_inbox agents_wait agents_keep_running schedule_add schedule_list schedule_cancel mobile_describe mobile_observe mobile_act mobile_pack mobile_return mobile_request_unlock mobile_open_accessibility mobile_hand_over mobile_wait_for_user; do t=\"$t${t:+,}\\\"phonecando_$n\\\":$p\"; done; VIBE_TOOLS=\"{$t}\"; export VIBE_TOOLS; fi; exec /root/.local/bin/vibe-acp \"$@\"",
        "vibe-acp"
      ],
      "tools": "config"
    }
  },
  "events": [
    {
      "pty": {
        "rules": [
          {
            "on": "osc7501",
            "match": "^state=working",
            "event": "working"
          },
          {
            "on": "osc7501",
            "match": "^state=blocked",
            "event": "waiting"
          },
          {
            "on": "osc7501",
            "match": "^state=done",
            "event": "finished"
          },
          {
            "on": "osc7501",
            "match": "^state=error",
            "event": "failed"
          },
          {
            "on": "osc7501",
            "match": "^state=idle",
            "event": "stopped"
          }
        ]
      }
    }
  ],
  "idle": {
    "from": [
      "output"
    ],
    "quietSec": 120
  },
  "surfaces": {
    "home": "tui",
    "terminal": {
      "shell": true
    },
    "chatTitle": "^(?:>> |\\? )?(?!Vibe(?: - |$))(.+?)(?: - (?:Action Required|Task Complete))?$"
  },
  "phoneTools": "mcp:argv",
  "phoneToolsTrust": { "in": "argv", "has": "p='{\"permission\":\"always\"}'" },
  "signIn": [
    {
      "method": "browser",
      "note": "On first start pick the browser sign-in: Vibe shows Mistral's link (the machine has no xdg-open); open it and sign in. Vibe keeps the key in the agent's own ~/.vibe-agent."
    },
    {
      "method": "api-key",
      "note": "Or paste a Mistral API key from console.mistral.ai at Vibe's setup, or put MISTRAL_API_KEY=<key> in ~/.vibe-agent/.env (a vibe you run by hand uses ~/.vibe)."
    }
  ],
  "inbox": {
    "hooks": {
      "pre_agent": {
        "format": "json",
        "template": {
          "hook_specific_output": {
            "additional_context": "{{messages}}"
          }
        }
      },
      "post_tool": {
        "format": "json",
        "template": {
          "hook_specific_output": {
            "additional_context": "{{messages}}"
          }
        }
      },
      "post_agent": {
        "format": "json",
        "template": {
          "decision": "deny",
          "reason": "{{messages}}"
        }
      }
    }
  }
}
