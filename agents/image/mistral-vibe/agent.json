{
  "schema": 1,
  "id": "mistral-vibe",
  "label": "Mistral Vibe",
  "version": "1",
  "type": "image",
  "channels": ["full", "lite"],
  "stability": "preview",
  "licence": {
    "spdx": "Apache-2.0",
    "redistributed": false,
    "notice": "NOTICE.md",
    "terms": "https://legal.mistral.ai/terms",
    "source": "https://github.com/mistralai/mistral-vibe"
  },
  "requires": {
    "linux": "required",
    "commands": ["bash", "git", "rg"],
    "runtimes": ["python"]
  },
  "install": {
    "families": ["apt", "dnf", "pacman", "zypper"],
    "packages": {
      "apt": ["bash", "ca-certificates", "git", "ripgrep"],
      "dnf": ["bash", "ca-certificates", "git", "ripgrep"],
      "pacman": ["bash", "ca-certificates", "git", "ripgrep"],
      "zypper": ["bash", "ca-certificates", "git", "ripgrep"]
    },
    "steps": [
      "UV_LINK_MODE=copy uv tool install --force --python 3.12 mistral-vibe@latest",
      "uv cache clean"
    ],
    "timeoutSec": 2400
  },
  "update": {
    "steps": [
      "UV_LINK_MODE=copy uv tool install --force --python 3.12 mistral-vibe@latest",
      "uv cache clean"
    ]
  },
  "versionCheck": {
    "argv": ["/root/.local/bin/vibe", "--version"],
    "pattern": "vibe (\\d+\\.\\d+\\.\\d+)"
  },
  "engine": {
    "style": "tui",
    "launch": {
      "argv": [
        "sh",
        "-c",
        "if [ -n \"${PHONECANDO_BRIDGE_URL:-}\" ]; then VIBE_MCP_SERVERS='[{\"name\":\"phonecando\",\"transport\":\"streamable-http\",\"url\":\"'\"$PHONECANDO_BRIDGE_URL\"'/mcp\",\"auth\":{\"type\":\"static\",\"api_key_env\":\"PHONECANDO_BRIDGE_TOKEN\"}}]'; export VIBE_MCP_SERVERS; fi; exec /root/.local/bin/vibe \"$@\"",
        "vibe"
      ],
      "env": {
        "VIBE_ENABLE_UPDATE_CHECKS": "false"
      },
      "cwd": "{{projectDir}}"
    },
    "readiness": { "output": { "settleMs": 500, "timeoutSec": 180 } },
    "resume": { "args": ["--continue"] }
  },
  "events": [
    {
      "pty": {
        "rules": [
          { "on": "osc7501", "match": "^state=working", "event": "working" },
          { "on": "osc7501", "match": "^state=blocked", "event": "waiting" },
          { "on": "osc7501", "match": "^state=done", "event": "finished" },
          { "on": "osc7501", "match": "^state=error", "event": "failed" },
          { "on": "osc7501", "match": "^state=idle", "event": "stopped" }
        ]
      }
    }
  ],
  "idle": { "from": ["output"], "quietSec": 120 },
  "surfaces": {
    "home": "tui",
    "terminal": { "shell": true },
    "chatTitle": "^(?:>> |\\? )?(?!Vibe(?: - |$))(.+?)(?: - (?:Action Required|Task Complete))?$"
  },
  "phoneTools": "mcp:argv",
  "signIn": [
    { "method": "browser", "note": "On first start pick the browser sign-in: Vibe shows Mistral's link (the machine has no xdg-open); open it and sign in, and Vibe saves the key to ~/.vibe/.env." },
    { "method": "api-key", "note": "Or paste a Mistral API key from console.mistral.ai at Vibe's setup (or run vibe --setup), or put MISTRAL_API_KEY=<key> in ~/.vibe/.env." }
  ]
}
