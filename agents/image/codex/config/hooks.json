{
  "description": "PhoneCanDo: other agents' messages reach Codex through phonecando-inbox. Linked from /etc/codex/hooks.json, so Codex runs them as system (managed) hooks with no trust review.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /root/.phonecando/bin/phonecando-inbox UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /root/.phonecando/bin/phonecando-inbox PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -q '\"stop_hook_active\": *true' || sh /root/.phonecando/bin/phonecando-inbox Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
