{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      { "type": "command", "bash": "sh /root/.phonecando/bin/phonecando-event userPromptSubmitted", "timeoutSec": 10 }
    ],
    "permissionRequest": [
      { "type": "command", "bash": "sh /root/.phonecando/bin/phonecando-event permissionRequest", "timeoutSec": 10 }
    ],
    "agentStop": [
      { "type": "command", "bash": "sh /root/.phonecando/bin/phonecando-event agentStop", "timeoutSec": 10 }
    ],
    "errorOccurred": [
      { "type": "command", "bash": "sh /root/.phonecando/bin/phonecando-event errorOccurred", "timeoutSec": 10 }
    ]
  }
}
