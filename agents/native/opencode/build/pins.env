# opencode payload pins: the one place they live. build.sh reads them (a
# value already in the env wins, for trying a bump), agent-payload.yml loads
# them into the job env for the toolchain set-up steps, and ci/pins.sh checks
# that the docs name the same versions. A bump edits this file and the docs.
#
# Plain KEY=value lines only (no quotes, no trailing comments): the same file
# is read as shell and as a GitHub Actions env file.

# anomalyco/opencode, pair-era API.
OPENCODE_TAG=v2.0.26
# What the built engine reports as its version: <tag without v>-android-phonecando.<n>.
OPENCODE_VERSION=2.0.26-android-phonecando.1
OPENCODE_CHANNEL=android-phonecando
# anomalyco/opentui; = the tag's @opentui/core catalog pin.
OPENTUI_VERSION=0.5.17
# = the tag's packageManager.
BUN_VERSION=1.4.2
# = opentui build.zig SUPPORTED_ZIG_VERSIONS.
ZIG_VERSION=0.16.0
NDK_VERSION=r28c
ANDROID_API=29
