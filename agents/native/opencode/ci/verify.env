# opencode's settings for agents/kit/native/verify-elf.sh (sourced by bash).
# Floor: catches a stub or truncated output, not size drift. The Bun runtime
# alone is ~90 MB unpacked (the unstripped renderer, ~16 MB of debug info,
# keeps the default 1 MiB floor; AGP strips it later, see docs/build.md).
ENGINE_FLOOR_MIB=40
# Embedded web UI + pair API + the OPENTUI_LIB_PATH override (build.sh step 3.5).
ENGINE_MARKERS="auth/connect /api/pair wasm-unsafe-eval OPENTUI_LIB_PATH"
# Bun's runtime targets its own API floor; the renderer must have zero gaps.
ENGINE_SYMBOL_GAPS=info
