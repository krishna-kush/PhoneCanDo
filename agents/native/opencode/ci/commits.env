# The commit each upstream tag in ../build/pins.env named when we pinned it.
# ci/sources.sh (every payload build) and ci/check.sh (the weekly contract
# check) clone by tag and stop when HEAD is not this commit: a tag can be
# moved upstream, a commit can't. Kept here, not in pins.env, because build/
# is the payload's INPUTS and the same commit builds the same bytes, so
# pinning it needs no new payload. A tag bump updates both files.
#
# Plain KEY=value lines only, as pins.env.

# anomalyco/opencode at OPENCODE_TAG (v2.0.26).
OPENCODE_COMMIT=9b4ec5714d481559990db0a816d5dec19541a814
# anomalyco/opentui at v$OPENTUI_VERSION (v0.5.17).
OPENTUI_COMMIT=6f0efd3330978d696b42db3d7d95d2042008312b
