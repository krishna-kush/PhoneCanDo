# __ID__ payload pins: the one place they live. build.sh reads them and
# agent-payload.yml loads them into the job env for the toolchain set-up
# steps (NDK_VERSION always; BUN_VERSION, ZIG_VERSION, RUST_VERSION when
# agent.json's build.toolchains lists that toolchain).
#
# Plain KEY=value lines only (no quotes, no trailing comments): the same file
# is read as shell and as a GitHub Actions env file.
NDK_VERSION=r28c
ANDROID_API=29
