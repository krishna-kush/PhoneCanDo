{
  "schema": 1,
  "id": "node",
  "label": "Node.js",
  "provides": 22,
  "families": [
    "apt",
    "dnf",
    "microdnf",
    "yum",
    "pacman",
    "zypper",
    "apk",
    "xbps"
  ],
  "install": {
    "apk": "install/apk.sh",
    "*": "install/glibc.sh"
  },
  "paths": [
    "bin",
    "{{home}}/a:b"
  ],
  "check": {
    "argv": [
      "node",
      "--version"
    ],
    "pattern": "^v(\\d+)\\."
  },
  "licence": {
    "spdx": "MIT",
    "source": "https://nodejs.org"
  }
}
