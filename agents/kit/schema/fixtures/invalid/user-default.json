{
  "schema": 1,
  "id": "user.htop",
  "label": "htop",
  "version": "1",
  "type": "image",
  "channels": [
    "full",
    "lite"
  ],
  "stability": "preview",
  "default": true,
  "licence": {
    "spdx": "GPL-2.0-or-later",
    "redistributed": false,
    "source": "https://github.com/htop-dev/htop"
  },
  "requires": {
    "linux": "required"
  },
  "install": {
    "packages": {
      "*": [
        "htop"
      ]
    }
  },
  "versionCheck": {
    "argv": [
      "htop",
      "--version"
    ],
    "pattern": "^htop (\\S+)"
  },
  "engine": {
    "style": "tui",
    "launch": {
      "argv": [
        "htop"
      ]
    }
  },
  "surfaces": {
    "home": "tui"
  }
}
