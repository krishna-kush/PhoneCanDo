{
  "schema": 1,
  "id": "opencode",
  "label": "opencode",
  "version": "2.0.26-android-phonecando.1",
  "type": "native",
  "prefix": "oc",
  "channels": [
    "full",
    "lite",
    "play"
  ],
  "stability": "stable",
  "default": true,
  "licence": {
    "spdx": "MIT",
    "redistributed": true,
    "notice": "NOTICE.md",
    "source": "https://github.com/anomalyco/opencode"
  },
  "payload": {
    "libs": [
      {
        "name": "liboc-engine.so",
        "from": "opencode2.bin",
        "role": "engine",
        "linkage": "system-only"
      },
      {
        "name": "liboc-opentui.so",
        "from": "libopentui.so",
        "role": "opentui",
        "linkage": "system-only"
      }
    ]
  },
  "build": {
    "toolchains": [
      "bun",
      "zig",
      "ndk"
    ]
  },
  "config": {
    "dir": "config",
    "overlay": "config-lite",
    "fullOnly": [
      "AGENTS.md",
      "plugins/automation/**"
    ],
    "shared": [
      "phone-tools"
    ],
    "into": ".config/opencode",
    "keep": [
      "opencode.json"
    ],
    "required": [
      "opencode.json"
    ]
  },
  "instructions": ".config/opencode/AGENTS.md",
  "requires": {
    "linux": "optional",
    "commands": [
      "bash",
      "git",
      "rg"
    ]
  },
  "state": {
    "env": {
      "OPENCODE_CONFIG_DIR": "{{stateDir}}/opencode",
      "OPENCODE_DB": "{{stateDir}}/opencode/opencode.db"
    },
    "instructions": "opencode/AGENTS.md",
    "config": "opencode"
  },
  "userState": [
    ".config/opencode",
    ".local/share/opencode/opencode-android-phonecando.db",
    ".local/share/opencode/opencode-android-phonecando.db-wal",
    ".local/share/opencode/opencode-android-phonecando.db-shm",
    ".local/state/opencode/model.json",
    ".local/state/opencode/session.json",
    ".local/state/opencode/prompt-history.jsonl",
    ".local/state/opencode/prompt-stash.jsonl",
    ".local/state/opencode/frecency.jsonl"
  ],
  "engine": {
    "style": "server",
    "launch": {
      "argv": [
        "{{libDir}}/liboc-engine.so",
        "serve",
        "--port",
        "{{port}}",
        "--hostname",
        "127.0.0.1"
      ],
      "env": {
        "OPENCODE_DISABLE_AUTOUPDATE": "1",
        "OPENCODE_DISABLE_LSP_DOWNLOAD": "1",
        "OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER": "true",
        "OPENCODE_SERVER_PASSWORD": "{{password}}",
        "OPENTUI_LIB_PATH": "{{libDir}}/liboc-opentui.so"
      },
      "cwd": "{{projectDir}}"
    },
    "auth": {
      "basic": {
        "user": "opencode"
      }
    },
    "readiness": {
      "http": {
        "path": "/api/session"
      }
    }
  },
  "events": [
    {
      "sse": {
        "path": "/api/event",
        "parser": "opencode.events"
      }
    }
  ],
  "chats": {
    "title": {
      "http": {
        "path": "/api/session/{{sessionId}}",
        "json": "/data/title"
      }
    }
  },
  "inbox": {
    "server": {
      "deliver": {
        "method": "POST",
        "path": "/api/session/{{sessionId}}/synthetic",
        "body": {
          "text": "{{messages}}",
          "description": "From another agent or a schedule",
          "delivery": "steer",
          "resume": false
        }
      },
      "wake": {
        "method": "POST",
        "path": "/api/session/{{sessionId}}/synthetic",
        "body": {
          "text": "{{messages}}",
          "description": "From another agent or a schedule",
          "delivery": "steer",
          "resume": true
        }
      },
      "latest": {
        "path": "/api/session?limit=1&order=desc",
        "id": "/data/0/id"
      },
      "create": {
        "method": "POST",
        "path": "/api/session",
        "body": {
          "title": "{{title}}"
        },
        "id": "/data/id"
      }
    },
    "wake": "server"
  },
  "idle": {
    "from": [
      "events"
    ],
    "quietSec": 60
  },
  "surfaces": {
    "home": "web",
    "web": {
      "pair": {
        "method": "POST",
        "path": "/api/pair",
        "code": [
          "/data/code",
          "/code"
        ],
        "url": "/auth/connect/{{code}}"
      },
      "adapter": {
        "colorSchemeKey": "opencode-color-scheme",
        "cssVars": {
          "--v2-background-bg-base": "bg",
          "--v2-background-bg-deep": "bg",
          "--v2-background-bg-layer-01": "panel",
          "--v2-background-bg-layer-02": "panel2",
          "--v2-background-bg-layer-03": "panel2",
          "--v2-background-bg-layer-04": "panel2",
          "--v2-text-text-base": "fg",
          "--v2-text-text-muted": "muted",
          "--v2-text-text-faint": "dim",
          "--v2-icon-icon-base": "muted",
          "--v2-icon-icon-muted": "dim",
          "--v2-icon-icon-faint": "faint",
          "--v2-border-border-base": "line",
          "--v2-border-border-strong": "lineStrong",
          "--v2-border-border-muted": "line",
          "--v2-background-bg-accent": "primary",
          "--v2-text-text-accent": "primary",
          "--v2-text-text-accent-hover": "primaryHi",
          "--v2-icon-icon-accent": "primary",
          "--v2-icon-icon-accent-hover": "primaryHi",
          "--v2-border-border-focus": "primary"
        },
        "hide": [
          "[data-slot=\"titlebar-v2\"]"
        ],
        "authUrl": "/auth/connect/",
        "sessionUrl": "/session/([^/?#]+)"
      }
    },
    "terminal": {
      "client": {
        "argv": [
          "{{libDir}}/liboc-engine.so",
          "--server",
          "{{serverUrl}}",
          {
            "when": "sessionId",
            "args": [
              "--session",
              "{{sessionId}}"
            ]
          },
          "{{projectDir}}"
        ],
        "env": {
          "OPENCODE_DISABLE_AUTOUPDATE": "1",
          "OPENTUI_LIB_PATH": "{{libDir}}/liboc-opentui.so",
          "OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER": "true",
          "OPENCODE_SERVER_PASSWORD": "{{password}}"
        },
        "cwd": "{{projectDir}}"
      },
      "chatTitle": "^OC \\| (.+)$"
    }
  },
  "phoneTools": "plugin",
  "hooks": [
    "opencode.events"
  ],
  "signIn": [
    {
      "method": "in-ui",
      "note": "Connect a provider in the web UI settings."
    }
  ],
  "models": {
    "openai-chat": {
      "env": {
        "OPENCODE_CONFIG_CONTENT": "{\"provider\":{\"phonecando-local\":{\"npm\":\"@ai-sdk/openai-compatible\",\"name\":\"On this phone\",\"options\":{\"baseURL\":\"{{baseUrl}}/v1\",\"apiKey\":\"{env:LOCAL_MODEL_KEY}\"},\"models\":{\"{{model}}\":{\"name\":\"{{model}}\",\"limit\":{\"context\":{{contextWindow}},\"output\":8192}}}}},\"model\":\"phonecando-local/{{model}}\",\"small_model\":\"phonecando-local/{{model}}\"}",
        "LOCAL_MODEL_KEY": "{{modelKey}}"
      }
    }
  }
}
