{
  "name": "phonecando-videos",
  "version": "0.2.0",
  "private": true,
  "description": "Every PhoneCanDo video: an engine any film runs on (beats, motion, stage, sound, render), our look (brand) and one folder per film.",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "facts": "node --disable-warning=ExperimentalWarning brand/facts/write.ts",
    "studio": "pnpm facts && node --disable-warning=ExperimentalWarning engine/render/studio.ts",
    "sound": "pnpm facts && node --disable-warning=ExperimentalWarning engine/sound/cli.ts",
    "render": "pnpm facts && node --disable-warning=ExperimentalWarning engine/render/cli.ts",
    "stills": "pnpm facts && node --disable-warning=ExperimentalWarning engine/render/stills.ts",
    "typecheck": "pnpm facts && tsc --noEmit -p .",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"engine/**/*.test.ts\" \"brand/**/*.test.ts\" \"films/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/paths": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
