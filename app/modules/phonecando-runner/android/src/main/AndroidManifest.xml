<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 11+ package visibility: the engine must be able to resolve
       launcher activities for installed apps (getLaunchIntentForPackage). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- Android 14+: the Settings activity behind the "Restricted setting"
         note, resolved before the guide offers to show it
         (RestrictedSettings.kt). -->
    <intent>
      <action android:name="android.settings.SHOW_RESTRICTED_SETTING_DIALOG" />
    </intent>
    <!-- Apps that take shared text: the name of the app a share went
         through, shown on the Tell a friend page (share/ShareChooser.kt). -->
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="text/plain" />
    </intent>
  </queries>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- power/WorkLock: the CPU stays awake while a chat works or a job runs,
       screen off; the service alone keeps the process, not the CPU. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Runtime-requested on launch (Android 13+ drops plain posts without the
       grant; the app never asked, so appops sat at `ignore`). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- specialUse: Android gives it no time limit (dataSync gets 6 hours in
         24 on Android 15+). The property is the reason Play reviews. -->
    <service
      android:name="com.phonecando.runner.PhoneCanDoServeService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="PhoneCanDo runs coding agents on the phone. The user starts an agent on a task (and the local model and Linux system it works in), then uses other apps while it works: the agent edits files, runs builds and servers, and may operate other apps for the user. If the system paused or stopped it in the background, the task would be cut off mid-way and its work lost. The service runs only while an agent, a model the user downloads, or a Linux setup the user started is working, shows them in its notification, and stops once nothing runs." />
    </service>
    <!-- What agent notifications and the bridge's launch open: hands their
         target (tab, agent) to the app, starts it and finishes before it
         draws (notify/OpenTargetActivity.kt). Our own PendingIntents only. -->
    <activity
      android:name="com.phonecando.runner.notify.OpenTargetActivity"
      android:exported="false"
      android:noHistory="true"
      android:theme="@android:style/Theme.NoDisplay" />
    <!-- Bring the app back after a self-update (system broadcast; the new
         build receives it). -->
    <receiver
      android:name="com.phonecando.runner.PackageReplacedReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <!-- Telemetry: installs the crash handler before Application.onCreate
         in every process start (TelemetryInitProvider.kt). Serves no data.
         The authority carries the applicationId, so each dev channel
         package gets its own. -->
    <provider
      android:name="com.phonecando.runner.TelemetryInitProvider"
      android:authorities="${applicationId}.phonecando-telemetry-init"
      android:exported="false" />
  </application>
</manifest>
