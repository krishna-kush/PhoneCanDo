{
  "expo": {
    "name": "PhoneCanDo",
    "slug": "phonecando",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phonecando.app"
    },
    "android": {
      "package": "com.phonecando.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "phonecando.app",
              "pathPrefix": "/i/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withExtractNativeLibs.js",
      "./plugins/withBuildChannel.js",
      "./plugins/withDevAppId.js",
      "./plugins/withBuildPerf.js",
      "./plugins/withMinSdk.js",
      "./plugins/withPceCompositeBuild.js",
      "./plugins/withNetworkCompositeBuild.js",
      "./plugins/withLreCompositeBuild.js",
      "./plugins/withLmeCompositeBuild.js",
      "./plugins/withAgentsCompositeBuild.js",
      "./plugins/withStoredAssets.js",
      "./plugins/withDotAssets.js",
      "./plugins/withLoopbackCleartext.js",
      "./plugins/withReleaseSigning.js",
      "expo-asset",
      "expo-font",
      "./plugins/withSplash.js",
      "./plugins/withBaselineProfile.js"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
