{
  "expo": {
    "name": "PhoneCanDo",
    "slug": "phonecando",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phonecando.app"
    },
    "android": {
      "package": "com.phonecando.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withExtractNativeLibs.js",
      "./plugins/withBuildChannel.js",
      "./plugins/withDevAppId.js",
      "./plugins/withBuildPerf.js",
      "./plugins/withMinSdk.js",
      "./plugins/withPceCompositeBuild.js",
      "./plugins/withLreCompositeBuild.js",
      "./plugins/withLmeCompositeBuild.js",
      "./plugins/withAgentsCompositeBuild.js",
      "./plugins/withStoredAssets.js",
      "./plugins/withDotAssets.js",
      "./plugins/withLoopbackCleartext.js",
      "./plugins/withReleaseSigning.js",
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
