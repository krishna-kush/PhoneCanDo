# Pinned inputs of the Default env image (lre/images/default). Plain
# KEY=value lines: inputs.sh sources this file, so keep values literal (no
# $expansions). Together with recipe/ these decide every byte of the image;
# a bump edits them in one change (`inputs.sh --fresh` prints new values).

# Docker's official Debian image, the linux/arm64 manifest of debian:trixie
# on 2026-11-07 (image created 2026-11-04, Debian 13.7). Pulled by digest;
# the tag is only for people and for `inputs.sh --fresh`.
DEBIAN_TAG=trixie
DEBIAN_DIGEST=sha256:e529717ccc8118a0b9d38525f2b4e78cf150dbe470ad60d733c7c0023cabc3b0

# snapshot.debian.org timestamp apt installs and upgrades from (trixie,
# trixie-updates, trixie-security), so the same package versions come back
# on every rebuild. Its date is the image's SOURCE_DATE_EPOCH.
SNAPSHOT=20261107T000000Z
