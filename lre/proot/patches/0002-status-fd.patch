+/* --status-fd: the caller's end of a pipe, -1 when not asked or once
+ * the first tracee has ended.  */
+int status_fd = -1;
+
+/* The first tracee once proot has let go of its caller, else 0.  */
+static pid_t main_pid = 0;
+
+bool command_session = false;
+
+#ifndef PTRACE_O_EXITKILL
+#define PTRACE_O_EXITKILL 0x00100000
+#endif
+
+/**
+ * Write @value (a native int) on status_fd.  Errors are ignored: the
+ * caller may be gone already.
+ */
+static void report(int value)
+{
+	ssize_t status;
+
+	do
+		status = write(status_fd, &value, sizeof(value));
+	while (status < 0 && errno == EINTR);
+}
+
+/**
+ * Point @fd at /dev/null.
+ */
+static void to_dev_null(int fd)
+{
+	int null = open("/dev/null", O_RDWR | O_NOCTTY | O_CLOEXEC);
+
+	if (null < 0)
+		return;
+	if (null != fd) {
+		(void) dup2(null, fd);
+		(void) close(null);
+	}
+}
+
+/**
+ * --status-fd, once the first tracee @pid is forked: report its pid,
+ * then leave the caller's session (so also its terminal and its
+ * process group, where the tracee stays unless --setsid: signals for
+ * the command never reach PRoot) and let go of the caller's stdin and
+ * stdout, so the caller sees end-of-file once the command and whatever
+ * it started close them.  Stderr stays for our messages until the
+ * tracee ends.  Tracees die with PRoot (PTRACE_O_EXITKILL): one that
+ * outlives its tracer would run untraced.
+ */
+static void detach_from_caller(pid_t pid)
+{
+	main_pid = pid;
+	signal(SIGPIPE, SIG_IGN);
+	report(pid);
+
+	if (setsid() < 0)
+		note(NULL, WARNING, SYSTEM, "setsid()");
+	to_dev_null(STDIN_FILENO);
+	to_dev_null(STDOUT_FILENO);
+}
+
+/**
+ * --status-fd, once the first tracee has ended with @tracee_status (as
+ * waitpid(2) reports it): report it, close status_fd and let go of the
+ * caller's stderr.  PRoot then traces what the command left running
+ * until it ends too.
+ */
+static void report_main_end(int tracee_status)
+{
+	report(tracee_status);
+	(void) close(status_fd);
+	status_fd = -1;
+	to_dev_null(STDERR_FILENO);
+}
+
+/**
+ * Whether PRoot has let go of its caller (--status-fd).
+ */
+bool detached_from_caller()
+{
+	return main_pid != 0;
+}
