+static int handle_option_status_fd(Tracee *tracee, const Cli *cli UNUSED, const char *value)
+{
+	int fd;
+	int status;
+
+	status = parse_integer_option(tracee, &fd, value, "--status-fd");
+	if (status < 0)
+		return status;
+
+	/* Only PRoot keeps it: the first tracee loses it on execve(2).  */
+	if (fd <= STDERR_FILENO || fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) {
+		note(tracee, ERROR, USER, "option `--status-fd` expects an open file descriptor above 2.");
+		return -1;
+	}
+
+	status_fd = fd;
+	return 0;
+}
