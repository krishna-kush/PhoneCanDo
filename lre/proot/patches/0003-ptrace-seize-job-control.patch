--- a/src/tracee/event.c
+++ b/src/tracee/event.c
@@ -175,6 +175,80 @@
 	return (major > 3) || (major == 3 && minor >= 5);
 }
 
+#ifndef __W_STOPCODE
+#define __W_STOPCODE(sig) ((sig) << 8 | 0x7f)
+#endif
+
+/**
+ * Whether @signal stops a process (job control).
+ */
+static bool is_stop_signal(int signal)
+{
+	return signal == SIGSTOP || signal == SIGTSTP || signal == SIGTTIN || signal == SIGTTOU;
+}
+
+/**
+ * Attach to the first tracee, stopped by itself before execve(2) (see
+ * launch_process()), with PTRACE_SEIZE: unlike PTRACE_TRACEME, a seized
+ * tracee reports a group-stop apart from a signal and can be kept
+ * stopped until SIGCONT (PTRACE_LISTEN), so job control works under
+ * PRoot, see handle_tracee_event().  Its children are seized too.  The
+ * stop becomes its first event in the loop, then SIGCONT wakes it up.
+ * This function returns -errno if an error occurred, otherwise 0.
+ */
+static int seize_first_tracee(Tracee *tracee)
+{
+	int child_status;
+	int status;
+	pid_t pid;
+
+	do
+		pid = waitpid(tracee->pid, &child_status, WUNTRACED);
+	while (pid < 0 && errno == EINTR);
+
+	if (pid < 0 || !WIFSTOPPED(child_status)) {
+		note(tracee, ERROR, INTERNAL, "the first tracee didn't stop");
+		return -ECHILD;
+	}
+
+	status = ptrace(PTRACE_SEIZE, tracee->pid, NULL, 0);
+	if (status < 0) {
+		status = -errno;
+		note(tracee, ERROR, SYSTEM, "ptrace(SEIZE)");
+		(void) kill(tracee->pid, SIGKILL);
+		return status;
+	}
+
+	(void) kill(tracee->pid, SIGCONT);
+	return 0;
+}
+
+/**
+ * Make the PTRACE_EVENT_STOP of a seized @tracee (see
+ * seize_first_tracee()) look like what the rest of PRoot expects from
+ * a tracee attached the old way, where that differs: the first stop
+ * of a tracee stands for the SIGSTOP it used to start with, and a
+ * group-stop under an emulated ptracer is the bare stop signal that
+ * ptracer expects.  Other ones are left to handle_tracee_event().
+ * This function returns the status to handle in place of
+ * @tracee_status.
+ */
+static int unseize_status(Tracee *tracee, int tracee_status)
+{
+	if (!WIFSTOPPED(tracee_status) || tracee_status >> 16 != PTRACE_EVENT_STOP)
+		return tracee_status;
+
+	if (!tracee->first_stop_seen) {
+		tracee->first_stop_seen = true;
+		return __W_STOPCODE(SIGSTOP);
+	}
+
+	if (tracee->as_ptracee.ptracer != NULL && is_stop_signal(WSTOPSIG(tracee_status)))
+		return __W_STOPCODE(WSTOPSIG(tracee_status));
+
+	return tracee_status;
+}
+
 /**
  * Start @tracee->exe with the given @argv[].  This function
