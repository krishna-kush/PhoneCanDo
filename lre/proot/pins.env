# Pinned inputs for our proot build (lre/proot). Plain KEY=value lines: the
# build scripts source this file and CI reads it into the job env
# (.github/ci/proot/pins.sh), so keep values literal (no $expansions).
# Every download is sha256-verified before use; a bump edits the URL, the
# sha256 and the version together.

# termux/proot (GPL-2.0-or-later), HEAD of master on 2026-11-06 = tag
# v5.1.107.102, the version termux-packages ships. Fetched as GitHub's commit
# archive; PROOT_VERSION is what `proot --version` prints, PROOT_COMMIT_DATE
# (committer date) the fixed mtime of our GPL source tarball.
PROOT_REPO=termux/proot
PROOT_COMMIT=52d65a4dc140ca554d241a1438ddd4f6b00c9813
PROOT_VERSION=5.1.107.102
PROOT_COMMIT_DATE=2026-11-01T12:14:48Z
PROOT_URL=https://github.com/termux/proot/archive/52d65a4dc140ca554d241a1438ddd4f6b00c9813.tar.gz
PROOT_SHA256=895867fce973f050e51f09b949f8a995ce62f4a28be119c791ff0fef3b2cf2b0

# talloc (LGPL-3.0-or-later), linked statically into libproot.so. Same
# version and tarball as termux-packages' libtalloc. The mirror is Gentoo's
# distfiles copy of the same file (byte-identical, same sha256), used when
# samba.org is slow or down.
TALLOC_VERSION=2.5.0
TALLOC_URL=https://www.samba.org/ftp/talloc/talloc-2.5.0.tar.gz
TALLOC_MIRROR_URL=https://distfiles.gentoo.org/distfiles/32/talloc-2.5.0.tar.gz
TALLOC_SHA256=912afa237510ae542a7733998eb18a12bcda35ab6729c8e2ddb43e8d0ebab007

# Android target: aarch64, our minSdk, the NDK CI installs.
ANDROID_API=29
NDK_VERSION=r28c

# CI smoke test only (proot.yml build-glibc): official Alpine aarch64
# minirootfs; the sha256 is the one Alpine publishes next to the file.
ALPINE_VERSION=3.24.4
ALPINE_AARCH64_URL=https://dl-cdn.alpinelinux.org/alpine/v3.24/releases/aarch64/alpine-minirootfs-3.24.4-aarch64.tar.gz
ALPINE_AARCH64_SHA256=4b14c18f7e90a063b61462ea1462a5732c154bf6adad594974fe6487cd98a8de
