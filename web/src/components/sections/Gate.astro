---
import Slate from "../Slate.astro";
import LogoLoader from "../LogoLoader.astro";
import ArmPad from "./gate/ArmPad.astro";
import { site } from "../../data/site";
---

<section class="section" id="gate">
    <div class="sec-head">
        <div class="sec-rail">
            <p class="kicker">Sec. 03 / The gate</p>
            <p class="fig-label">FIG. 05 — Consent, three ways</p>
        </div>
        <div class="sec-body">
            <h2>It ships locked.</h2>
            <p class="lead">
                Phone control starts <em>locked</em>. Only your fingerprint,
                face or PIN arms it, you pick how long it stays armed, and the
                agent can never arm itself.
            </p>
        </div>
    </div>

    <figure class="gate-plate">
        <div class="gate-bar">
            <span>Phone control / A-01</span>
            <span class="gate-bar-state">
                <i aria-hidden="true"></i><span class="gate-is-locked">Default · locked</span><span class="gate-is-armed">Demo · armed</span>
            </span>
        </div>

        <div class="gate-states">
            <div class="gate-panel">
                <p class="gate-no">01 / Locked</p>
                <h3>Nothing moves.</h3>
                <p>
                    Every phone action is refused at the bridge with{" "}
                    <code>403 automation_off</code>. The agent can still think,
                    and use its own terminal.
                </p>
                <ul class="gate-list">
                    <li>Read the screen</li>
                    <li>Tap · type · scroll</li>
                    <li>Notifications · share</li>
                    <li>Clipboard · links · apps</li>
                </ul>
            </div>

            <div class="gate-media">
                <!-- Real recording only, never a mock. Source: UnlockDialog.tsx. -->
                <div class="gate-frame" data-media>
                    {site.gate.video ? (
                        <video
                            src={site.gate.video}
                            poster={site.gate.poster}
                            autoplay
                            muted
                            loop
                            playsinline
                            aria-label="PhoneCanDo asking for biometric unlock"
                        />
                    ) : (
                        <Slate slot="03" label="Biometric prompt · recording" />
                    )}
                    {site.gate.video ? (
                        <div class="media-loader">
                            <LogoLoader size={26} />
                        </div>
                    ) : null}
                </div>
                <p class="gate-media-cap">The agent asks · you press</p>
                <ArmPad />
            </div>

            <div class="gate-panel gate-panel-armed">
                <span class="gate-armed-stamp" aria-hidden="true">Armed by you</span>
                <p class="gate-no">02 / Armed</p>
                <h3>You unlocked it.</h3>
                <p>
                    Fingerprint, face or device PIN, nothing else. The agent
                    never sees the credential, and it cannot press this button
                    for you.
                </p>
                <p class="gate-note">
                    Stays armed as long as your setting below says. Lock it any
                    time from Settings → Phone control.
                </p>
            </div>
        </div>

        <div class="gate-modes">
            <p class="gate-modes-label">How often it asks</p>
            <div class="gate-mode">
                <p class="gate-mode-head">01 / Once · default</p>
                <p>
                    One prompt after you install. It stays armed, restarts
                    included, until you lock it.
                </p>
            </div>
            <div class="gate-mode">
                <p class="gate-mode-head">02 / Each launch</p>
                <p>
                    Asks again every time PhoneCanDo starts or you swipe it
                    away.
                </p>
            </div>
            <div class="gate-mode">
                <p class="gate-mode-head">03 / Each ask</p>
                <p>
                    Every agent asks for its own unlock, which ends when it
                    hands the phone back.
                </p>
            </div>
        </div>

        <figcaption class="gate-foot">
            <p>
                <span>Works while locked:</span> reopening PhoneCanDo · this
                prompt · Android's accessibility screen
            </p>
            <p>Play build: no driver, nothing to gate.</p>
        </figcaption>
    </figure>
</section>

<style is:global>
    /* the gate: consent, for as long as you pick */
    .gate-plate {
      margin: 0;
      border: 1px solid var(--line);
      background: var(--panel);
      box-shadow: var(--plate-shadow);
    }
    .gate-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 11px 16px;
      border-bottom: 1px solid var(--line);
      font: 500 9px/1 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .gate-bar-state { display: flex; align-items: center; gap: 7px; color: var(--muted); }
    .gate-bar-state i { width: 6px; height: 6px; background: var(--red); }
    .gate-states {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px minmax(0, 1fr);
      gap: 1px;
      background: var(--line);
    }
    .gate-panel { background: var(--panel); padding: clamp(20px, 2.6vw, 28px); display: flex; flex-direction: column; justify-content: center; }
    .gate-panel-armed {
      position: relative;
      background: linear-gradient(var(--accent-soft), var(--accent-soft)), var(--panel);
      transition: box-shadow 0.3s;
    }
    .gate-no {
      display: flex;
      align-items: center;
      gap: 7px;
      font: 500 8.5px/1.4 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .gate-no::before { content: ''; width: 5px; height: 5px; background: var(--red); }
    .gate-panel-armed .gate-no { color: var(--accent-ink); }
    .gate-panel-armed .gate-no::before { background: var(--accent); }
    .gate-panel h3 {
      margin-top: 10px;
      font: 400 26px/1.05 var(--serif);
      letter-spacing: -0.01em;
    }
    .gate-panel p {
      margin-top: 10px;
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--muted);
    }
    .gate-panel code {
      font: 400 11.5px/1.5 var(--mono);
      color: var(--red);
      white-space: nowrap;
    }
    .gate-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7px 12px;
      margin: 18px 0 0;
      padding: 16px 0 0;
      list-style: none;
      border-top: 1px solid var(--line);
    }
    .gate-list li {
      display: flex;
      align-items: center;
      gap: 7px;
      font: 500 9px/1.5 var(--mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--dim);
    }
    .gate-list li::before {
      content: '';
      flex: none;
      width: 4px;
      height: 4px;
      background: var(--line-2);
    }
    .gate-panel .gate-note {
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid var(--accent-line);
      font: 500 9px/1.7 var(--mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-ink);
    }
    .gate-media {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 18px;
      background: var(--art-bg);
    }
    .gate-frame {
      position: relative;
      height: 420px;
      aspect-ratio: 9 / 19.5;
      max-width: 100%;
      border: 1px solid rgba(255, 255, 255, 0.1);
      overflow: hidden;
      background: var(--art-bg);
    }
    .gate-frame video { width: 100%; height: 100%; object-fit: cover; }
    .gate-media-cap {
      font: 500 8px/1.4 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-align: center;
      color: var(--art-dim);
    }
    .gate-modes {
      display: grid;
      grid-template-columns: 160px repeat(3, minmax(0, 1fr));
      gap: 1px;
      background: var(--line);
      border-top: 1px solid var(--line);
    }
    .gate-modes > * {
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: var(--panel);
      padding: 16px 18px;
    }
    .gate-modes-label {
      background: var(--panel-2);
      font: 500 8px/1.6 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .gate-mode-head {
      font: 500 8.5px/1.4 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--dim);
    }
    .gate-mode p:last-child {
      margin-top: 6px;
      font-size: 12.5px;
      line-height: 1.5;
      color: var(--muted);
    }
    .gate-foot {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px 24px;
      align-items: baseline;
      padding: 12px 16px;
      border-top: 1px solid var(--line);
      font: 500 8.5px/1.5 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .gate-foot span { margin-right: 6px; color: var(--accent-ink); }

    /* Armed by the pad's demo (gate/ArmPad.astro): the bar says so, the
       refusal is crossed out, each thing it may now do lights up in turn,
       and the armed side gets its stamp. */
    .gate-is-armed,
    .gate-plate[data-armed] .gate-is-locked { display: none; }
    .gate-plate[data-armed] .gate-is-armed { display: inline; color: var(--accent-ink); }
    .gate-plate[data-armed] .gate-bar-state i { background: var(--accent); }
    .gate-plate[data-armed] .gate-panel code { text-decoration: line-through 2px var(--fg); }
    .gate-list li { transition: color 0.2s; }
    .gate-list li::before { transition: background-color 0.2s, scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .gate-plate[data-armed] .gate-list li { color: var(--fg); }
    .gate-plate[data-armed] .gate-list li::before { background: var(--red); scale: 1.6; }
    .gate-plate[data-armed] .gate-list li:nth-child(2),
    .gate-plate[data-armed] .gate-list li:nth-child(2)::before { transition-delay: 0.08s; }
    .gate-plate[data-armed] .gate-list li:nth-child(3),
    .gate-plate[data-armed] .gate-list li:nth-child(3)::before { transition-delay: 0.16s; }
    .gate-plate[data-armed] .gate-list li:nth-child(4),
    .gate-plate[data-armed] .gate-list li:nth-child(4)::before { transition-delay: 0.24s; }
    .gate-plate[data-armed] .gate-panel-armed { box-shadow: inset 0 0 0 2px var(--accent); }
    .gate-armed-stamp {
      position: absolute;
      top: 14px;
      right: 14px;
      display: none;
      padding: 5px 8px;
      border: 1.5px solid var(--red);
      color: var(--red);
      font: 500 9px/1 var(--mono);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      rotate: 8deg;
    }
    .gate-plate[data-armed] .gate-armed-stamp {
      display: block;
      animation: gate-stamp 0.42s cubic-bezier(0.2, 0.9, 0.25, 1.2) both;
    }
    @keyframes gate-stamp {
      from { opacity: 0; scale: 2.2; rotate: -4deg; }
      60% { opacity: 1; scale: 0.94; }
    }

    @media (max-width: 980px) {
      .gate-states { grid-template-columns: minmax(0, 1fr) 240px minmax(0, 1fr); }
      .gate-frame { height: 420px; }
    }
    @media (max-width: 860px) {
      .gate-states { grid-template-columns: 1fr; }
      .gate-modes { grid-template-columns: 1fr; }
      .gate-foot { grid-template-columns: 1fr; }
      .gate-frame { height: 440px; }
    }
    @media (max-width: 760px) {
      .gate-frame { height: 360px; }
      .gate-list { grid-template-columns: 1fr; }
    }
    @media (max-width: 420px) {
      .gate-frame { height: 320px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .gate-panel-armed,
      .gate-list li,
      .gate-list li::before { transition: none; }
      .gate-plate[data-armed] .gate-armed-stamp { animation: none; }
    }
</style>
