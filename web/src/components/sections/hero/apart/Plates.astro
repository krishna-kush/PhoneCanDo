---
// FIG. 01A's layers under the screen, and the cloud relay's phantom over it
// (ids from data/phoneParts). Each is a plate the screen's size, lifted --i
// gaps off the board; from above only a plate's lower strip shows under the
// one over it, so what marks it sits low. Drawn in the page's own line-work:
// amber light on the dark theme, ink printed on paper on the light one.
import LogoLoader from "../../../LogoLoader.astro";
import { site } from "../../../../data/site";
---

<span class="plate plate-board" data-part="board" style="--i:0" aria-hidden="true">
    <span class="plate-chip">{site.arch}</span>
</span>
<span class="plate plate-keys" data-part="keys" style="--i:1" aria-hidden="true">
    <span class="plate-key"></span>
</span>
<span class="plate plate-linux" data-part="linux" style="--i:2" aria-hidden="true">
    <span class="plate-term">$ apt install ffmpeg<br />$ <span class="plate-cursor"></span></span>
</span>
<span class="plate plate-agent" data-part="agent" style="--i:3" aria-hidden="true">
    <LogoLoader size={36} />
</span>
<span class="plate plate-apps" data-part="apps" style="--i:4" aria-hidden="true"></span>
<span class="plate plate-phantom" data-part="cloud" style="--i:6" aria-hidden="true">
    <span class="plate-phantom-note">✕ Cloud relay · not included</span>
</span>

<style is:global>
    .plate {
      --plate-line: var(--accent-line);
      --plate-ink: var(--accent);
      --plate-tint: var(--accent-soft);
      --plate-fill: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--accent) 10%, transparent),
        color-mix(in srgb, var(--accent) 3%, transparent)
      );
      --plate-depth: inset 0 0 26px -14px color-mix(in srgb, var(--accent) 70%, transparent);
      position: absolute;
      inset: 7px;
      display: grid;
      place-items: end center;
      padding-bottom: 24px;
      border: 1px solid var(--plate-line);
      border-radius: 27px;
      background: var(--plate-fill);
      box-shadow: var(--plate-depth);
      opacity: clamp(0, calc(var(--s) * 8), 1);
      transform: translateZ(calc(var(--i) * var(--gap) * var(--s) + var(--lift, 0px)));
      pointer-events: none;
    }
    /* Paper: frosted white plates, ink edges, each casting a soft shadow on
       the one under it. The yellow accent only tints. */
    [data-theme='light'] .plate {
      --plate-line: color-mix(in srgb, var(--accent-ink) 50%, transparent);
      --plate-ink: var(--accent-ink);
      --plate-tint: color-mix(in srgb, var(--accent) 55%, transparent);
      --plate-fill: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) 86%, transparent),
        color-mix(in srgb, var(--bg) 66%, transparent)
      );
      --plate-depth: 0 24px 30px -26px rgba(0, 0, 0, 0.45);
    }
    .plate[data-lit] { border-color: var(--plate-ink); }

    .plate-board {
      --board-bg: var(--art-bg);
      --board-trace: var(--accent-soft);
      background:
        repeating-linear-gradient(90deg, transparent 0 23px, var(--board-trace) 23px 24px),
        repeating-linear-gradient(0deg, transparent 0 23px, var(--board-trace) 23px 24px),
        var(--board-bg);
    }
    [data-theme='light'] .plate-board {
      --board-bg: var(--panel);
      --board-trace: var(--line);
    }
    /* The SoC, pins and all. */
    .plate-chip {
      padding: 18px 14px;
      border: 1px solid var(--plate-ink);
      outline: 3px dotted var(--plate-line);
      outline-offset: 3px;
      background: var(--board-bg);
      font: 500 9px/1 var(--mono);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--plate-ink);
    }

    .plate-key {
      position: relative;
      width: 26px;
      height: 26px;
      margin: 0 40px 4px 0;
      border: 2px solid var(--plate-ink);
      border-radius: 50%;
      background: var(--plate-tint);
    }
    .plate-key::after {
      content: '';
      position: absolute;
      top: 8px;
      left: 22px;
      width: 40px;
      height: 6px;
      border: 2px solid var(--plate-ink);
      border-left: 0;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 82% 100%, 82% 50%, 66% 50%, 66% 100%, 0 100%);
    }

    .plate-linux { place-items: end start; padding: 0 22px 16px; }
    .plate-term { font: 500 10px/1.8 var(--mono); color: var(--plate-ink); }
    .plate-cursor {
      display: inline-block;
      width: 6px;
      height: 10px;
      background: var(--plate-ink);
      vertical-align: -1px;
      animation: blink 1.1s steps(1) infinite;
    }

    .plate-agent { padding-bottom: 20px; }

    /* Round app icons, four across, each a tinted dot in an ink ring. */
    .plate-apps {
      background:
        radial-gradient(circle, var(--plate-tint) 0 11px, var(--plate-line) 11px 12.5px, transparent 13px) 6px 14px / 68px 68px,
        var(--plate-fill);
    }

    /* A phantom, as a drawing marks a part that is not there: dashed, empty,
       its note along the strip that shows above the screen. */
    .plate.plate-phantom {
      place-items: start center;
      padding: 10px 0 0;
      border: 1.5px dashed var(--red);
      background: none;
      box-shadow: none;
    }
    .plate-phantom-note {
      font: 500 8px/1 var(--mono);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      white-space: nowrap;
      color: var(--red);
    }
</style>
