---
// FIG. 01A's parts list, for screens too narrow for leaders beside the
// stack: there the labels shrink to numbered balloons on their layers
// (Labels.astro), and this key under the stack names them, as a drawing's
// parts list does. It shows only while the phone is apart. Screen readers
// read the labels' own list, so this one is hidden from them.
import { phoneParts } from "../../../../data/phoneParts";
---

<ol class="apart-legend" aria-hidden="true">
    {phoneParts.map((part, n) => (
        <li class:list={{ "legend-phantom": part.phantom }} style={`--n:${n}`}>
            <b>{String(n).padStart(2, "0")}</b>
            <span>{part.name}</span>
            <em>{part.note}</em>
        </li>
    ))}
</ol>

<style is:global>
    .apart-legend { display: none; }
    @media (max-width: 1100px) {
      .apart-legend {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 2;
        display: grid;
        gap: 4px;
        margin: 0;
        padding: 10px 10px 0;
        border-top: 1px dashed var(--line-2);
        list-style: none;
        font: 500 8px/1.3 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--fg);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s;
      }
      .phone-wrap[data-apart] .apart-legend { opacity: 1; }
      .apart-legend li {
        display: flex;
        align-items: baseline;
        gap: 7px;
        min-width: 0;
        opacity: 0;
        translate: 0 4px;
        transition: opacity 0.2s, translate 0.2s;
      }
      /* The rows tick in after the layers, top first. */
      .phone-wrap[data-apart] .apart-legend li {
        opacity: 1;
        translate: 0 0;
        transition-delay: calc(0.55s + var(--n) * 50ms);
      }
      .apart-legend b { flex: none; font-weight: 500; color: var(--accent); }
      .apart-legend span { flex: none; }
      .apart-legend em {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        font-style: normal;
        letter-spacing: 0.06em;
        color: var(--faint);
      }
      .apart-legend em::before { content: '· '; }
      /* The phantom, red and struck through at its capitals' middle
         (0.64em down, see Labels.astro). */
      .legend-phantom b { color: var(--red); }
      .legend-phantom span {
        background: linear-gradient(transparent calc(0.64em - 0.5px), var(--red) 0 calc(0.64em + 0.5px), transparent 0);
      }
    }
    @media (max-width: 1100px) and (prefers-reduced-motion: reduce) {
      .apart-legend,
      .apart-legend li { transition: none !important; }
    }
</style>
