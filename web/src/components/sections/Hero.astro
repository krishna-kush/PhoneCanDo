---
import Slate from "../Slate.astro";
import LogoLoader from "../LogoLoader.astro";
import SessionCard from "./hero/SessionCard.astro";
import VerbReel from "./hero/VerbReel.astro";
import { site } from "../../data/site";
---

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">
            <span class="dot" aria-hidden="true"></span>
            PhoneCanDo Field Manual · Alpha v{site.version}
        </p>
        <h1>
            AI that can <VerbReel /> your phone.
        </h1>
        <p class="hero-sub">
            PhoneCanDo puts a real agent on your Android. It reads the screen,
            uses the apps, and works in a full terminal.{" "}
            <strong>No PC. No cloud relay.</strong> Your keys, your data, on the
            device.
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="#install">
                Download APK
                <svg
                    width="11"
                    height="11"
                    viewBox="0 0 12 12"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M6 1v8M2.5 5.5 6 9l3.5-3.5M1 11h10"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    ></path>
                </svg>
            </a>
            <a class="btn btn-ghost" href="#demos">
                See it work
            </a>
        </div>
        <p class="hero-note">
            <span>No account</span>
            <span>No PC</span>
            <span>Sideload alpha</span>
        </p>
    </div>

    <figure class="phone-wrap">
        <figcaption class="fig-head">
            <div>
                <p class="fig-label">FIG. 01 — The body</p>
                <p class="fig-sub">Model A-01 / 1080 × 2340 / {site.arch}</p>
            </div>
            <span class="stamp">On-device</span>
        </figcaption>
        <div class="phone-figure">
            <span class="dim-v" aria-hidden="true">
                <span>9:19.5</span>
            </span>
            <div class="phone">
                <div class="phone-screen" data-media>
                    {site.hero.video ? (
                        <video
                            src={site.hero.video}
                            poster={site.hero.poster}
                            autoplay
                            muted
                            loop
                            playsinline
                            aria-label="PhoneCanDo running on a phone"
                        />
                    ) : (
                        <Slate slot="01" glyph label="Hero loop · 0:08" />
                    )}
                    {site.hero.video ? (
                        <div class="media-loader">
                            <LogoLoader size={26} />
                        </div>
                    ) : null}
                </div>
            </div>
            <SessionCard />
        </div>
    </figure>
</section>

<dl class="specs">
    <div>
        <dt>Runs on</dt>
        <dd>On-device · {site.arch}</dd>
    </div>
    <div>
        <dt>Android</dt>
        <dd>{site.minAndroid} and up</dd>
    </div>
    <div>
        <dt>Build</dt>
        <dd>Alpha v{site.version}</dd>
    </div>
    <div>
        <dt>License</dt>
        <dd>{site.license}</dd>
    </div>
</dl>

<style is:global>
    .hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: clamp(32px, 6vw, 72px);
      align-items: center;
      padding: clamp(48px, 7vh, 76px) var(--pad) clamp(84px, 10vh, 104px);
      overflow: clip;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(to right, var(--grid) 1px, transparent 1px),
        linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
      background-size: 32px 32px;
      -webkit-mask-image: radial-gradient(75% 95% at 30% 45%, #000 0%, transparent 78%);
      mask-image: radial-gradient(75% 95% at 30% 45%, #000 0%, transparent 78%);
      pointer-events: none;
    }
    .hero > * { position: relative; }
    .hero-copy { max-width: 640px; }

    .hero-note {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      margin-top: 20px;
      font: 500 9.5px/1.6 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .hero-note span { display: inline-flex; align-items: center; gap: 7px; }
    .hero-note span::before {
      content: '';
      width: 7px;
      height: 7px;
      border: 1px solid var(--line-2);
    }

    /* phone frame: real screenshots/video drop in here */
    .phone-wrap {
      position: relative;
      width: 100%;
      max-width: 300px;
      margin: 0 0 0 auto;
    }
    .phone-wrap::before {
      content: '';
      position: absolute;
      inset: 18% -12% -6%;
      background: radial-gradient(60% 50% at 50% 60%, var(--glow), transparent 70%);
      filter: blur(24px);
      pointer-events: none;
    }
    .fig-head {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }
    .fig-head .stamp { margin-top: 2px; }
    .phone-figure { position: relative; }
    .phone {
      position: relative;
      width: 100%;
      max-width: 300px;
      margin-left: auto;
      aspect-ratio: 1080 / 2340;
      padding: 7px;
      border: 1px solid var(--line-2);
      border-radius: 34px;
      background: #0c0c0c;
      box-shadow: var(--phone-shadow);
    }
    .phone::before,
    .phone::after {
      content: '';
      position: absolute;
      width: 2px;
      border-radius: 2px;
      background: #242424;
    }
    .phone::before { right: -3px; top: 24%; height: 46px; }
    .phone::after { left: -3px; top: 19%; height: 30px; box-shadow: 0 42px 0 #242424; }
    .phone-screen {
      position: relative;
      height: 100%;
      border-radius: 27px;
      overflow: hidden;
      background: #060606;
      border: 1px solid var(--line);
      display: grid;
      place-items: center;
    }
    .phone-screen video,
    .phone-screen img { width: 100%; height: 100%; object-fit: cover; }

    .dim-v {
      position: absolute;
      left: -24px;
      top: 52px;
      height: calc(100% - 140px);
      border-left: 1px solid var(--accent);
      pointer-events: none;
    }
    .dim-v::before,
    .dim-v::after {
      content: '';
      position: absolute;
      left: -4px;
      width: 9px;
      height: 1px;
      background: var(--accent);
    }
    .dim-v::before { top: 0; }
    .dim-v::after { bottom: 0; }
    .dim-v span {
      position: absolute;
      top: 50%;
      left: -6px;
      transform: translate(-100%, -50%) rotate(-90deg);
      font: 500 8px/1 var(--mono);
      letter-spacing: 0.12em;
      color: var(--accent-ink);
      white-space: nowrap;
    }

    @media (max-width: 1100px) {
      .dim-v { display: none; }
    }
    @media (max-width: 980px) {
      .hero { grid-template-columns: minmax(0, 1fr) 300px; padding-top: 60px; }
    }
    @media (max-width: 760px) {
      .hero { grid-template-columns: 1fr; padding-top: 44px; gap: 38px; }
      .hero-copy { max-width: none; }
      .phone-wrap { max-width: 280px; margin: 0 auto; }
      .phone { margin: 0 auto; max-width: 280px; }
      .fig-head { width: 100%; }
    }
    @media (max-width: 420px) {
      .hero-note { gap: 8px 12px; }
    }

    /* spec strip */
    .specs {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .specs div { padding: 16px 20px; border-left: 1px solid var(--line); }
    .specs div:first-child { border-left: 0; }
    .specs dt {
      display: flex;
      align-items: center;
      gap: 6px;
      font: 500 8.5px/1.4 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .specs dt::before {
      content: '';
      width: 4px;
      height: 4px;
      flex: none;
      background: var(--accent);
    }
    .specs dd {
      margin: 7px 0 0;
      font: 500 11.5px/1.4 var(--mono);
      color: var(--fg);
    }

    @media (max-width: 760px) {
      .specs { grid-template-columns: repeat(2, 1fr); }
      .specs div:nth-child(3) { border-left: 0; border-top: 1px solid var(--line); }
      .specs div:nth-child(4) { border-top: 1px solid var(--line); }
    }
</style>
