---
import { site } from "../../data/site";
import BorderSeal from "./linux/BorderSeal.astro";
---

<section class="section linux" id="linux">
    <div class="linux-grid">
        <div>
            <p class="fig-label">FIG. 04 — Subsystem</p>
            <h2>And underneath it, a full Linux.</h2>
            <p>
                The agent doesn't just run on your phone. It runs
                inside a full Linux of its own — its own root, its own
                packages, its own files. apt, git, ssh, tmux, python:
                if it runs on Linux, it runs in there.
            </p>
            <p>
                Start another sandbox and the next agent gets a root
                of its own. Separate files, separate packages,{" "}
                <em>nothing shared unless you share it.</em>
            </p>
            <p class="fine">
                On-device · arm64 · one sandbox per agent
            </p>
            <p class="linux-cta">
                <a
                    class="btn btn-ghost"
                    href={site.repo}
                    target="_blank"
                    rel="noreferrer"
                >
                    Follow the build
                    <svg
                        width="11"
                        height="11"
                        viewBox="0 0 12 12"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path
                            d="M2 10 10 2M4 2h6v6"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        ></path>
                    </svg>
                </a>
            </p>
        </div>

        <figure class="passport-plate">
            <!-- CSS-only experiment: checking the box runs the install on SBX-01. -->
            <input class="visa-input" type="checkbox" id="visa-ffmpeg" />

            <div class="passport-bar">
                <span>Root passports · A-01</span>
                <span class="passport-bar-state">
                    <i aria-hidden="true"></i>2 roots · 0 shared
                </span>
            </div>

            <div class="passport-books">
                <div class="passport passport-a">
                    <div class="passport-page">
                        <div class="passport-head">
                            <div class="passport-title">
                                Passport <span>/ root</span>
                            </div>
                            <div class="passport-serial">SBX-01</div>
                        </div>
                        <div class="passport-id">
                            <div class="passport-photo" aria-hidden="true">
                                <span>/</span>
                                <small>this is the root</small>
                            </div>
                            <dl class="passport-fields">
                                <div>
                                    <dt>Holder</dt>
                                    <dd>agent-01</dd>
                                </div>
                                <div>
                                    <dt>Image</dt>
                                    <dd>a-01</dd>
                                </div>
                                <div>
                                    <dt>Root</dt>
                                    <dd>/sbx/01</dd>
                                </div>
                            </dl>
                        </div>
                        <div class="passport-entries-label">
                            Entries <span>own packages</span>
                        </div>
                        <div class="passport-stamps">
                            <span>apt</span><span>git</span><span>ssh</span>
                            <span>tmux</span><span>python3</span>
                        </div>
                        <div class="passport-slot">
                            <span class="slot-hint" aria-hidden="true">
                                next entry
                            </span>
                            <span class="visa">
                                ffmpeg<em>41 mb · admitted</em>
                            </span>
                        </div>
                        <div class="passport-dpkg">
                            dpkg <b class="pkgs-before">412</b>
                            <b class="pkgs-after">413</b> pkgs
                            <span class="pkgs-delta">+1</span>
                        </div>
                        <div class="passport-mrz" aria-hidden="true">
                            <span>P&lt;SBX01&lt;&lt;ROOT&lt;&lt;OF&lt;&lt;ITS&lt;&lt;OWN&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</span>
                            <span>SBX01&lt;&lt;&lt;&lt;&lt;&lt;&lt;ARM64&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</span>
                        </div>
                    </div>
                </div>

                <BorderSeal />

                <div class="passport passport-b">
                    <div class="passport-page">
                        <div class="passport-head">
                            <div class="passport-title">
                                Passport <span>/ root</span>
                            </div>
                            <div class="passport-serial">SBX-02</div>
                        </div>
                        <div class="passport-id">
                            <div class="passport-photo" aria-hidden="true">
                                <span>/</span>
                                <small>this is the root</small>
                            </div>
                            <dl class="passport-fields">
                                <div>
                                    <dt>Holder</dt>
                                    <dd>agent-02</dd>
                                </div>
                                <div>
                                    <dt>Image</dt>
                                    <dd>a-01</dd>
                                </div>
                                <div>
                                    <dt>Root</dt>
                                    <dd>/sbx/02</dd>
                                </div>
                            </dl>
                        </div>
                        <div class="passport-entries-label">
                            Entries <span>own packages</span>
                        </div>
                        <div class="passport-stamps">
                            <span>apt</span><span>git</span><span>ssh</span>
                            <span>tmux</span><span>python3</span>
                        </div>
                        <div class="passport-slot">
                            <span class="slot-hint" aria-hidden="true">
                                next entry
                            </span>
                            <span class="slot-still" aria-hidden="true">
                                unchanged · 0 kb
                            </span>
                        </div>
                        <div class="passport-dpkg">
                            dpkg <b>388</b> pkgs
                        </div>
                        <div class="passport-mrz" aria-hidden="true">
                            <span>P&lt;SBX02&lt;&lt;ROOT&lt;&lt;OF&lt;&lt;ITS&lt;&lt;OWN&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</span>
                            <span>SBX02&lt;&lt;&lt;&lt;&lt;&lt;&lt;ARM64&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</span>
                        </div>
                    </div>
                </div>
            </div>

            <label class="passport-install" for="visa-ffmpeg">
                <span class="pi-event">Install event</span>
                <span class="pi-cmd">apt install ffmpeg</span>
                <span class="pi-act">
                    <span class="pi-off">press to stamp SBX-01</span>
                    <span class="pi-on">stamped · press to reset</span>
                </span>
            </label>

            <figcaption class="passport-foot">
                <span>own root · own packages</span>
                <span class="right">same image · {site.arch}</span>
            </figcaption>
        </figure>
    </div>
</section>

<style is:global>
    .linux { background-color: var(--panel); }
    .linux-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: clamp(28px, 5vw, 64px);
      align-items: center;
    }
    .linux .fig-label { margin-bottom: 0; }
    .linux h2 {
      margin-top: 14px;
      font: 400 clamp(38px, 4.8vw, 58px)/0.98 var(--serif);
      letter-spacing: -0.02em;
    }
    .linux p {
      margin-top: 14px;
      max-width: 48ch;
      font-size: 15px;
      color: var(--muted);
    }
    .linux p em { font-style: italic; color: var(--fg); }
    .linux .fine {
      margin-top: 18px;
      font: 400 10px/1.7 var(--mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .linux-cta { margin-top: 18px; }
    .linux-cta .btn:hover svg { transform: translate(1px, -1px); }

    /* Two columns get tight here: give the passports the room their fields need. */
    @media (max-width: 1180px) {
      .linux-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    }
    @media (max-width: 980px) {
      .linux-grid { grid-template-columns: 1fr; }
    }

    /* root passports: one book per agent, zero shared pages */
    .passport-plate {
      position: relative;
      margin: 0;
      border: 1px solid var(--line);
      background: var(--panel-2);
      box-shadow: var(--plate-shadow);
    }
    /* The toggle is a real checkbox: keyboard and screen readers get the experiment. */
    .visa-input {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      border: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .passport-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--line);
      font: 500 10px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .passport-bar-state {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-left: auto;
      color: var(--dim);
    }
    .passport-bar-state i {
      width: 6px;
      height: 6px;
      flex: none;
      background: var(--red);
      animation: blink 2.4s steps(1) infinite;
    }
    .passport-books {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 54px minmax(0, 1fr);
    }
    .passport { padding: 10px; background: var(--panel-2); }
    .passport-page {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 8px;
      height: 100%;
      padding: 12px 13px 10px;
      border: 1px solid var(--line-2);
      background: var(--panel);
      box-shadow: inset 0 0 0 2px var(--panel), inset 0 0 0 3px var(--line);
      overflow: hidden;
    }
    /* Security guilloche; the paper is a document, not a panel. */
    .passport-page::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-radial-gradient(
        circle at 50% 38%,
        transparent 0 10px,
        var(--accent-line) 10px 11px
      );
      opacity: 0.06;
      pointer-events: none;
    }
    .passport-page > * { position: relative; }
    .passport-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
      padding-bottom: 7px;
      border-bottom: 1px solid var(--line);
    }
    .passport-title {
      font: 400 16px/1 var(--serif);
      letter-spacing: -0.01em;
      color: var(--fg);
    }
    .passport-title span {
      font: 500 6.5px/1.2 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent-ink);
    }
    .passport-serial {
      font: 500 8.5px/1 var(--mono);
      letter-spacing: 0.1em;
      color: var(--red);
      white-space: nowrap;
    }
    .passport-id {
      display: grid;
      grid-template-columns: 58px minmax(0, 1fr);
      gap: 12px;
    }
    .passport-photo {
      display: grid;
      place-content: center;
      justify-items: center;
      gap: 4px;
      height: 64px;
      padding: 0 3px;
      border: 1px solid var(--line-2);
      background: var(--panel-2);
    }
    .passport-photo span { font: 400 30px/0.75 var(--serif); color: var(--fg); }
    .passport-photo small {
      font: 500 6px/1.35 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--dim);
      text-align: center;
    }
    .passport-fields { display: grid; gap: 5px; align-content: center; margin: 0; }
    .passport-fields div {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 8px;
      align-items: baseline;
    }
    .passport-fields dt {
      font: 500 6.5px/1.3 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .passport-fields dd { margin: 0; font: 400 10px/1.3 var(--mono); color: var(--fg); }
    .passport-entries-label {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
      font: 500 6.5px/1.2 var(--mono);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .passport-entries-label span { color: var(--dim); letter-spacing: 0.08em; }
    .passport-stamps { display: flex; flex-wrap: wrap; gap: 4px; }
    .passport-stamps span {
      padding: 2px 4px;
      border: 1px solid var(--red);
      color: var(--red);
      font: 500 7.5px/1.2 var(--mono);
      letter-spacing: 0.05em;
      opacity: 0.8;
      transform: rotate(-2deg);
    }
    .passport-stamps span:nth-child(2n) {
      border-color: var(--accent-line);
      color: var(--accent-ink);
      transform: rotate(1.5deg);
    }
    /* Each entry is inked again when the pointer passes over it. */
    .passport-stamps span:hover { animation: entry-ink 0.3s ease-out; }
    @keyframes entry-ink {
      40% { scale: 1.25; opacity: 1; }
    }
    /* Empty band on purpose: an entry stamp needs a clear page. */
    .passport-slot {
      position: relative;
      display: grid;
      place-items: center;
      height: 46px;
      flex: none;
      border: 1px dashed var(--line-2);
    }
    .slot-hint,
    .slot-still {
      font: 500 7px/1.2 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--dim);
    }
    .slot-still { display: none; color: var(--accent-ink); }
    .visa {
      display: none;
      position: absolute;
      left: 50%;
      top: 50%;
      padding: 4px 8px 5px;
      border: 1px solid var(--red);
      box-shadow: inset 0 0 0 2px var(--panel), inset 0 0 0 3px var(--red);
      color: var(--red);
      font: 600 10px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
      transform: translate(-50%, -50%) rotate(-7deg);
    }
    .visa em {
      display: block;
      margin-top: 3px;
      font: 500 6px/1 var(--mono);
      font-style: normal;
      letter-spacing: 0.12em;
      color: inherit;
    }
    .passport-dpkg {
      font: 400 8px/1.3 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .passport-dpkg b { font-weight: 500; color: var(--fg); }
    .pkgs-after,
    .pkgs-delta { display: none; }
    .passport-mrz {
      margin-top: auto;
      font: 400 8px/1.35 var(--mono);
      letter-spacing: 0.02em;
      color: var(--dim);
      white-space: nowrap;
    }
    .passport-mrz span { display: block; }
    /* The install event is the control; pressing it stamps SBX-01 only. */
    .passport-install {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 12px;
      padding: 10px 14px;
      border-top: 1px solid var(--line);
      background: var(--panel);
      cursor: pointer;
      transition: background 0.15s;
    }
    .passport-install:hover { background: var(--panel-2); }
    .pi-event {
      font: 500 7.5px/1.4 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .pi-cmd { font: 400 12px/1.4 var(--mono); color: var(--accent-ink); }
    .pi-act {
      margin-left: auto;
      padding: 4px 7px;
      border: 1px dashed var(--red);
      color: var(--red);
      font: 500 7px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transform: rotate(-2deg);
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .passport-install:hover .pi-act {
      border-style: solid;
      background: var(--red-soft);
    }
    .pi-on { display: none; }
    .visa-input:focus-visible ~ .passport-install {
      outline: 2px solid var(--red-hi);
      outline-offset: -3px;
    }
    .visa-input:checked ~ .passport-install .pi-off { display: none; }
    .visa-input:checked ~ .passport-install .pi-on { display: inline; }
    .visa-input:checked ~ .passport-install .pi-act {
      border-style: solid;
      border-color: var(--accent);
      background: var(--accent-soft);
      color: var(--accent-ink);
    }
    .visa-input:checked ~ .passport-books .slot-hint { display: none; }
    .visa-input:checked ~ .passport-books .passport-b .slot-still { display: block; }
    .visa-input:checked ~ .passport-books .passport-a .passport-slot {
      border-color: var(--red);
      background: var(--red-soft);
    }
    .visa-input:checked ~ .passport-books .passport-a .visa {
      display: block;
      animation: stamp-press 0.42s cubic-bezier(0.2, 0.9, 0.25, 1.2) forwards;
    }
    .visa-input:checked ~ .passport-books .passport-a .pkgs-before { display: none; }
    .visa-input:checked ~ .passport-books .passport-a .pkgs-after {
      display: inline;
      color: var(--accent-ink);
    }
    .visa-input:checked ~ .passport-books .passport-a .pkgs-delta {
      display: inline;
      margin-left: 3px;
      color: var(--red);
    }
    @keyframes stamp-press {
      0% {
        opacity: 0;
        transform: translate(-50%, -50%) rotate(-16deg) scale(1.9);
      }
      60% {
        opacity: 1;
        transform: translate(-50%, -50%) rotate(-7deg) scale(0.96);
      }
      100% {
        opacity: 1;
        transform: translate(-50%, -50%) rotate(-7deg) scale(1);
      }
    }
    .passport-foot {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 7px 14px;
      border-top: 1px solid var(--line);
      font: 500 9px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .passport-foot .right { margin-left: auto; color: var(--dim); }

    @media (hover: hover) {
      .passport { transition: transform 0.15s, box-shadow 0.15s; }
      .passport:hover {
        position: relative;
        z-index: 1;
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 var(--accent);
      }
    }
    @media (max-width: 560px) {
      .passport-books { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
      .passport-bar-state i { animation: none; }
      .visa-input:checked ~ .passport-books .passport-a .visa { animation: none; }
      .passport-stamps span:hover { animation: none; }
    }
</style>
