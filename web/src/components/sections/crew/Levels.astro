---
// The floor plan's key: how far a note reaches each kind, with every kind at
// each level named from its manifest, and the rules every note keeps.
import { levels, noWakeHop, wakesPerHour } from "../../../data/crew";
import { joinNames } from "../../../lib/joinNames";

// Hops count from 0, so the first noWakeHop notes of a chain can wake.
const NUMBERS = ["no", "one", "two", "three", "four"];
const waking = NUMBERS[noWakeHop] ?? String(noWakeHop);
---

<div class="key levels">
    <p class="key-label">Key · how far a note reaches</p>
    <dl>
        {levels.map((l) => (
            <div data-level={l.level}>
                <dt>{l.title}</dt>
                <dd>
                    <b>{l.kinds.length}</b>
                    <span class="levels-names">{l.kinds.length ? joinNames(l.kinds.map((k) => k.label)) : "none yet"}</span>
                    {l.meaning}
                </dd>
            </div>
        ))}
    </dl>
    <ul class="key-rules">
        <li>Your own agents join through the phone tools, plus a hook if they have one.</li>
        <li>Waking is a switch on each agent's page, <q>Other agents can wake it</q>, on by default.</li>
        <li>Only direct notes wake, {wakesPerHour} times an hour at most.</li>
        <li>No endless ping-pong: past the first {waking} notes of a chain, answers wake no one.</li>
        <li>Sending is rate-limited, and a note never starts a stopped agent.</li>
    </ul>
</div>

<style is:global>
    /* The frame, grid and rules are the key primitive (styles/primitives/key.css). */
    .levels dt {
      display: flex;
      align-items: center;
      gap: 6px;
      font: 500 8.5px/1.4 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .levels dt::before { content: ''; width: 6px; height: 6px; flex: none; border: 1px solid var(--faint); }
    .levels [data-level='wakes'] dt { color: var(--red); }
    .levels [data-level='wakes'] dt::before { border-color: var(--red); background: var(--red); }
    .levels [data-level='delivered'] dt { color: var(--accent-ink); }
    .levels [data-level='delivered'] dt::before { border-color: var(--accent); background: var(--accent); }
    .levels [data-level='inbox'] dt::before { border-style: dashed; }
    .levels b {
      display: block;
      margin-bottom: 4px;
      font: 400 44px/0.9 var(--serif);
      letter-spacing: -0.02em;
      color: var(--fg);
    }
    .levels-names { display: block; margin-bottom: 6px; color: var(--fg); }
    .levels .key-rules q { color: var(--fg); }
</style>
