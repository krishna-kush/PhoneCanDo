---
// FIG. 06C: which kinds take a scheduled task and how, every kind named from
// its manifest (data/schedules.ts), and which set their own.
import { cards } from "../../../data/agentCards";
import { groups, scheduleTools, yoursOnly } from "../../../data/schedules";
import { joinNames } from "../../../lib/joinNames";
---

<figure class="takers">
    <div class="fig-bar">
        <span>Who takes a task</span>
        <span class="takers-count">{cards.length} kinds</span>
    </div>
    <dl>
        {groups.map((g) => (
            <div data-level={g.level}>
                <dt>
                    <b>{g.kinds.length}</b>
                    <span>{g.title}</span>
                </dt>
                <dd>
                    <span class="takers-names">{g.kinds.length ? joinNames(g.kinds.map((k) => k.label)) : "none yet"}</span>
                    {g.meaning}
                </dd>
            </div>
        ))}
    </dl>
    <figcaption class="takers-own">
        <b>Their own</b>
        <span>
            Agents set, list and cancel their own with <code>{scheduleTools.join(" · ")}</code>.
            {yoursOnly.length > 0 && <>{" "}{joinNames(yoursOnly.map((k) => k.label))} {yoursOnly.length === 1 ? "runs" : "run"} yours but can't set {yoursOnly.length === 1 ? "its" : "their"} own: no phone tools.</>}
        </span>
    </figcaption>
</figure>

<style is:global>
    .takers {
      display: flex;
      flex-direction: column;
      margin: 0;
      border: 1px solid var(--line);
      background: var(--panel);
      box-shadow: 6px 6px 0 var(--accent);
    }
    .takers-count { margin-left: auto; color: var(--accent-ink); }
    .takers dl { flex: 1; margin: 0; }
    .takers dl > div {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      gap: 14px;
      padding: 14px;
    }
    .takers dl > div + div { border-top: 1px dashed var(--line-2); }
    .takers dt { display: grid; align-content: start; gap: 6px; }
    .takers dt b { font: 400 44px/0.9 var(--serif); letter-spacing: -0.02em; }
    .takers dt span {
      display: flex;
      align-items: center;
      gap: 6px;
      font: 500 8.5px/1.4 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .takers dt span::before { content: ''; width: 6px; height: 6px; flex: none; border: 1px dashed var(--faint); }
    .takers [data-level='wakes'] dt span { color: var(--red); }
    .takers [data-level='wakes'] dt span::before { border: 1px solid var(--red); background: var(--red); }
    .takers [data-level='starts'] dt span { color: var(--accent-ink); }
    .takers [data-level='starts'] dt span::before { border: 1px solid var(--accent); background: var(--accent); }
    .takers dd { margin: 0; font-size: 12.5px; line-height: 1.55; color: var(--muted); }
    .takers-names { display: block; margin-bottom: 5px; color: var(--fg); }
    .takers-own {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 12px;
      padding: 12px 14px;
      border-top: 1px solid var(--line);
      font: 400 10px/1.5 var(--mono);
      color: var(--dim);
    }
    .takers-own b {
      padding: 2px 6px;
      background: var(--accent);
      color: var(--art-bg);
      font: 600 8.5px/1.3 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .takers-own span { flex: 1 1 260px; }
    .takers-own code { color: var(--fg); }

    @media (max-width: 420px) {
      .takers dl > div { grid-template-columns: 1fr; gap: 6px; }
    }
</style>
