---
// One agent's row on the night roll: who it is (its creature, its alarm
// clock, how a task reaches it) and its strip of tape, where each task is a
// punched hole, each run a stamp and a bar of work. lib/schedules/paint.ts
// fills the tape; data-state drives the look: busy, idle or stopped. A kind
// that can't run schedules has its tape taped over.
import Bot from "../models/Bot.astro";
import type { RollLane } from "../../../data/schedules";

interface Props {
    lane: RollLane;
    i: number;
}
const { lane, i } = Astro.props;
const { card } = lane;
const HOW = { wakes: "starts or wakes", starts: "starts with a task", none: "can't run schedules" };
---

<div
    class="lane"
    data-lane={i}
    data-level={lane.level}
    data-state={lane.start}
    style={`--i:${i}`}
>
    <div class="lane-who">
        <span class="lane-art" aria-hidden="true">
            <span class="lane-zz"><i>z</i><i>z</i></span>
            <span class="lane-dots"><i></i><i></i><i></i></span>
            <Bot look={card.look} size={22} />
        </span>
        <span class="lane-text">
            <b class="lane-name">{card.label}</b>
            <small>{HOW[lane.level]}{lane.kept && " · kept running"}</small>
        </span>
        <span class="lane-clock" aria-hidden="true"><i></i><b>ring!</b></span>
    </div>
    <button
        class="lane-tape"
        type="button"
        data-tape
        aria-label={lane.level === "none"
            ? `${card.label} can't run schedules`
            : `Punch a task for ${card.label} at the time on the clock`}
    >
        <span class="lane-ghost" data-ghost aria-hidden="true"><b></b></span>
        {lane.level === "none" && (
            <span class="lane-tapeover" aria-hidden="true">
                <b>Can't run schedules</b> no start prompt · no wake
            </span>
        )}
    </button>
</div>

<style is:global>
    /* Its two cells sit in the roll's grid: who on the left, tape on the right. */
    .lane { display: contents; }
    .lane-who {
      position: relative;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      padding: 0 10px 0 8px;
      border-top: 1px solid var(--line);
      transition: background 0.5s;
    }
    .lane-art {
      position: relative;
      display: grid;
      place-items: end center;
      width: 40px;
      height: 46px;
      padding-bottom: 6px;
    }
    .lane-art::after {
      content: '';
      position: absolute;
      right: 4px;
      bottom: 6px;
      left: 4px;
      height: 1px;
      background: var(--line-2);
    }
    .lane .bot { --bot-line: var(--fg); transition: opacity 0.4s; }
    .lane .bot-eye { transition: transform 0.25s; }
    .lane-text { display: grid; gap: 2px; min-width: 0; }
    .lane-name {
      overflow: hidden;
      font: 400 16px/1.05 var(--serif);
      letter-spacing: -0.01em;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .lane-text small {
      font: 500 7.5px/1.3 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .lane[data-level='wakes'] .lane-text small { color: var(--red); }
    .lane[data-level='starts'] .lane-text small { color: var(--accent-ink); }

    /* busy: it bobs, dots blink; idle: heavy lids, z's; stopped: a dashed ghost. */
    .lane[data-state='busy'] .bot { animation: lane-bob 1.1s ease-in-out infinite; animation-delay: calc(var(--i) * -0.3s); }
    @keyframes lane-bob { 50% { translate: 0 -2px; } }
    .lane-dots {
      position: absolute;
      top: 2px;
      left: 50%;
      display: flex;
      gap: 2px;
      translate: -50% 0;
      opacity: 0;
    }
    .lane-dots i { width: 3px; height: 3px; background: var(--accent); animation: blink 0.9s steps(1) infinite; }
    .lane-dots i:nth-child(2) { animation-delay: 0.3s; }
    .lane-dots i:nth-child(3) { animation-delay: 0.6s; }
    .lane[data-state='busy'] .lane-dots { opacity: 1; }
    .lane[data-state='idle'] .bot-eye { transform: scaleY(0.3); }
    .lane-zz { position: absolute; top: 0; left: calc(50% + 9px); opacity: 0; }
    .lane-zz i {
      position: absolute;
      font: italic 400 12px/1 var(--serif);
      color: var(--dim);
      opacity: 0;
      animation: lane-z 2.4s ease-out infinite;
    }
    .lane-zz i:nth-child(2) { animation-delay: 1.2s; }
    @keyframes lane-z {
      0% { opacity: 0; translate: 0 12px; scale: 0.6; }
      25% { opacity: 1; }
      100% { opacity: 0; translate: 10px -6px; scale: 1.1; }
    }
    .lane[data-state='idle'] .lane-zz { opacity: 1; }
    .lane[data-state='stopped'] .bot-ink { background: transparent; outline: 1px dashed var(--faint); outline-offset: -1px; }
    .lane[data-state='stopped'] .bot-face,
    .lane[data-state='stopped'] .bot-wear { opacity: 0; }
    .lane[data-state='stopped'] .lane-name { color: var(--dim); }

    /* Its alarm clock: two bells, two hands. It rings when a task reaches it. */
    .lane-clock {
      position: relative;
      width: 13px;
      height: 13px;
      border: 1.5px solid var(--dim);
      border-radius: 50%;
      transition: border-color 0.3s;
    }
    .lane-clock::before,
    .lane-clock::after {
      content: '';
      position: absolute;
      top: -4px;
      width: 5px;
      height: 3px;
      border-radius: 3px 3px 0 0;
      background: var(--dim);
    }
    .lane-clock::before { left: -3px; rotate: -35deg; }
    .lane-clock::after { right: -3px; rotate: 35deg; }
    .lane-clock i {
      position: absolute;
      top: 1.5px;
      left: 4px;
      width: 1.5px;
      height: 3.5px;
      background: var(--dim);
      box-shadow: 1.5px 2.5px 0 0 var(--dim);
    }
    .lane-clock b {
      position: absolute;
      bottom: calc(100% + 5px);
      left: 50%;
      font: 700 7px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--red);
      white-space: nowrap;
      opacity: 0;
      translate: -50% 4px;
    }
    .lane[data-level='none'] .lane-clock { opacity: 0.35; }
    .lane[data-ring] .lane-clock { border-color: var(--red); animation: lane-ring 0.12s linear 6; }
    .lane[data-ring] .lane-clock::before,
    .lane[data-ring] .lane-clock::after { background: var(--red); }
    .lane[data-ring] .lane-clock b { animation: lane-ring-word 0.9s ease-out; }
    .lane[data-ring] .bot { animation: lane-jolt 0.7s cubic-bezier(0.3, 1.4, 0.5, 1); }
    .lane[data-ring] .bot-eye { transform: scaleY(1.25); }
    @keyframes lane-ring { 25% { rotate: -16deg; } 75% { rotate: 16deg; } }
    @keyframes lane-ring-word {
      0% { opacity: 0; translate: -50% 4px; }
      20%, 70% { opacity: 1; translate: -50% 0; }
      100% { opacity: 0; translate: -50% -4px; }
    }
    @keyframes lane-jolt {
      25% { translate: 0 -14px; rotate: -10deg; }
      50% { translate: 0 0; rotate: 0deg; scale: 1.16 0.84; }
      72% { scale: 0.95 1.05; }
    }
    /* The bump of a punch it refuses, or a hole it keeps. */
    .lane[data-nope] .lane-tape { animation: lane-nope 0.36s; }
    @keyframes lane-nope { 25%, 75% { translate: -3px 0; } 50% { translate: 3px 0; } }

    /* The tape: paper with a row of feed holes, the night left to right. */
    .lane-tape {
      position: relative;
      display: block;
      width: 100%;
      height: 62px;
      padding: 0;
      border: 0;
      border-top: 1px solid var(--line);
      color: inherit;
      font: inherit;
      text-align: left;
      background:
        radial-gradient(circle, var(--line-2) 0 1.2px, transparent 1.7px) 0 31px / 12px 1px repeat-x,
        var(--bg);
      cursor: crosshair;
      outline-offset: -2px;
      -webkit-tap-highlight-color: transparent;
    }
    .lane[data-level='none'] .lane-tape { cursor: not-allowed; }

    /* Where a click would punch, and its time. */
    .lane-ghost {
      position: absolute;
      top: 31px;
      left: calc(var(--x, 0) * 100%);
      width: 13px;
      height: 13px;
      border: 1px dashed var(--red);
      border-radius: 50%;
      translate: -50% -50%;
      opacity: 0;
      pointer-events: none;
    }
    .lane-ghost b {
      position: absolute;
      bottom: calc(100% + 3px);
      left: 50%;
      translate: -50% 0;
      font: 500 7.5px/1 var(--mono);
      color: var(--red);
      white-space: nowrap;
    }
    .lane[data-level='wakes'] .lane-tape[data-hover] .lane-ghost,
    .lane[data-level='starts'] .lane-tape[data-hover] .lane-ghost { opacity: 1; }

    /* A task: a hole punched through to the dark behind, ringed red when
       you set it, amber and dashed when the agent set it for itself. */
    .hole {
      position: absolute;
      z-index: 1;
      top: 31px;
      left: calc(var(--x) * 100%);
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: var(--art-bg);
      box-shadow: 0 0 0 1.5px var(--red);
      translate: -50% -50%;
      cursor: pointer;
      transition: scale 0.15s;
    }
    @media (hover: hover) {
      .hole:hover { scale: 1.25; }
    }
    .hole[data-by='agent'] { box-shadow: none; outline: 1.5px dashed var(--accent-ink); outline-offset: 0; }
    /* A day-only task that skips tonight: a hole not punched through. */
    .hole[data-off] { background: var(--bg); box-shadow: 0 0 0 1px var(--faint); }
    .hole[data-off] em { color: var(--faint); }
    .hole[data-set] { scale: 0; opacity: 0; }
    .hole[data-set][data-on] { scale: 1; opacity: 1; animation: hole-pop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1); }
    @keyframes hole-pop { 0% { scale: 0; rotate: -90deg; } }
    .hole[data-fresh] { animation: hole-pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1); }
    .hole em {
      position: absolute;
      top: calc(100% + 4px);
      left: -2px;
      font: 400 8px/1 var(--mono);
      font-style: normal;
      letter-spacing: 0.02em;
      color: var(--muted);
      white-space: nowrap;
      pointer-events: none;
    }
    .hole[data-by='agent'] em { color: var(--accent-ink); }

    /* The work: a bar that draws in as the agent works (paint.ts clips
       it to the line), and what it was doing as you left. */
    .work {
      position: absolute;
      bottom: 4px;
      left: calc(var(--x) * 100%);
      width: calc(var(--w) * 100%);
      height: 4px;
      background: var(--accent);
      clip-path: inset(0 100% 0 0);
    }
    .work[data-cut] { background: repeating-linear-gradient(90deg, var(--accent) 0 4px, transparent 4px 6px); }
    .work-label {
      position: absolute;
      bottom: 11px;
      left: calc(var(--x) * 100% + 2px);
      font: 400 8px/1 var(--mono);
      font-style: normal;
      color: var(--dim);
      white-space: nowrap;
      pointer-events: none;
    }
    /* A task waiting on a busy run: a dashed line drawing in to the line,
       and a tag at its hole while it still waits. */
    .trail {
      position: absolute;
      top: 31px;
      left: calc(var(--x) * 100%);
      width: calc(var(--w) * 100%);
      border-top: 1px dashed var(--accent-ink);
      clip-path: inset(0 100% 0 0);
    }
    .trail-tag {
      position: absolute;
      top: 13px;
      left: calc(var(--x) * 100% + 9px);
      padding: 1px 3px;
      border: 1px solid var(--accent-line);
      background: var(--bg);
      font: 500 6.5px/1 var(--mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-ink);
      opacity: 0;
      transition: opacity 0.25s;
      pointer-events: none;
    }
    .trail-tag[data-on] { opacity: 1; animation: trail-tag 1.2s ease-in-out infinite; }
    @keyframes trail-tag { 50% { opacity: 0.45; } }
    /* What a run did, stamped where it ran. */
    .lane-tape .stamp {
      position: absolute;
      z-index: 2;
      top: 3px;
      left: calc(var(--x) * 100%);
      display: grid;
      padding: 2px 3px 1px;
      border: 1px solid currentColor;
      background: var(--bg);
      color: var(--accent-ink);
      font: 700 7px/1.15 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
      opacity: 0;
      translate: -50% 0;
      rotate: -7deg;
      pointer-events: none;
    }
    .lane-tape .stamp[data-outcome='skipped'] { color: var(--dim); }
    .lane-tape .stamp small { font: 700 6px/1.1 var(--mono); color: var(--red); }
    .lane-tape .stamp[data-on] { opacity: 1; animation: stamp-in 0.45s cubic-bezier(0.2, 0.9, 0.25, 1.3); }
    @keyframes stamp-in {
      0% { opacity: 0; scale: 1.9; rotate: -18deg; }
      60% { opacity: 1; scale: 0.94; }
    }
    /* Already down when the tape was redrawn: no second entrance. */
    .lane-tape .stamp[data-on][data-quiet],
    .hole[data-on][data-quiet] { animation: none; }

    /* A kind that can't take a task: its tape is taped over. */
    .lane-tapeover {
      position: absolute;
      top: 50%;
      right: 0;
      left: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      height: 20px;
      translate: 0 -50%;
      background: repeating-linear-gradient(-45deg, var(--accent) 0 7px, color-mix(in srgb, var(--accent) 35%, var(--bg)) 7px 14px);
      font: 500 7.5px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--art-bg);
    }
    .lane-tapeover b {
      padding: 3px 6px;
      background: var(--art-bg);
      color: var(--art-accent);
      font-weight: 600;
    }

    @media (max-width: 640px) {
      .lane-who { grid-template-columns: auto auto; justify-content: center; gap: 2px; padding: 0 4px; }
      .lane-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
      .hole em,
      .work-label { display: none; }
      .lane-tape .stamp { padding: 1px 2px 0; font-size: 5.5px; }
      .lane-tapeover { font-size: 0; gap: 0; }
      .lane-tapeover b { font-size: 6.5px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lane .bot,
      .lane-dots i,
      .lane-zz i,
      .lane[data-ring] .lane-clock,
      .lane[data-ring] .lane-clock b,
      .lane[data-nope] .lane-tape,
      .hole[data-set][data-on],
      .hole[data-fresh],
      .trail-tag[data-on],
      .lane-tape .stamp[data-on] { animation: none; }
      .lane-zz i:first-child { opacity: 1; translate: 5px 0; }
    }
</style>
