---
// FIG. 06: one night on a punched roll, like a music box's. Each lead agent
// has a row of tape, each task is a hole, and the line is now: "Go to sleep"
// runs the night from 21:00 to 09:00 under a sky going from dusk to dawn.
// The moon climbs and sets over it, the sun comes up at dawn (lib/schedules/
// sky.ts). As the line reaches a hole that agent's alarm rings and the task
// finds it stopped, idle or busy, and the run is stamped where it ran. Click
// a row to punch a task, hold the power button to switch the phone off for a
// while, drag the sky or the clock to scrub. At 09:00 a receipt prints what
// ran. The night itself is lib/schedules/night.ts; lib/schedules/roll.ts
// wires it. Every agent, kind and number comes from data/schedules.ts. The
// sky is night-dark on the dark theme and a paper chart on the light one.
import RollLane from "./RollLane.astro";
import { rollData, rollLanes } from "../../../data/schedules";

const HOURS = Array.from({ length: 13 }, (_, h) => ({ at: Number((h / 12).toFixed(4)), label: String((21 + h) % 24).padStart(2, "0") }));
const DAY = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
---

<figure class="roll" data-roll>
    <script is:inline type="application/json" data-night set:html={JSON.stringify(rollData).replaceAll("<", "\\u003c")} />
    <div class="fig-bar">
        <span class="roll-title">One night · {rollLanes.length} agents</span>
        <span class="roll-every" role="group" aria-label="A task you punch runs">
            <button type="button" data-every="0" aria-pressed="true">Once</button>
            <button type="button" data-every="60" aria-pressed="false">Hourly</button>
            <button type="button" data-every="120" aria-pressed="false">Every 2 h</button>
        </span>
        <button
            class="toy-btn roll-go"
            type="button"
            data-go
            aria-pressed="false"
            data-play="Go to sleep"
            data-pause="Pause the night"
            data-again="Again"
        >
            <span class="go-icon" aria-hidden="true"></span>
            <span data-go-label>Go to sleep</span>
        </button>
        <button class="toy-btn roll-power" type="button" data-power aria-pressed="false" aria-label="Hold to switch the phone off">
            <span class="power-icon" aria-hidden="true"></span>
            Hold · phone off
        </button>
    </div>

    <div class="roll-stage" data-stage>
        <button class="roll-day" type="button" data-day data-days={DAY.join(" ")} aria-label="Change the night">
            <b data-day-name>{DAY[rollData.eve]}</b> night
        </button>
        <div class="roll-sky" data-sky>
            <span class="roll-stars" aria-hidden="true"></span>
            <span class="roll-moon" data-moon aria-hidden="true"></span>
            <span class="roll-sun" data-sun aria-hidden="true"><i></i></span>
        </div>
        <p class="roll-hours-label">Agent</p>
        <div class="roll-hours" data-hours aria-hidden="true">
            {HOURS.map((h) => <span style={`--at:${h.at}`}>{h.label}</span>)}
        </div>
        {rollLanes.map((lane, i) => <RollLane lane={lane} i={i} />)}
        <div class="roll-track" data-track>
            <span class="roll-head" data-head>
                <span
                    class="roll-now"
                    data-now
                    role="slider"
                    tabindex="0"
                    aria-label="Time of night"
                    aria-valuemin="0"
                    aria-valuemax="720"
                    aria-valuenow="0"
                    aria-valuetext="21:00"
                >21:00</span>
            </span>
        </div>
    </div>

    <p class="roll-foot">
        <span>Click a row to punch a task, or a hole to take it out.</span>
        <span>Hold the power button while the night runs to switch the phone off.</span>
    </p>

    <div class="roll-slot">
        <div class="roll-slot-in">
            <div class="receipt" data-receipt>
                <p class="receipt-head">While you slept</p>
                <p class="receipt-when" data-receipt-when></p>
                <ol class="receipt-lines" data-lines></ol>
                <p class="receipt-total" data-total></p>
                <p class="receipt-morning">Good morning.</p>
                <button class="toy-btn receipt-tear" type="button" data-tear>Tear off · new night</button>
            </div>
        </div>
    </div>
    <p class="sr" data-live aria-live="polite"></p>
</figure>

<script>
    import { mountRoll } from "../../../lib/schedules/roll";

    const root = document.querySelector<HTMLElement>("[data-roll]");
    if (root) mountRoll(root);
</script>

<style is:global>
    .roll {
      --who: 190px;
      /* The sky's colours: night-dark here, a paper chart on the light theme. */
      --night: var(--art-bg);
      --dusk: color-mix(in srgb, var(--red) 55%, var(--art-bg));
      --dawn: color-mix(in srgb, var(--accent) 75%, var(--art-bg));
      --star: var(--art-fg);
      --star-2: var(--art-accent);
      --star-3: var(--art-dim);
      --moon: var(--art-fg);
      --sun: var(--art-accent);
      --glow: color-mix(in srgb, var(--art-accent) 25%, transparent);
      position: relative;
      margin: 0;
      border: 1px solid var(--line);
      background: var(--panel);
      box-shadow: var(--plate-shadow);
    }
    [data-theme='light'] .roll {
      --night: color-mix(in srgb, var(--fg) 5%, var(--bg));
      --dusk: color-mix(in srgb, var(--red) 26%, var(--bg));
      --dawn: color-mix(in srgb, var(--accent) 48%, var(--bg));
      --star: var(--fg);
      --star-2: var(--accent-ink);
      --star-3: var(--faint);
      --moon: var(--fg);
      --sun: var(--accent);
      --glow: transparent;
    }
    .roll .sr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .roll-title { margin-right: auto; }
    .roll-every { display: inline-flex; }
    .roll-every button {
      padding: 6px 8px;
      border: 1px solid var(--line-2);
      background: var(--bg);
      font: 500 8.5px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--dim);
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }
    .roll-every button + button { border-left: 0; }
    .roll-every button[aria-pressed='true'] { background: var(--fg); border-color: var(--fg); color: var(--bg); }

    /* A moon to go to sleep by, two bars while it plays, a sun once you're up. */
    .go-icon {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      box-shadow: inset 4px -1px 0 0 var(--fg);
      transition: box-shadow 0.3s, background 0.3s, border-radius 0.3s, scale 0.3s;
    }
    .roll[data-playing] .go-icon { box-shadow: inset 3px 0 0 0 var(--fg), inset -3px 0 0 0 var(--fg); border-radius: 0; scale: 0.8; }
    .roll[data-printed] .go-icon { background: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }

    /* The power button: a ring with a gap and a stroke. Held, it's red. */
    .power-icon {
      position: relative;
      width: 10px;
      height: 10px;
      border: 1.5px solid currentColor;
      border-top-color: transparent;
      border-radius: 50%;
    }
    .power-icon::after {
      content: '';
      position: absolute;
      top: -3.5px;
      left: 50%;
      width: 1.5px;
      height: 6px;
      background: currentColor;
      translate: -50% 0;
    }
    .roll-power { touch-action: none; user-select: none; -webkit-user-select: none; }
    .roll-power[aria-pressed='true'] {
      border-color: var(--red);
      background: var(--red);
      color: var(--on-primary);
      translate: 1px 1px;
      box-shadow: 1px 1px 0 var(--accent);
    }

    /* The stage: who on the left, the night on the right, one row each. */
    .roll-stage {
      --sky: 58px;
      position: relative;
      display: grid;
      grid-template-columns: var(--who) minmax(0, 1fr);
      grid-template-rows: var(--sky) 20px;
      background: var(--panel);
    }
    .roll-day {
      display: grid;
      align-content: center;
      justify-items: start;
      gap: 3px;
      padding: 0 14px;
      border: 0;
      border-right: 1px solid var(--line);
      background: none;
      color: var(--dim);
      font: 500 8.5px/1 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-align: left;
      cursor: pointer;
    }
    .roll-day b { font: 400 22px/1 var(--serif); letter-spacing: 0; text-transform: none; color: var(--fg); transition: color 0.2s; }
    .roll-day::after { content: 'change ↻'; color: var(--accent-ink); font-size: 7px; }
    @media (hover: hover) {
      .roll-day:hover b { color: var(--red); }
    }

    /* The sky over the night: dusk at 21:00, night through the small hours,
       dawn by 09:00. Dragging it scrubs. */
    .roll-sky {
      position: relative;
      overflow: hidden;
      background: linear-gradient(
        90deg,
        var(--dusk),
        color-mix(in srgb, var(--dusk) 30%, var(--night)) 10%,
        var(--night) 24%,
        var(--night) 64%,
        color-mix(in srgb, var(--dawn) 26%, var(--night)) 82%,
        var(--dawn)
      );
      cursor: ew-resize;
      touch-action: none;
    }
    .roll-stars {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle, var(--star) 0 0.8px, transparent 1.3px) 0 0 / 29px 23px,
        radial-gradient(circle, var(--star-2) 0 1px, transparent 1.6px) 13px 9px / 61px 37px,
        radial-gradient(circle, var(--star-3) 0 0.9px, transparent 1.4px) 7px 17px / 43px 31px;
      mask-image: linear-gradient(90deg, transparent 6%, #000 22%, #000 66%, transparent 84%);
      -webkit-mask-image: linear-gradient(90deg, transparent 6%, #000 22%, #000 66%, transparent 84%);
      animation: roll-twinkle 3.2s ease-in-out infinite;
    }
    @keyframes roll-twinkle { 50% { opacity: 0.55; } }

    /* The moon and the sun ride the line; roll.ts sets how high and how far
       they lean. Under the horizon the sky hides them. */
    .roll-moon,
    .roll-sun {
      position: absolute;
      top: 0;
      left: 0;
      width: 18px;
      height: 18px;
      margin: -9px 0 0 -9px;
      border-radius: 50%;
      pointer-events: none;
      will-change: transform;
    }
    .roll-moon { box-shadow: inset 6px -2px 0 0 var(--moon), 0 0 18px 4px var(--glow); }
    .roll-sun { background: var(--sun); box-shadow: 0 0 22px 6px color-mix(in srgb, var(--sun) 40%, transparent); }
    .roll-sun i {
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      background: repeating-conic-gradient(var(--sun) 0 9deg, transparent 9deg 30deg);
      mask-image: radial-gradient(circle, transparent 11px, #000 11.5px);
      -webkit-mask-image: radial-gradient(circle, transparent 11px, #000 11.5px);
      animation: roll-rays 14s linear infinite;
    }
    @keyframes roll-rays { to { rotate: 360deg; } }

    .roll-hours-label {
      display: flex;
      align-items: center;
      padding: 0 14px;
      border-right: 1px solid var(--line);
      font: 500 7.5px/1 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .roll-hours {
      position: relative;
      font: 500 7.5px/1 var(--mono);
      letter-spacing: 0.06em;
      color: var(--faint);
      cursor: ew-resize;
      touch-action: none;
    }
    .roll-hours span { position: absolute; top: 8px; left: calc(var(--at) * 100%); translate: -50% 0; }
    .roll-hours span::before {
      content: '';
      position: absolute;
      bottom: calc(100% + 2px);
      left: 50%;
      width: 1px;
      height: 4px;
      background: var(--line-2);
    }
    .roll-hours span:first-child { translate: 2px 0; }
    .roll-hours span:last-child { translate: calc(-100% - 2px) 0; }
    .roll-hours span:first-child::before { left: -2px; }
    .roll-hours span:last-child::before { left: calc(100% + 2px); }
    .lane-who { border-right: 1px solid var(--line); }

    /* Over the night column, through every row: the line, and the dark
       while the phone was off. Out of the grid's flow, so the rows place
       as if it weren't there. */
    .roll-track {
      position: absolute;
      z-index: 3;
      inset: 0 0 0 var(--who);
      pointer-events: none;
    }
    /* The line: moved by transform only, so it glides. Its clock sits on
       the hours ruler, and leans inside the night at either end. */
    .roll-head {
      position: absolute;
      top: 0;
      bottom: 0;
      left: -0.75px;
      width: 1.5px;
      background: var(--red);
      will-change: transform;
    }
    .roll-now {
      position: absolute;
      top: calc(var(--sky) + 3px);
      left: 0;
      padding: 3px 5px;
      background: var(--red);
      color: var(--on-primary);
      font: 600 8.5px/1 var(--mono);
      letter-spacing: 0.06em;
      white-space: nowrap;
      cursor: grab;
      pointer-events: auto;
      touch-action: none;
      will-change: transform;
      outline-offset: 2px;
    }
    .roll-now:active { cursor: grabbing; }
    .roll-dark {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(var(--x) * 100%);
      width: calc(var(--w) * 100%);
      background: repeating-linear-gradient(-45deg, var(--art-bg) 0 6px, color-mix(in srgb, var(--art-fg) 9%, var(--art-bg)) 6px 12px);
      opacity: 0.92;
    }
    .roll-dark b {
      position: absolute;
      bottom: 6px;
      left: 4px;
      padding: 2px 4px;
      background: var(--art-bg);
      color: var(--art-accent);
      font: 600 7px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* Asleep: on the dark theme the paper goes to night ink, slowly; the one
       working gets a lamp. */
    .lane-tape { transition: background-color 0.8s; }
    :root:not([data-theme='light']) .roll[data-asleep] .lane-tape { background-color: var(--art-bg); }
    .lane-who::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 28px 85%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 60%);
      opacity: 0;
      transition: opacity 0.6s;
      pointer-events: none;
    }
    .roll[data-asleep] .lane[data-state='busy'] .lane-who::before { opacity: 1; }

    .roll-foot {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 18px;
      padding: 10px 14px;
      border-top: 1px solid var(--line);
      font: 400 10px/1.5 var(--mono);
      color: var(--dim);
    }
    .roll-foot span::before { content: '—'; margin-right: 6px; color: var(--accent-ink); }

    /* The printer: at 09:00 the receipt feeds out of the slot, the slot
       opening with it; torn off, it flies away and the slot closes. */
    .roll-slot {
      display: grid;
      grid-template-rows: 0fr;
      border-top: 3px solid var(--line-2);
      transition: grid-template-rows 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .roll-slot-in { min-height: 0; overflow: hidden; }
    .receipt {
      position: relative;
      width: min(360px, calc(100% - 28px));
      margin: 0 auto 22px;
      padding: 16px 18px 14px;
      background: var(--bg);
      color: var(--fg);
      font: 400 10px/1.5 var(--mono);
      box-shadow: 4px 4px 0 var(--accent);
      translate: 0 -100%;
      transition: translate 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .roll[data-printed] .roll-slot,
    .roll[data-printed] .receipt { transition-duration: 1.2s; transition-timing-function: cubic-bezier(0.2, 0.7, 0.15, 1); }
    .roll[data-printed] .roll-slot { grid-template-rows: 1fr; }
    .roll[data-printed] .receipt { translate: 0 0; }
    /* The torn edge. */
    .receipt::after {
      content: '';
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      height: 6px;
      background:
        linear-gradient(135deg, var(--bg) 3px, transparent 0) 0 0 / 8px 6px repeat-x,
        linear-gradient(-135deg, var(--bg) 3px, transparent 0) 0 0 / 8px 6px repeat-x;
    }
    .receipt[data-torn] { animation: receipt-tear 0.55s cubic-bezier(0.5, 0, 0.75, 0) forwards; }
    @keyframes receipt-tear {
      0% { translate: 0 0; rotate: 0deg; }
      30% { translate: 0 5px; rotate: -2deg; opacity: 1; }
      100% { translate: 90px -60px; rotate: 14deg; opacity: 0; }
    }
    .receipt-head {
      font: 700 11px/1.2 var(--mono);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-align: center;
    }
    .receipt-when { text-align: center; color: var(--dim); }
    .receipt-lines {
      display: grid;
      gap: 5px;
      margin: 10px 0;
      padding: 10px 0;
      border-block: 1px dashed var(--line-2);
      list-style: none;
    }
    .receipt-lines li { display: grid; grid-template-columns: 40px minmax(0, 1fr); }
    .receipt-lines li > span:last-child { display: grid; }
    .receipt-lines i { font-style: normal; color: var(--dim); }
    .receipt-lines [data-own] b::after { content: ' ✎ its own note'; font-weight: 400; color: var(--accent-ink); }
    .receipt-lines .more { display: block; text-align: center; color: var(--dim); }
    .receipt-total { font-weight: 600; }
    .receipt-morning { margin: 8px 0 12px; font: 400 26px/1 var(--serif); text-align: center; }
    .receipt-tear { display: flex; margin: 0 auto; }

    @media (max-width: 760px) {
      .roll { --who: 120px; }
      .roll-every button { padding: 6px; }
    }
    @media (max-width: 640px) {
      .roll { --who: 58px; }
      .roll-stage { --sky: 54px; }
      .roll-day { padding: 0 6px; font-size: 6.5px; }
      .roll-day b { font-size: 15px; }
      .roll-day::after { display: none; }
      .roll-hours-label { font-size: 0; }
      .roll-hours span:nth-child(odd):not(:first-child):not(:last-child) { visibility: hidden; }
    }
    @media (prefers-reduced-motion: reduce) {
      .roll-stars,
      .roll-sun i { animation: none; }
      .roll-slot,
      .receipt,
      .lane-tape,
      .lane-who::before { transition: none !important; }
      .receipt[data-torn] { animation: none; opacity: 0; }
    }
</style>
