---
// FIG. 06B: an agent sets itself a reminder from chat. You ask for a fix; it
// pushes, says it'll check back, and its schedule_add puts a sticky note on
// its board. At 21:45 the note rings and comes back into the chat as its
// own note, not a new order from you. Switch "Can schedule itself" off and
// the tool says not_allowed: the note falls off the board, and what you set
// still runs. lib/schedules/noteToSelf.ts plays it.
import Bot from "../models/Bot.astro";
import { scheduleTools, selfCard } from "../../../data/schedules";

const add = scheduleTools.find((t) => t.endsWith("_add")) ?? scheduleTools[0];
---

{selfCard && (
    <figure class="nts" data-nts data-self="on" data-step="6">
        <div class="fig-bar">
            <span class="nts-who"><Bot look={selfCard.look} size={14} /> Chat · {selfCard.label}</span>
            <button class="nts-switch" type="button" role="switch" aria-checked="true" data-switch>
                <span class="nts-knob" aria-hidden="true"></span>
                Can schedule itself
            </button>
        </div>
        <div class="nts-stage">
            <ol class="nts-chat">
                <li class="nts-you" data-step="1">Fix the flaky login test and push it.</li>
                <li class="nts-agent" data-step="2">Pushed. CI takes about 20 minutes, so I'll check back on it at 21:45.</li>
                <li class="nts-tool" data-step="3">
                    <code>{add}</code> in 30 min
                    <b data-branch="on">✓ set</b>
                    <b data-branch="off">✕ not_allowed</b>
                </li>
                <li class="nts-later" data-step="4" data-branch="on"><span>21:45 · its alarm</span></li>
                <li class="nts-self" data-step="5" data-branch="on">
                    <small>Note to self · set at 21:15</small>
                    Check the CI run for the login fix. If it failed, fix it.
                </li>
                <li class="nts-agent" data-step="6" data-branch="on">CI is green. All done.</li>
                <li class="nts-refused" data-step="4" data-branch="off">
                    Its own reminders are off on its page. Yours still ring.
                </li>
                <li class="nts-agent" data-step="5" data-branch="off">I can't set myself a reminder here. Check the CI when you're back?</li>
            </ol>
            <div class="nts-board" aria-hidden="true">
                <p class="nts-board-head">Schedules <b>ring!</b></p>
                <span class="nts-note">
                    <b>21:45</b>
                    check the CI run
                    <small>by the agent</small>
                    <em>not allowed</em>
                </span>
            </div>
        </div>
    </figure>
)}

<script>
    import { mountNoteToSelf } from "../../../lib/schedules/noteToSelf";

    const root = document.querySelector<HTMLElement>("[data-nts]");
    if (root) mountNoteToSelf(root);
</script>

<style is:global>
    .nts {
      display: flex;
      flex-direction: column;
      margin: 0;
      border: 1px solid var(--line);
      background: var(--panel);
      box-shadow: 6px 6px 0 var(--accent);
    }
    .nts-switch {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-left: auto;
      padding: 0;
      border: 0;
      background: none;
      font: 500 8.5px/1 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg);
      cursor: pointer;
    }
    .nts-knob {
      position: relative;
      width: 24px;
      height: 13px;
      border: 1px solid var(--accent-ink);
      background: var(--accent-soft);
      transition: background 0.2s, border-color 0.2s;
    }
    .nts-knob::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 13px;
      width: 7px;
      height: 7px;
      background: var(--accent-ink);
      transition: left 0.2s, background 0.2s;
    }
    .nts[data-self='off'] .nts-knob { border-color: var(--line-2); background: var(--bg); }
    .nts[data-self='off'] .nts-knob::after { left: 2px; background: var(--faint); }

    .nts-stage {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 118px;
      gap: 14px;
      min-height: 330px;
      padding: 16px 14px;
      background-color: var(--bg);
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    /* The chat: each line comes in at its step; the other branch's never do. */
    .nts-chat {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 12.5px;
      line-height: 1.45;
    }
    .nts[data-live] .nts-chat > li { opacity: 0; translate: 0 6px; transition: opacity 0.35s, translate 0.35s; }
    .nts[data-live] .nts-chat > li[data-on] { opacity: 1; translate: 0 0; }
    .nts[data-self='on'] [data-branch='off'],
    .nts[data-self='off'] [data-branch='on'] { display: none; }
    .nts-you {
      align-self: flex-end;
      max-width: 82%;
      padding: 7px 10px;
      border: 1px solid var(--red);
      background: var(--panel);
      color: var(--fg);
    }
    .nts-agent { max-width: 88%; padding: 7px 10px; border: 1px solid var(--line-2); background: var(--panel); color: var(--muted); }
    .nts-who { display: inline-flex; align-items: center; gap: 8px; }
    .nts-who .bot { --bot-line: var(--fg); }
    .nts-tool {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      margin-left: 26px;
      font: 400 9.5px/1.4 var(--mono);
      color: var(--dim);
    }
    .nts-tool::before { content: '↳'; color: var(--accent-ink); }
    .nts-tool code { color: var(--fg); }
    .nts-tool b { font-weight: 600; color: var(--accent-ink); }
    .nts-tool b[data-branch='off'] { color: var(--red); }
    .nts-later {
      display: flex;
      align-items: center;
      gap: 8px;
      font: 500 8px/1 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .nts-later::before,
    .nts-later::after { content: ''; flex: 1; border-top: 1px dashed var(--line-2); }
    /* Its own note: amber and dashed, never dressed as you. */
    .nts-self {
      display: grid;
      gap: 3px;
      max-width: 90%;
      margin-left: 24px;
      padding: 7px 10px;
      border: 1px dashed var(--accent-ink);
      background: var(--accent-soft);
      color: var(--fg);
    }
    .nts-self small {
      font: 600 7.5px/1.3 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent-ink);
    }
    .nts-refused {
      margin-left: 26px;
      padding: 6px 9px;
      border-left: 2px solid var(--red);
      font: 400 10px/1.5 var(--mono);
      color: var(--dim);
    }

    /* The board: the sticky note lands here at step 3, rings at 4, goes back
       into the chat at 5; switched off, it gets stamped and falls. */
    .nts-board {
      position: relative;
      align-self: start;
      min-height: 150px;
      border: 1px solid var(--line-2);
      background: var(--panel);
    }
    .nts-board-head {
      display: flex;
      justify-content: space-between;
      padding: 7px 8px;
      border-bottom: 1px solid var(--line);
      font: 500 7.5px/1 var(--mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .nts-board-head b { color: var(--red); opacity: 0; }
    .nts[data-self='on'][data-step='4'] .nts-board-head b { animation: nts-ring 0.24s linear 5; opacity: 1; }
    .nts-note {
      position: absolute;
      top: 34px;
      left: 10px;
      right: 10px;
      display: grid;
      gap: 2px;
      padding: 8px 8px 7px;
      background: var(--accent);
      color: var(--art-bg);
      font: 500 9px/1.3 var(--mono);
      box-shadow: 2px 3px 0 color-mix(in srgb, var(--art-bg) 25%, transparent);
      opacity: 0;
      translate: -140px 90px;
      rotate: -20deg;
      scale: 0.5;
      transition: opacity 0.4s, translate 0.7s cubic-bezier(0.3, 1.3, 0.5, 1), rotate 0.7s, scale 0.7s;
    }
    .nts-note b { font: 400 18px/1 var(--serif); }
    .nts-note small { font-size: 7px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.75; }
    .nts-note em {
      position: absolute;
      top: 50%;
      left: 50%;
      padding: 2px 4px;
      border: 1.5px solid var(--red);
      background: var(--bg);
      color: var(--red);
      font: 700 8px/1 var(--mono);
      font-style: normal;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
      opacity: 0;
      translate: -50% -50%;
      rotate: -12deg;
    }
    .nts:is([data-step='3'], [data-step='4']) .nts-note { opacity: 1; translate: 0 0; rotate: 3deg; scale: 1; }
    .nts[data-self='on'][data-step='4'] .nts-note { animation: nts-ring 0.24s linear 5; }
    @keyframes nts-ring { 25% { rotate: -5deg; } 75% { rotate: 8deg; } }
    .nts[data-self='on']:is([data-step='5'], [data-step='6']) .nts-note { opacity: 0; translate: -160px 120px; rotate: -10deg; scale: 0.6; }
    /* Not allowed: stamped, then it drops off the board. */
    .nts[data-self='off']:is([data-step='3'], [data-step='4'], [data-step='5'], [data-step='6']) .nts-note em { opacity: 1; }
    .nts[data-self='off']:is([data-step='4'], [data-step='5'], [data-step='6']) .nts-note {
      opacity: 0;
      translate: 10px 140px;
      rotate: 40deg;
      scale: 1;
      transition: opacity 0.6s 0.3s, translate 0.9s cubic-bezier(0.5, 0, 0.8, 0.4), rotate 0.9s;
    }

    @media (max-width: 520px) {
      .nts-stage { grid-template-columns: 1fr; }
      .nts-board { order: -1; min-height: 96px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .nts-chat > li,
      .nts-note { transition: none; }
      .nts-note,
      .nts-board-head b { animation: none !important; }
    }
</style>
