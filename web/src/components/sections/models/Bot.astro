---
// A card's creature: a cousin of A-01 (components/Mascot.astro), drawn the
// brand mark's way: a red block on a hard amber one, a face on the front
// block. Each agent stands in its own pose and wears its own hat, tie or
// glasses (data/agentCards.ts, data/wear.ts), as it does in the backdrop.
// Static; the card makes it bob, blink and hop.
import logo from "../../../../../theme/logo.json";
import type { BotLook } from "../../../data/agentCards";

interface Props {
    look: BotLook;
    /** The block's short side, in [unit]s. */
    size: number;
    /** cqi: sized by its container, as on a card that scales. */
    unit?: "px" | "cqi";
    class?: string;
}
const { look, size, unit = "px", class: extra } = Astro.props;
const [, wide, , , tall] = logo.loader.poses;
const w = look.pose === "wide" ? wide.w : 1;
const h = look.pose === "tall" ? tall.h : 1;
const { hat, neck, glasses } = look.wear;
const offset =
    unit === "px" ? Math.max(logo.shadow.minAssetPx, Math.round(size * logo.shadow.ratio)) : Number((size * logo.shadow.ratio).toFixed(2));
---

<span
    class:list={["bot", extra]}
    style={`--b-s:${size}${unit};--b-o:${offset}${unit};--b-w:${w};--b-h:${h}`}
    data-eyes={look.eyes}
    data-swap={look.swap ? "" : undefined}
    data-hat={hat !== "none" ? hat : undefined}
    data-neck={neck !== "none" ? neck : undefined}
    data-glasses={glasses ? "" : undefined}
    aria-hidden="true"
>
    <i class="bot-ink bot-red"></i>
    <i class="bot-ink bot-amber"></i>
    <i class="bot-face"><i class="bot-eye"><b></b></i><i class="bot-eye"><b></b></i></i>
    {neck !== "none" && <i class="bot-neck"></i>}
    {hat !== "none" && <i class="bot-hat"></i>}
</span>

<style is:global>
    /* --bot-line: the hats' ink, light for the dark card art unless the
       bot stands on the page.
       The front block sits at the top left, its partner one offset down and
       right; a swap trades which colour is in front. The face is always on
       the front block. */
    .bot {
      position: relative;
      display: inline-block;
      flex: none;
      width: calc(var(--b-s) * var(--b-w) + var(--b-o));
      height: calc(var(--b-s) * var(--b-h) + var(--b-o));
    }
    .bot-ink,
    .bot-face {
      position: absolute;
      top: 0;
      left: 0;
      width: calc(var(--b-s) * var(--b-w));
      height: calc(var(--b-s) * var(--b-h));
    }
    .bot-red { z-index: 1; background: var(--red); }
    .bot-amber { z-index: 0; translate: var(--b-o) var(--b-o); background: var(--accent); }
    .bot[data-swap] .bot-red { z-index: 0; translate: var(--b-o) var(--b-o); }
    .bot[data-swap] .bot-amber { z-index: 1; translate: none; }
    .bot-face {
      z-index: 2;
      display: flex;
      justify-content: center;
      gap: calc(var(--b-s) * 0.08);
      padding-top: calc(var(--b-s) * 0.29);
    }
    .bot-eye {
      position: relative;
      width: calc(var(--b-s) * 0.25);
      height: calc(var(--b-s) * 0.29);
      background: var(--on-primary);
      transform-origin: 50% 100%;
    }
    .bot-eye b {
      position: absolute;
      top: 28%;
      left: 25%;
      width: 50%;
      height: 43%;
      background: var(--art-bg);
      transition: translate 0.2s;
    }
    .bot[data-eyes='look'] .bot-eye b { translate: 45% 0; }
    .bot[data-eyes='wide'] .bot-eye { height: calc(var(--b-s) * 0.36); }
    .bot[data-eyes='wide'] .bot-eye b { top: 36%; height: 30%; }
    .bot[data-eyes='sleepy'] .bot-eye { transform: scaleY(0.4); }
    /* What it wears (data/wear.ts), laid on the front block: --bot-line for
       hats, the screens' dark for ties and frames, as the pupils are. */
    .bot {
      --b-fw: calc(var(--b-s) * var(--b-w));
      --b-fh: calc(var(--b-s) * var(--b-h));
      --b-wear: var(--bot-line, var(--art-fg));
    }
    .bot-hat,
    .bot-neck {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 3;
      width: var(--b-fw);
      height: 0;
    }
    .bot-hat::before,
    .bot-hat::after,
    .bot-neck::before {
      content: '';
      position: absolute;
      background: var(--b-wear);
    }
    .bot[data-hat='antenna'] .bot-hat::before {
      top: calc(var(--b-s) * -0.32);
      left: calc(var(--b-fw) / 2);
      width: max(1px, calc(var(--b-s) * 0.04));
      height: calc(var(--b-s) * 0.32);
    }
    .bot[data-hat='antenna'] .bot-hat::after {
      top: calc(var(--b-s) * -0.42);
      left: calc(var(--b-fw) / 2);
      width: calc(var(--b-s) * 0.14);
      height: calc(var(--b-s) * 0.14);
      translate: -45% 0;
      background: var(--red);
    }
    /* A cap: the crown, and the visor out in front (the way its eyes look);
       turned round, the visor points behind. */
    .bot:is([data-hat='cap'], [data-hat='capBack']) .bot-hat::before {
      top: calc(var(--b-s) * -0.18);
      left: calc(var(--b-fw) * 0.04);
      width: calc(var(--b-fw) * 0.92);
      height: calc(var(--b-s) * 0.2);
      border-radius: calc(var(--b-s) * 0.1) calc(var(--b-s) * 0.1) 0 0;
    }
    .bot:is([data-hat='cap'], [data-hat='capBack']) .bot-hat::after {
      top: calc(var(--b-s) * -0.02);
      left: calc(var(--b-fw) * 0.6);
      width: calc(var(--b-fw) * 0.4 + var(--b-s) * 0.26);
      height: calc(var(--b-s) * 0.07);
    }
    .bot[data-hat='capBack'] .bot-hat::after { left: calc(var(--b-s) * -0.26); }
    /* A beanie, with a red pompom. */
    .bot[data-hat='beanie'] .bot-hat::before {
      top: calc(var(--b-s) * -0.3);
      left: calc(var(--b-fw) * 0.06);
      width: calc(var(--b-fw) * 0.88);
      height: calc(var(--b-s) * 0.34);
      border-radius: 50% 50% 0 0 / 90% 90% 0 0;
    }
    .bot[data-hat='beanie'] .bot-hat::after {
      top: calc(var(--b-s) * -0.42);
      left: calc(var(--b-fw) / 2 - var(--b-s) * 0.08);
      width: calc(var(--b-s) * 0.16);
      height: calc(var(--b-s) * 0.16);
      border-radius: 50%;
      background: var(--red);
    }
    /* A top hat: its crown with a red band, on a brim. */
    .bot[data-hat='tophat'] .bot-hat::before {
      top: calc(var(--b-s) * -0.56);
      left: calc(var(--b-fw) / 2 - var(--b-s) * 0.3);
      width: calc(var(--b-s) * 0.6);
      height: calc(var(--b-s) * 0.52);
      box-shadow: inset 0 calc(var(--b-s) * -0.09) 0 var(--red);
    }
    .bot[data-hat='tophat'] .bot-hat::after {
      top: calc(var(--b-s) * -0.07);
      left: calc(var(--b-fw) / 2 - var(--b-s) * 0.48);
      width: calc(var(--b-s) * 0.96);
      height: calc(var(--b-s) * 0.08);
    }
    /* Headphones: the band over the top, a cup each side. */
    .bot[data-hat='headphones'] .bot-hat::before {
      box-sizing: border-box;
      top: calc(var(--b-s) * -0.16);
      left: calc(var(--b-s) * -0.06);
      width: calc(var(--b-fw) + var(--b-s) * 0.12);
      height: calc(var(--b-s) * 0.5);
      border: max(1px, calc(var(--b-s) * 0.06)) solid var(--b-wear);
      border-bottom: none;
      border-radius: calc(var(--b-s) * 0.4) calc(var(--b-s) * 0.4) 0 0;
      background: none;
    }
    .bot[data-hat='headphones'] .bot-hat::after {
      top: calc(var(--b-s) * 0.14);
      left: calc(var(--b-s) * -0.12);
      width: calc(var(--b-s) * 0.14);
      height: calc(var(--b-s) * 0.3);
      box-shadow: calc(var(--b-fw) + var(--b-s) * 0.1) 0 0 var(--b-wear);
    }
    /* A tuft of hair. */
    .bot[data-hat='tuft'] .bot-hat::before {
      top: calc(var(--b-s) * -0.26);
      left: calc(var(--b-fw) / 2 - var(--b-s) * 0.22);
      width: calc(var(--b-s) * 0.44);
      height: calc(var(--b-s) * 0.27);
      clip-path: polygon(0 100%, 12% 15%, 32% 72%, 50% 0, 68% 72%, 88% 15%, 100% 100%);
    }
    /* A tie, its knot under the eyes and its blade down the front; a bow tie. */
    .bot[data-neck='tie'] .bot-neck::before {
      top: calc(var(--b-s) * 0.64);
      left: calc(var(--b-fw) / 2 - var(--b-s) * 0.09);
      width: calc(var(--b-s) * 0.18);
      height: calc(var(--b-fh) - var(--b-s) * 0.68);
      background: var(--art-bg);
      clip-path: polygon(28% 0, 72% 0, 62% 16%, 100% 82%, 50% 100%, 0 82%, 38% 16%);
    }
    .bot[data-neck='bowtie'] .bot-neck::before {
      top: calc(var(--b-s) * 0.66);
      left: calc(var(--b-fw) / 2 - var(--b-s) * 0.22);
      width: calc(var(--b-s) * 0.44);
      height: calc(var(--b-s) * 0.22);
      background: var(--art-bg);
      clip-path: polygon(0 0, 50% 38%, 100% 0, 100% 100%, 50% 62%, 0 100%);
    }
    /* Glasses: a frame round each eye and a bridge between. */
    .bot[data-glasses] .bot-eye {
      outline: max(1px, calc(var(--b-s) * 0.05)) solid var(--art-bg);
      outline-offset: calc(var(--b-s) * 0.03);
    }
    .bot[data-glasses] .bot-face::after {
      content: '';
      position: absolute;
      top: calc(var(--b-s) * 0.4);
      left: calc(var(--b-fw) / 2 - var(--b-s) * 0.07);
      width: calc(var(--b-s) * 0.14);
      height: max(1px, calc(var(--b-s) * 0.05));
      background: var(--art-bg);
    }
</style>
