---
import { encode } from "uqr";
import Slate from "../Slate.astro";
import LogoLoader from "../LogoLoader.astro";
import { dlUrl, site } from "../../data/site";

// The plate's code is real: the starter's download route on `site` from
// astro.config.mjs (absolute, since a phone scans it), so a visitor on a computer can scan the
// download onto the phone. Encoded at build time, so the page ships one SVG
// path and no script. Each run of dark modules in a row is one rectangle;
// the 4-module border is the spec's quiet zone.
const qr = encode(new URL(dlUrl("lite"), Astro.site).href, { ecc: "M", border: 4 });
const qrPath = qr.data
    .map((row, y) => {
        let d = "";
        for (let x = 0; x < row.length; x++) {
            if (!row[x]) continue;
            const start = x;
            while (row[x + 1]) x++;
            const run = x - start + 1;
            d += `M${start} ${y}h${run}v1h-${run}z`;
        }
        return d;
    })
    .join("");

// The computer install, per OS, as three separate commands: download, check
// the file against the SHA-256 pinned here, install. Two spaces before the
// file name is the checksum-line format.
const apk = site.fullApkFile;
const pcScripts = [
    {
        os: "linux",
        label: "Linux",
        lines: [
            `curl -LO ${site.fullApk}`,
            `echo "${site.fullSha256}  ${apk}" | sha256sum -c`,
            `adb install -r ${apk}`,
        ],
    },
    {
        // shasum ships with every macOS; sha256sum only since 15.
        os: "macos",
        label: "macOS",
        lines: [
            `curl -LO ${site.fullApk}`,
            `echo "${site.fullSha256}  ${apk}" | shasum -a 256 -c`,
            `adb install -r ${apk}`,
        ],
    },
    {
        // PowerShell: curl.exe, because plain `curl` there is
        // Invoke-WebRequest; -eq ignores the case of Get-FileHash's hex.
        os: "windows",
        label: "Windows",
        powershell: true,
        lines: [
            `curl.exe -LO ${site.fullApk}`,
            `(Get-FileHash ${apk} -Algorithm SHA256).Hash -eq "${site.fullSha256}"`,
            `adb install -r ${apk}`,
        ],
    },
];
---

<section class="section" id="install">
    <div class="sec-head">
        <div class="sec-rail">
            <p class="kicker">Sec. 04 / Install</p>
            <p class="fig-label">FIG. 06 — Procedure</p>
        </div>
        <div class="sec-body">
            <h2>Get it on the phone.</h2>
            <p class="lead">
                Two installs and a switch, all on the phone. No store,
                no account. Bring <em>2 GB free</em> and one coffee for
                the first launch.
            </p>
        </div>
    </div>

    <div class="install">
        <div class="install-spec">
            <div class="install-head">
                <p class="install-kicker">Data plate / A-01</p>
                <span class="stamp">Sideload</span>
            </div>
            <dl class="rows">
                <div>
                    <dt>Version</dt>
                    <dd>v{site.version} · alpha</dd>
                </div>
                <div>
                    <dt>Released</dt>
                    <dd>{site.released}</dd>
                </div>
                <div>
                    <dt>Architecture</dt>
                    <dd>{site.arch} only</dd>
                </div>
                <div>
                    <dt>Requires</dt>
                    <dd>Android {site.minAndroid} · 2 GB free</dd>
                </div>
                <div>
                    <dt>Download</dt>
                    <dd>{site.size} · starter build</dd>
                </div>
                <div>
                    <dt>SHA-256</dt>
                    <dd class="dim">{site.sha256}</dd>
                </div>
                <div>
                    <dt>License</dt>
                    <dd>{site.license}</dd>
                </div>
            </dl>
            <!-- A phone can't scan its own screen: it keeps the printed
                 barcode, a computer gets the code. -->
            <div class="barcode install-phone-only" aria-hidden="true"></div>
            <div class="install-qr install-pc-only">
                <svg
                    viewBox={`0 0 ${qr.size} ${qr.size}`}
                    shape-rendering="crispEdges"
                    role="img"
                    aria-label={`QR code for the starter APK, v${site.version}`}
                >
                    <path d={qrPath} />
                </svg>
                <p class="install-qr-cap">
                    <b>Scan with the phone</b>
                    Gets the starter: step 01
                </p>
            </div>
            <p class="serial">
                FM-01 · A-01 · v{site.version} · {site.arch}
            </p>
        </div>

        <div class="install-steps">
            <!-- Computer: full APK first (adb skips Play Protect). Phone:
                 the full button hides and the starter becomes primary.
                 Both go through the Worker's /dl route, which counts the
                 download and redirects to the GitHub asset. -->
            <a class="btn btn-primary install-full" href={dlUrl("full")}>
                Full APK for adb · v{site.version}
            </a>
            <a class="btn btn-ghost install-starter" href={dlUrl("lite")}>
                Starter APK for the phone · v{site.version}
            </a>
            <ol class="steps">
                <li>
                    <span>
                        <b>Grab the starter.</b> Open it, tap Install.
                        No superpowers yet, so Play Protect lets it in.
                        First launch unpacks the brain: one coffee.
                    </span>
                </li>
                <li>
                    <span>
                        <b>Give it hands.</b> Tap{" "}
                        <em>Install full build</em> in the app and let
                        PhoneCanDo install it. It moves in over the
                        starter and keeps your stuff.
                    </span>
                </li>
                <li>
                    <span>
                        <b>Flip the switch.</b> Settings → Phone control
                        walks you through Android's safety lock in
                        three taps. Your fingerprint stays the final
                        key.
                    </span>
                </li>
            </ol>
            <p class="note">
                Why two installs? Play Protect blocks any browser
                download that can drive the screen. The starter
                can't, so it gets in, then fetches the full build
                itself, which Android allows. Silly. Tested. Works.
            </p>
            <!-- Linux shows until the script picks the visitor's OS. -->
            <div class="install-pc install-pc-only" data-os-picker>
                <div class="install-pc-head">
                    <p class="note">On a computer? Skip the dance:</p>
                    <div class="os-tabs" role="group" aria-label="Your computer">
                        {pcScripts.map(({ os, label }) => (
                            <button class="os-tab" type="button" data-os={os} aria-pressed={os === "linux" ? "true" : "false"}>
                                {label}
                            </button>
                        ))}
                    </div>
                </div>
                {pcScripts.map(({ os, label, lines, powershell }) => (
                    <div class="cmd-wrap" data-os-panel={os} hidden={os !== "linux"}>
                        <p class:list={["cmd", "cmd-lines", { "cmd-ps": powershell }]} data-cmd>
                            {lines.map((line) => <span>{line}</span>)}
                        </p>
                        <button class="cmd-copy" type="button" data-copy aria-label={`Copy the ${label} commands`}>
                            Copy
                        </button>
                    </div>
                ))}
            </div>
        </div>

        <div class="install-media">
            <!-- Real screen recording of the three steps, never a mock. -->
            <div class="install-frame" data-media>
                {site.install.video ? (
                    <video
                        src={site.install.video}
                        poster={site.install.poster}
                        autoplay
                        muted
                        loop
                        playsinline
                        aria-label="Installing PhoneCanDo: starter, full build, accessibility switch"
                    />
                ) : (
                    <Slate slot="04" label="Install walkthrough · recording" />
                )}
                {site.install.video ? (
                    <div class="media-loader">
                        <LogoLoader size={26} />
                    </div>
                ) : null}
            </div>
            <p class="install-media-cap">
                Starter → full → switch · 0:40
            </p>
        </div>
    </div>
    <span class="ticks-bottom" aria-hidden="true"></span>
</section>

<script>
    // The computer commands open on the visitor's OS, guessed from the
    // browser; the tabs switch it.
    const picker = document.querySelector<HTMLElement>("[data-os-picker]");
    if (picker) {
        const show = (os: string) => {
            for (const tab of picker.querySelectorAll<HTMLElement>("[data-os]")) {
                tab.setAttribute("aria-pressed", String(tab.dataset.os === os));
            }
            for (const panel of picker.querySelectorAll<HTMLElement>("[data-os-panel]")) {
                panel.hidden = panel.dataset.osPanel !== os;
            }
        };
        const { userAgentData } = navigator as Navigator & { userAgentData?: { platform: string } };
        const platform = userAgentData?.platform || navigator.userAgent;
        // Case-sensitive /Win/, so "Darwin" doesn't read as Windows.
        show(/mac/i.test(platform) ? "macos" : /Win/.test(platform) ? "windows" : "linux");
        picker.addEventListener("click", (event) => {
            const tab = (event.target as Element).closest<HTMLElement>("[data-os]");
            if (tab?.dataset.os) show(tab.dataset.os);
        });
    }

    // Copies the commands, one per line and without the prompts, then says
    // so on the button for a moment.
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        button.addEventListener("click", async () => {
            const box = button.parentElement?.querySelector("[data-cmd]");
            if (!box) return;
            const text = Array.from(box.querySelectorAll("span"))
                .map((line) => line.textContent?.trim() ?? "")
                .join("\n");
            try {
                await navigator.clipboard.writeText(text);
            } catch {
                // No clipboard API (insecure context, old browser): select
                // the lines so a manual copy picks them up.
                const range = document.createRange();
                range.selectNodeContents(box);
                const selection = window.getSelection();
                selection?.removeAllRanges();
                selection?.addRange(range);
                return;
            }
            button.textContent = "Copied";
            window.setTimeout(() => (button.textContent = "Copy"), 1500);
        });
    }
</script>

<style is:global>
    .install {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr) minmax(0, 0.8fr);
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: 0;
      overflow: hidden;
    }
    .install > div { background: var(--bg); padding: clamp(22px, 3vw, 34px); }
    .install-spec { position: relative; }
    .install-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }
    .install-kicker {
      font: 500 8.5px/1.4 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent-ink);
    }
    .rows { margin: 0; }
    .rows div {
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      gap: 16px;
      padding: 11px 0;
      border-top: 1px solid var(--line);
    }
    .rows div:first-child { border-top: 0; padding-top: 0; }
    .rows dt {
      font: 500 10px/1.4 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .rows dd { margin: 0; font: 400 12px/1.5 var(--mono); color: var(--fg); overflow-wrap: anywhere; }
    .rows dd.dim { color: var(--dim); }
    .install .btn { width: 100%; margin-bottom: 22px; }
    .install .btn.install-starter { margin-top: -12px; }
    .install .install-phone-only { display: none; }
    /* Phones only get the starter, as the primary button; the full APK is for
       adb from a computer. */
    @media (hover: none) and (pointer: coarse) {
      .install .install-full,
      .install .install-pc-only { display: none; }
      .install .install-phone-only { display: block; }
      .install .btn.install-starter {
        margin-top: 0;
        background: var(--red);
        border-color: var(--red);
        color: var(--on-primary);
      }
      .install .btn.install-starter:hover { background: var(--red-hi); border-color: var(--red-hi); }
    }
    .steps li em { font-style: normal; color: var(--fg); font-weight: 500; }
    .install-media {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      background: var(--art-bg);
    }
    .install-frame {
      position: relative;
      height: 420px;
      aspect-ratio: 9 / 19.5;
      max-width: 100%;
      border: 1px solid rgba(255, 255, 255, 0.1);
      overflow: hidden;
      background: var(--art-bg);
    }
    .install-frame video { width: 100%; height: 100%; object-fit: cover; }
    .install-media-cap {
      font: 500 8px/1.4 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-align: center;
      color: var(--art-dim);
    }
    .steps { margin: 0; padding: 0; list-style: none; counter-reset: s; }
    .steps li {
      counter-increment: s;
      display: grid;
      grid-template-columns: 20px minmax(0, 1fr);
      gap: 12px;
      padding: 12px 0;
      border-top: 1px solid var(--line);
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--muted);
    }
    .steps li:first-child { border-top: 0; padding-top: 0; }
    .steps li::before {
      content: counter(s, decimal-leading-zero);
      width: 18px;
      height: 18px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line-2);
      font: 500 8px/1 var(--mono);
      color: var(--accent-ink);
    }
    .steps b { color: var(--fg); font-weight: 500; }
    .cmd {
      margin-top: 14px;
      padding: 11px 13px;
      border: 1px solid var(--line);
      border-radius: 0;
      background: var(--panel-2);
      font: 400 11px/1.6 var(--mono);
      color: var(--muted);
      user-select: all;
      overflow-x: auto;
      white-space: nowrap;
    }
    .cmd::before { content: '$ '; color: var(--red); }
    /* Several commands in one box: one per line, each with its own prompt. A long
       line scrolls under the site scrollbar. */
    .cmd.cmd-lines::before { content: none; }
    /* pre: a checksum line's two spaces survive on screen and in a manual copy. */
    .cmd.cmd-lines span { display: block; white-space: pre; }
    .cmd.cmd-lines span::before { content: '$ '; color: var(--red); }
    .cmd.cmd-ps span::before { content: 'PS> '; }
    /* The copy button sits outside the scrolling box, so it stays put in the top
       right while a long line scrolls under it. */
    .cmd-wrap { position: relative; margin-top: 14px; }
    .cmd-wrap .cmd { margin-top: 0; padding-right: 64px; }
    .cmd-copy {
      position: absolute;
      top: 6px;
      right: 6px;
      padding: 5px 8px;
      border: 1px solid var(--line);
      border-radius: 0;
      background: var(--panel);
      font: 500 9px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      cursor: pointer;
    }
    .cmd-copy:hover { color: var(--fg); border-color: var(--fg); }
    /* Computer install: the note and the OS tabs on one row, then the box for
       the picked OS. */
    .install-pc-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px 12px;
      margin-top: 14px;
    }
    .install-pc-head .note { margin-top: 0; }
    .install-pc .cmd-wrap { margin-top: 10px; }
    .os-tabs { display: flex; }
    .os-tab {
      padding: 5px 8px;
      border: 1px solid var(--line);
      border-radius: 0;
      background: transparent;
      font: 500 9px/1 var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
      cursor: pointer;
    }
    .os-tab + .os-tab { margin-left: -1px; }
    .os-tab:hover { color: var(--fg); }
    .os-tab[aria-pressed='true'] {
      position: relative;
      border-color: var(--line-2);
      background: var(--panel-2);
      color: var(--fg);
    }
    .note {
      margin-top: 14px;
      font: 400 10px/1.7 var(--mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--faint);
    }
    /* The plate's code on a computer: the QR, with what scanning it does. On
       the command box's panel, edged like it; the dots' ink is per theme
       (--qr-ink, styles/base.css). */
    .install-qr {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      margin-top: 26px;
    }
    .install-qr svg {
      flex: none;
      width: 120px;
      height: 120px;
      border: 1px solid var(--line);
      background: var(--panel-2);
      fill: var(--qr-ink);
    }
    .install-qr-cap {
      margin: 0;
      font: 400 10px/1.7 var(--mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-wrap: balance;
      color: var(--faint);
    }
    .install-qr-cap b { display: block; font-weight: 500; color: var(--fg); }

    @media (max-width: 1180px) {
      .install { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
      .install-media { grid-column: 1 / -1; }
    }
    @media (max-width: 980px) {
      .install { grid-template-columns: minmax(0, 1fr); }
      .install-media { grid-column: auto; }
      /* One column: the button and steps first and the data plate last, so the
         nav's Download APK lands on a button, not a spec sheet. */
      .install-steps { order: -1; }
      .install-spec { order: 1; }
    }
    @media (max-width: 760px) {
      .rows div { grid-template-columns: 104px minmax(0, 1fr); }
    }
</style>
