---
import { encode } from "uqr";
import Slate from "../Slate.astro";
import LogoLoader from "../LogoLoader.astro";
import { site } from "../../data/site";

// The plate's code is real: the starter APK's URL, so a visitor on a
// computer can scan the download onto the phone. Encoded at build time, so
// the page ships one SVG path and no script. Each run of dark modules in a
// row is one rectangle; the 4-module border is the spec's quiet zone.
const qr = encode(site.apk, { ecc: "M", border: 4 });
const qrPath = qr.data
    .map((row, y) => {
        let d = "";
        for (let x = 0; x < row.length; x++) {
            if (!row[x]) continue;
            const start = x;
            while (row[x + 1]) x++;
            const run = x - start + 1;
            d += `M${start} ${y}h${run}v1h-${run}z`;
        }
        return d;
    })
    .join("");

// The computer install, per OS, as three separate commands: download, check
// the file against the SHA-256 pinned here, install. Two spaces before the
// file name is the checksum-line format.
const apk = site.fullApkFile;
const pcScripts = [
    {
        os: "linux",
        label: "Linux",
        lines: [
            `curl -LO ${site.fullApk}`,
            `echo "${site.fullSha256}  ${apk}" | sha256sum -c`,
            `adb install -r ${apk}`,
        ],
    },
    {
        // shasum ships with every macOS; sha256sum only since 15.
        os: "macos",
        label: "macOS",
        lines: [
            `curl -LO ${site.fullApk}`,
            `echo "${site.fullSha256}  ${apk}" | shasum -a 256 -c`,
            `adb install -r ${apk}`,
        ],
    },
    {
        // PowerShell: curl.exe, because plain `curl` there is
        // Invoke-WebRequest; -eq ignores the case of Get-FileHash's hex.
        os: "windows",
        label: "Windows",
        powershell: true,
        lines: [
            `curl.exe -LO ${site.fullApk}`,
            `(Get-FileHash ${apk} -Algorithm SHA256).Hash -eq "${site.fullSha256}"`,
            `adb install -r ${apk}`,
        ],
    },
];
---

<section class="section" id="install">
    <div class="sec-head">
        <div class="sec-rail">
            <p class="kicker">Sec. 04 / Install</p>
            <p class="fig-label">FIG. 06 — Procedure</p>
        </div>
        <div class="sec-body">
            <h2>Get it on the phone.</h2>
            <p class="lead">
                Two installs and a switch, all on the phone. No store,
                no account. Bring <em>2 GB free</em> and one coffee for
                the first launch.
            </p>
        </div>
    </div>

    <div class="install">
        <div class="install-spec">
            <div class="install-head">
                <p class="install-kicker">Data plate / A-01</p>
                <span class="stamp">Sideload</span>
            </div>
            <dl class="rows">
                <div>
                    <dt>Version</dt>
                    <dd>v{site.version} · alpha</dd>
                </div>
                <div>
                    <dt>Released</dt>
                    <dd>{site.released}</dd>
                </div>
                <div>
                    <dt>Architecture</dt>
                    <dd>{site.arch} only</dd>
                </div>
                <div>
                    <dt>Requires</dt>
                    <dd>Android {site.minAndroid} · 2 GB free</dd>
                </div>
                <div>
                    <dt>Download</dt>
                    <dd>{site.size} · starter build</dd>
                </div>
                <div>
                    <dt>SHA-256</dt>
                    <dd class="dim">{site.sha256}</dd>
                </div>
                <div>
                    <dt>License</dt>
                    <dd>{site.license}</dd>
                </div>
            </dl>
            <!-- A phone can't scan its own screen: it keeps the printed
                 barcode, a computer gets the code. -->
            <div class="barcode install-phone-only" aria-hidden="true"></div>
            <div class="install-qr install-pc-only">
                <svg
                    viewBox={`0 0 ${qr.size} ${qr.size}`}
                    shape-rendering="crispEdges"
                    role="img"
                    aria-label={`QR code for the starter APK, v${site.version}`}
                >
                    <path d={qrPath} />
                </svg>
                <p class="install-qr-cap">
                    <b>Scan with the phone</b>
                    Gets the starter: step 01
                </p>
            </div>
            <p class="serial">
                FM-01 · A-01 · v{site.version} · {site.arch}
            </p>
        </div>

        <div class="install-steps">
            <!-- Computer: full APK first (adb skips Play Protect). Phone:
                 the full button hides and the starter becomes primary. -->
            <a class="btn btn-primary install-full" href={site.fullApk}>
                Full APK for adb · v{site.version}
            </a>
            <a class="btn btn-ghost install-starter" href={site.apk}>
                Starter APK for the phone · v{site.version}
            </a>
            <ol class="steps">
                <li>
                    <span>
                        <b>Grab the starter.</b> Open it, tap Install.
                        No superpowers yet, so Play Protect lets it in.
                        First launch unpacks the brain: one coffee.
                    </span>
                </li>
                <li>
                    <span>
                        <b>Give it hands.</b> Tap{" "}
                        <em>Install full build</em> in the app and let
                        PhoneCanDo install it. It moves in over the
                        starter and keeps your stuff.
                    </span>
                </li>
                <li>
                    <span>
                        <b>Flip the switch.</b> Settings → Phone control
                        walks you through Android's safety lock in
                        three taps. Your fingerprint stays the final
                        key.
                    </span>
                </li>
            </ol>
            <p class="note">
                Why two installs? Play Protect blocks any browser
                download that can drive the screen. The starter
                can't, so it gets in, then fetches the full build
                itself, which Android allows. Silly. Tested. Works.
            </p>
            <!-- Linux shows until the script picks the visitor's OS. -->
            <div class="install-pc install-pc-only" data-os-picker>
                <div class="install-pc-head">
                    <p class="note">On a computer? Skip the dance:</p>
                    <div class="os-tabs" role="group" aria-label="Your computer">
                        {pcScripts.map(({ os, label }) => (
                            <button class="os-tab" type="button" data-os={os} aria-pressed={String(os === "linux")}>
                                {label}
                            </button>
                        ))}
                    </div>
                </div>
                {pcScripts.map(({ os, label, lines, powershell }) => (
                    <div class="cmd-wrap" data-os-panel={os} hidden={os !== "linux"}>
                        <p class:list={["cmd", "cmd-lines", { "cmd-ps": powershell }]} data-cmd>
                            {lines.map((line) => <span>{line}</span>)}
                        </p>
                        <button class="cmd-copy" type="button" data-copy aria-label={`Copy the ${label} commands`}>
                            Copy
                        </button>
                    </div>
                ))}
            </div>
        </div>

        <div class="install-media">
            <!-- Real screen recording of the three steps, never a mock. -->
            <div class="install-frame" data-media>
                {site.install.video ? (
                    <video
                        src={site.install.video}
                        poster={site.install.poster}
                        autoplay
                        muted
                        loop
                        playsinline
                        aria-label="Installing PhoneCanDo: starter, full build, accessibility switch"
                    />
                ) : (
                    <Slate slot="04" label="Install walkthrough · recording" />
                )}
                {site.install.video ? (
                    <div class="media-loader">
                        <LogoLoader size={26} />
                    </div>
                ) : null}
            </div>
            <p class="install-media-cap">
                Starter → full → switch · 0:40
            </p>
        </div>
    </div>
    <span class="ticks-bottom" aria-hidden="true"></span>
</section>

<script>
    // The computer commands open on the visitor's OS, guessed from the
    // browser; the tabs switch it.
    const picker = document.querySelector<HTMLElement>("[data-os-picker]");
    if (picker) {
        const show = (os: string) => {
            for (const tab of picker.querySelectorAll<HTMLElement>("[data-os]")) {
                tab.setAttribute("aria-pressed", String(tab.dataset.os === os));
            }
            for (const panel of picker.querySelectorAll<HTMLElement>("[data-os-panel]")) {
                panel.hidden = panel.dataset.osPanel !== os;
            }
        };
        const { userAgentData } = navigator as Navigator & { userAgentData?: { platform: string } };
        const platform = userAgentData?.platform || navigator.userAgent;
        // Case-sensitive /Win/, so "Darwin" doesn't read as Windows.
        show(/mac/i.test(platform) ? "macos" : /Win/.test(platform) ? "windows" : "linux");
        picker.addEventListener("click", (event) => {
            const tab = (event.target as Element).closest<HTMLElement>("[data-os]");
            if (tab?.dataset.os) show(tab.dataset.os);
        });
    }

    // Copies the commands, one per line and without the prompts, then says
    // so on the button for a moment.
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        button.addEventListener("click", async () => {
            const box = button.parentElement?.querySelector("[data-cmd]");
            if (!box) return;
            const text = Array.from(box.querySelectorAll("span"))
                .map((line) => line.textContent?.trim() ?? "")
                .join("\n");
            try {
                await navigator.clipboard.writeText(text);
            } catch {
                // No clipboard API (insecure context, old browser): select
                // the lines so a manual copy picks them up.
                const range = document.createRange();
                range.selectNodeContents(box);
                const selection = window.getSelection();
                selection?.removeAllRanges();
                selection?.addRange(range);
                return;
            }
            button.textContent = "Copied";
            window.setTimeout(() => (button.textContent = "Copy"), 1500);
        });
    }
</script>
