---
import Booster from "./models/Booster.astro";
import { agentsClaim, cards } from "../../data/agentCards";

const localKinds = cards.filter((c) => c.local).length;
---

<section class="section models" id="models">
    <div class="sec-head">
        <div class="sec-rail">
            <p class="kicker">Sec. 02 / Agents &amp; models</p>
            <p class="fig-label">FIG. 03 — Booster pack</p>
        </div>
        <div class="sec-body">
            <h2>Collect your crew. Pick its brain.</h2>
            <p class="lead">
                Choose from {agentsClaim} coding agents — opencode, Claude
                Code, Codex, Gemini CLI and more — each in a machine of its
                own, three at a time. Each signs in to its own provider, or
                runs on a model right on the phone:{" "}
                <em>the prompt never leaves the device.</em>
            </p>
        </div>
    </div>

    <Booster />

    <dl class="house-rules">
        <div>
            <dt>Agents</dt>
            <dd><b>{agentsClaim}</b> kinds to pick from. opencode comes built in; the rest install into their machine. Or add your own.</dd>
        </div>
        <div>
            <dt>At once</dt>
            <dd><b>3</b> agents run together. A fourth takes the seat of one that has sat idle a minute.</dd>
        </div>
        <div>
            <dt>On the phone</dt>
            <dd><b>1</b> model loaded at a time, shared by every agent on it.</dd>
        </div>
        <div>
            <dt>RAM</dt>
            <dd><b>6 GB</b> to run a model, 8 GB to run it well. The app checks the fit before you download.</dd>
        </div>
    </dl>

    <p class="model-foot">
        {localKinds} of them take a local model ·
        opencode is stable, the others are previews · weights from Hugging
        Face or a GGUF file on the phone
    </p>
</section>

<style is:global>
    /* The operator's card: the board's house rules, one numbered cell each. */
    .house-rules {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin: 30px 0 0;
      border: 1px solid var(--line);
      background: var(--bg);
    }
    .house-rules div {
      padding: 16px 18px 18px;
      border-left: 1px dashed var(--line-2);
    }
    .house-rules div:first-child { border-left: 0; }
    .house-rules dt {
      display: flex;
      align-items: center;
      gap: 6px;
      font: 500 8.5px/1.4 var(--mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .house-rules dt::before {
      content: '';
      width: 4px;
      height: 4px;
      flex: none;
      background: var(--accent);
    }
    .house-rules dd {
      margin: 8px 0 0;
      font-size: 13px;
      line-height: 1.55;
      color: var(--muted);
    }
    .house-rules b {
      display: block;
      margin-bottom: 4px;
      font: 400 44px/0.9 var(--serif);
      letter-spacing: -0.02em;
      color: var(--fg);
    }
    .house-rules div:nth-child(2) b { color: var(--red); }
    .model-foot {
      margin-top: 14px;
      font: 400 9px/1.6 var(--mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--faint);
    }

    @media (max-width: 860px) {
      .house-rules { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .house-rules div:nth-child(3) { border-left: 0; }
      .house-rules div:nth-child(n + 3) { border-top: 1px dashed var(--line-2); }
    }
    @media (max-width: 340px) {
      .house-rules { grid-template-columns: 1fr; }
      .house-rules div { border-left: 0; }
      .house-rules div + div { border-top: 1px dashed var(--line-2); }
    }
</style>
