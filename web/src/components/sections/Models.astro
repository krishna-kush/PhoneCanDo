<section class="section models" id="models">
    <div class="sec-head">
        <div class="sec-rail">
            <p class="kicker">Sec. 02 / Local intelligence</p>
            <p class="fig-label">FIG. 03 — Model manifest</p>
        </div>
        <div class="sec-body">
            <h2>The model is in the room.</h2>
            <p class="lead">
                Bring your own model, or download one from our
                registry inside the app and run it with ease. The
                model sits in app-private storage, the runtime does
                the work on the phone, and{" "}
                <em>no request has to leave the device.</em>
            </p>
        </div>
    </div>

    <div class="model-freight">
        <span class="stamp freight-stamp">In development</span>
        <div class="freight-head">
            <p class="freight-kicker">Two routes / one room</p>
        </div>

        <div class="freight-body">
            <div class="freight-route route-left">
                <p class="route-no">Route 01</p>
                <h3>Carry it in.</h3>
                <p>
                    Point PhoneCanDo at weights you already have.
                    They move into app storage and stay there.
                </p>
                <p class="route-note">~/models → app storage</p>
            </div>

            <span class="freight-arrow arrow-in" aria-hidden="true"></span>

            <div class="crate" aria-hidden="true">
                <span class="crate-tape">
                    <span>PhoneCanDo</span>
                    <span>Model</span>
                </span>
                <div class="crate-label">
                    <p class="crate-label-head">
                        <span>Packing list</span>
                        <span>1 of 1</span>
                    </p>
                    <ul class="crate-list">
                        <li>weights.gguf</li>
                        <li>tokenizer.json</li>
                        <li>config.json</li>
                    </ul>
                    <div class="crate-barcode"></div>
                </div>
                <span class="crate-stamp">Stays on device</span>
                <span class="crate-up">
                    <b aria-hidden="true">↑↑</b> this side up
                </span>
            </div>

            <span class="freight-arrow arrow-out" aria-hidden="true"></span>

            <div class="freight-route route-right">
                <p class="route-no">Route 02</p>
                <h3>Have it delivered.</h3>
                <p>
                    Pick a model in the registry and download it
                    inside the app. No computer, no side-loading.
                </p>
                <p class="route-note">registry → app storage</p>
            </div>
        </div>

        <div class="freight-foot">
            <p><span>Destination</span> / app-private storage</p>
            <p class="freight-checks">
                ✓ no upload · ✓ no account · ✓ no PC
            </p>
        </div>
    </div>

    <p class="model-foot">
        Support depends on RAM, quantization and the runtime.
    </p>
</section>
