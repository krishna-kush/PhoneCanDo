---
import DemoCard from "../DemoCard.astro";
import { demos } from "../../data/demos";
---

<section class="section" id="demos">
    <div class="sec-head">
        <div class="sec-rail">
            <p class="kicker">Sec. 01 / Phone control demo</p>
            <p class="fig-label">FIG. 02 — Plates 01–08</p>
        </div>
        <div class="sec-body">
            <h2 class="slogan">
                Just Ask, <span>phonecando</span>
            </h2>
            <p class="lead">
                Every clip is a real screen recording: the agent sees the UI,
                taps, types, shares and reads the clipboard. Anything with a
                screen is fair game —
                <em>once you unlock phone control.</em>
            </p>
        </div>
    </div>

    <div class="demos">
        {demos.map((demo, i) => (
            <DemoCard demo={demo} index={i} />
        ))}
    </div>
    <p class="swipe-hint" aria-hidden="true">
        Swipe through the demos →
    </p>
    <span class="ticks-bottom" aria-hidden="true"></span>
</section>
