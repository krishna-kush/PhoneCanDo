---
import DemoCard from "../DemoCard.astro";
import { demos } from "../../data/demos";
---

<section class="section" id="demos">
    <div class="sec-head">
        <div class="sec-rail">
            <p class="kicker">Sec. 01 / Phone control demo</p>
            <p class="fig-label">FIG. 02 — Plates 01–08</p>
        </div>
        <div class="sec-body">
            <h2 class="slogan">
                Just Ask, <span>phonecando</span>
            </h2>
            <p class="lead">
                Every clip is a real screen recording: the agent sees the UI,
                taps, types, shares and reads the clipboard. Anything with a
                screen is fair game —
                <em>once you unlock phone control.</em>
            </p>
        </div>
    </div>

    <div class="demos">
        {demos.map((demo, i) => (
            <DemoCard demo={demo} index={i} />
        ))}
    </div>
    <p class="swipe-hint" aria-hidden="true">
        Swipe through the demos →
    </p>
    <span class="ticks-bottom" aria-hidden="true"></span>
</section>

<style is:global>
    /* Demos heading doubles as the slogan: heading scale, red italic, marker on the wordmark. */
    .sec-head h2.slogan {
      font-style: italic;
      color: var(--red);
    }
    .sec-head .slogan span {
      position: relative;
      isolation: isolate;
      padding: 0.02em 0.2em;
      color: var(--on-primary);
    }
    /* The marker is a hand-swiped stroke: leaning, tapered, and a little over the word. */
    .sec-head .slogan span::before {
      content: '';
      position: absolute;
      inset: -0.04em -0.22em;
      z-index: -1;
      background: var(--red);
      clip-path: polygon(3% 14%, 100% 0, 97% 84%, 0 100%);
    }

    /* demo gallery: plates */
    .demos {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: 0;
      overflow: hidden;
    }
    .swipe-hint { display: none; }

    @media (max-width: 760px) {
      .demos {
        display: flex;
        gap: 10px;
        grid-template-columns: none;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        background: none;
        border: 0;
        border-radius: 0;
        margin-inline: calc(-1 * var(--pad));
        padding: 0 var(--pad) 6px;
      }
      .swipe-hint {
        display: block;
        margin-top: 12px;
        font: 500 8.5px/1 var(--mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--faint);
      }
    }
</style>
