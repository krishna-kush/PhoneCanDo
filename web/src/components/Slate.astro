---
/** Video slate shown until a recording is dropped in. Never fake UI. */
interface Props {
  slot?: string;
  label?: string;
  glyph?: boolean;
  big?: string;
}
const { slot, label = 'Screen recording', glyph = false, big } = Astro.props;
---

<div class="slate">
  {
    big ? (
      <span class="rec"><i></i>Rec</span>
    ) : (
      slot && <span class="rec"><i></i>Slot {slot}</span>
    )
  }
  {big && <span class="ghost" aria-hidden="true">{big}</span>}
  {
    glyph ? (
      <span class="glyph" aria-hidden="true">
        <svg width="10" height="12" viewBox="0 0 10 12" fill="currentColor">
          <path d="M0 0l10 6-10 6z" />
        </svg>
      </span>
    ) : (
      !big && <span class="mark" aria-hidden="true" />
    )
  }
  <span class="label">{label}</span>
</div>

<style is:global>
  .slate {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 22px;
    text-align: center;
  }
  .slate::before {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 0;
    pointer-events: none;
  }
  .slate .ghost {
    font: 500 clamp(28px, 6vw, 40px)/1 var(--mono);
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.07);
  }
  .slate .rec {
    position: absolute;
    top: 22px;
    left: 22px;
    display: flex;
    align-items: center;
    gap: 6px;
    font: 500 9px/1 var(--mono);
    letter-spacing: 0.12em;
    color: var(--art-muted);
    text-transform: uppercase;
  }
  .slate .rec i {
    width: 5px;
    height: 5px;
    border-radius: 0;
    background: var(--red);
    animation: blink 2s steps(1) infinite;
  }
  .slate .glyph {
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0;
    display: grid;
    place-items: center;
    color: var(--art-fg);
    transition: transform 0.2s;
  }
  .slate .label {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    font: 500 9px/1.5 var(--mono);
    letter-spacing: 0.12em;
    color: var(--art-dim);
    text-transform: uppercase;
  }
  .slate .mark {
    width: 1px;
    height: 26px;
    background: rgba(255, 255, 255, 0.14);
  }

  @media (prefers-reduced-motion: reduce) {
    .slate .rec i { animation: none; }
    .slate .glyph { transition: none; }
  }
</style>
