---
import { site } from '../data/site';
import LogoMark from './LogoMark.astro';
---

<footer class="footer">
  <div class="footer-mark" aria-hidden="true">
    <LogoMark size={0.6} unit="em" />
    <span class="fm-word"><span class="fm-phone">phone</span><span class="fm-can">can</span><span class="fm-do">do</span></span>
  </div>
  <div class="footer-inner">
    <div>
      <a href="/" class="brand" aria-label={`${site.name} home`}>
        phonecando
      </a>
      <p class="meta">
        Alpha software, built on a phone. Bundles open-source agent components under their own
        licenses. Android is a trademark of Google LLC. Not affiliated with Google or opencode.
      </p>
    </div>

    <nav class="footer-links" aria-label="Elsewhere">
      <a href={site.repo} target="_blank" rel="noreferrer">GitHub</a>
      <a href={`${site.repo}/blob/main/THIRD_PARTY_NOTICES.md`} target="_blank" rel="noreferrer">Licenses</a>
      <a href={site.releases} target="_blank" rel="noreferrer">Releases</a>
      <a href="/#install">Install</a>
      <a href="/#faq">FAQ</a>
    </nav>
  </div>

  <div class="colophon">
    <div class="barcode" aria-hidden="true"></div>
    <p>PhoneCanDo Field Manual / Ed. {site.version} / Set in Instrument Serif &amp; Geist Mono / Printed on a phone.</p>
    <p class="serial">FM-01 · A-01 · {site.arch}</p>
  </div>
</footer>
