---
import { site } from '../data/site';
import { code128 } from '../lib/code128';
import LogoMark from './LogoMark.astro';

// The colophon's barcode is real: Code 128 of the site's own address, dark
// bars on the paper (a white label on the dark theme). Encoded at build time
// into one SVG path, like the install plate's QR; each bar is one rectangle,
// and the 10-module margins either side are the spec's quiet zone.
if (!Astro.site) throw new Error('astro.config.mjs needs `site`: the footer barcode encodes it');
const home = Astro.site.origin;
const QUIET = 10;
const code = code128(home);
const codeModules = code.width + 2 * QUIET;
const codePath = code.bars.map(({ x, w }) => `M${x + QUIET} 0h${w}v1h-${w}z`).join('');
---

<footer class="footer">
  <div class="footer-mark" aria-hidden="true">
    <LogoMark size={0.6} unit="em" />
    <span class="fm-word"><span class="fm-phone">phone</span><span class="fm-can">can</span><span class="fm-do">do</span></span>
  </div>
  <div class="footer-inner">
    <div>
      <a href="/" class="brand" aria-label={`${site.name} home`}>
        phonecando
      </a>
      <p class="meta">
        Alpha software, built on a phone. Bundles open-source agent components under their own
        licenses. Android is a trademark of Google LLC. Not affiliated with Google or opencode.
      </p>
    </div>

    <nav class="footer-links" aria-label="Elsewhere">
      <a href={site.repo} target="_blank" rel="noreferrer">GitHub</a>
      <a href={`${site.repo}/blob/HEAD/THIRD_PARTY_NOTICES.md`} target="_blank" rel="noreferrer">Licenses</a>
      <a href={site.releases} target="_blank" rel="noreferrer">Releases</a>
      <a href="/#install">Install</a>
      <a href="/#faq">FAQ</a>
      <a href="/privacy/">Privacy</a>
    </nav>
  </div>

  <div class="colophon">
    <figure class="colophon-code" style={`--modules:${codeModules}`}>
      <svg
        viewBox={`0 0 ${codeModules} 1`}
        preserveAspectRatio="none"
        shape-rendering="crispEdges"
        role="img"
        aria-label="Barcode of this site's address"
      >
        <path d={codePath} />
      </svg>
      <figcaption>{home}</figcaption>
    </figure>
    <p>PhoneCanDo Field Manual / Ed. {site.version} / Set in Instrument Serif &amp; Geist Mono / Printed on a phone.</p>
    <p class="serial">FM-01 · A-01 · {site.arch}</p>
  </div>
</footer>

<style is:global>
  /* This one is only the page's grain at rest — no colour face. A grey wash
     under the grain keeps it readable. Hover on the mark alone snaps the ink
     on, then the line lifts; no fade. Colour runs are real spans (no clipped
     background), and both colour boundaries get the same hair gap so the
     tracking reads evenly after "phone" and after "can". */
  .footer-mark .pc-mark,
  .footer-mark .fm-word { transition: transform 0.18s ease; }
  .footer-mark .pc-mark::before,
  .footer-mark .pc-mark::after {
    content: '';
    position: absolute;
    width: var(--pc-s);
    height: var(--pc-s);
    background-repeat: no-repeat;
    background-size: var(--pc-s) var(--pc-s);
  }
  .footer-mark .pc-mark::before {
    left: 0;
    top: 0;
    z-index: 1;
    background-color: var(--line-2);
    background-image: var(--grain);
    box-shadow: none;
  }
  .footer-mark .pc-mark::after {
    left: var(--pc-o);
    top: var(--pc-o);
    z-index: 0;
    background-color: var(--line);
    background-image: var(--grain);
  }
  .footer-mark .fm-word .fm-can,
  .footer-mark .fm-word .fm-do { margin-left: 0.04em; }
  .footer-mark .pc-mark:hover {
    opacity: 0.78;
    transform: translate(-2px, -2px);
  }
  .footer-mark .pc-mark:hover::before {
    background-color: var(--red);
    background-image: none;
  }
  .footer-mark .pc-mark:hover::after {
    background-color: var(--accent);
    background-image: none;
  }
  .footer-mark .pc-mark:hover + .fm-word {
    opacity: 0.78;
    transform: translateY(-2px);
  }
  .footer-mark .pc-mark:hover + .fm-word .fm-phone,
  .footer-mark .pc-mark:hover + .fm-word .fm-do { color: var(--red); }
  .footer-mark .pc-mark:hover + .fm-word .fm-can { color: var(--accent); }

  .footer { border-top: 1px solid var(--line); padding: 34px var(--pad) 40px; }
  .footer-mark {
    display: flex;
    align-items: center;
    gap: 0.08em;
    margin: 0 0 30px;
    font: 400 clamp(76px, 17vw, 230px)/0.78 var(--serif);
    letter-spacing: -0.05em;
    color: var(--line-2);
    user-select: none;
    white-space: nowrap;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 28px;
    align-items: start;
  }
  .footer .brand { font-size: 14px; }
  .footer .meta { margin-top: 10px; font: 400 10px/1.7 var(--mono); color: var(--faint); max-width: 46ch; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: flex-end; }
  .footer-links a { font: 500 10px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .footer-links a:hover { color: var(--red); }
  .colophon {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    margin-top: 30px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  /* The barcode, with the address it holds under it: the sheet's ink on
     the paper, and on the dark theme black on a white label, like the
     product artefacts. A module is a whole number of CSS px (--mod), so
     bars land on whole pixels: two where the colophon has the room, one on
     narrower screens. */
  .colophon-code {
    --mod: 1px;
    --bar-h: 34px;
    flex: none;
    margin: 0;
    padding: 6px 0 5px;
    color: var(--fg);
  }
  [data-theme='dark'] .colophon-code { background: var(--art-fg); color: var(--art-bg); }
  .colophon-code svg {
    display: block;
    width: calc(var(--modules) * var(--mod));
    height: var(--bar-h);
    fill: currentColor;
  }
  .colophon-code figcaption {
    margin-top: 4px;
    font: 500 7.5px/1 var(--mono);
    letter-spacing: 0.14em;
    text-align: center;
  }

  @media (min-width: 1100px) {
    .colophon-code { --mod: 2px; --bar-h: 44px; }
  }
  .colophon p {
    font: 500 8px/1.5 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .colophon .serial { margin-left: auto; text-align: right; white-space: nowrap; }

  @media (max-width: 760px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-links { justify-content: flex-start; }
    .colophon { flex-wrap: wrap; align-items: flex-start; }
    .colophon .serial { margin-left: 0; text-align: left; }
  }
  @media (max-width: 420px) {
    .footer-mark { font-size: clamp(56px, 18vw, 100px); }
  }
</style>
