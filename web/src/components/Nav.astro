---
import { site } from '../data/site';
import LogoMark from './LogoMark.astro';
---

<header class="nav">
  <a href="/" class="brand" aria-label={`${site.name} home`}>
    <LogoMark size={13} />
    phonecando
  </a>
  <span class="nav-doc" aria-hidden="true">Field manual / FM-01</span>

  <nav class="nav-links" aria-label="Sections">
    <a href="/#demos">Demos</a>
    <a href="/#models">Models</a>
    <a href="/#linux">Linux</a>
    <a href="/#gate">Gate</a>
    <a href="/#install">Install</a>
    <a href="/#faq">FAQ</a>
  </nav>

  <div class="nav-cta">
    <button class="theme-toggle" type="button" aria-label="Toggle light and dark theme" title="Toggle theme">
      <svg class="sun" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
        <circle cx="8" cy="8" r="3.2"></circle>
        <path d="M8 1v1.8M8 13.2V15M1 8h1.8M13.2 8H15M3.05 3.05l1.27 1.27M11.68 11.68l1.27 1.27M12.95 3.05l-1.27 1.27M4.32 11.68l-1.27 1.27"></path>
      </svg>
      <svg class="moon" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
        <path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z"></path>
      </svg>
    </button>
    <a class="btn btn-ghost ghost" href={site.repo} target="_blank" rel="noreferrer">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
      GitHub
    </a>
    <a class="btn btn-primary" href="/#install">
      Download APK
      <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M6 1v8M2.5 5.5 6 9l3.5-3.5M1 11h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</header>
