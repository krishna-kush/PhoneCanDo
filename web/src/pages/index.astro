---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Demos from "../components/sections/Demos.astro";
import Models from "../components/sections/Models.astro";
import Linux from "../components/sections/Linux.astro";
import Crew from "../components/sections/Crew.astro";
import Schedules from "../components/sections/Schedules.astro";
import Gate from "../components/sections/Gate.astro";
import Install from "../components/sections/Install.astro";
import Faq from "../components/sections/Faq.astro";
import Source from "../components/sections/Source.astro";
import Mascot from "../components/Mascot.astro";
import Backdrop from "../components/Backdrop.astro";
---

<Base>
    <Backdrop />
    <div class="page">
        <Nav />

        <main id="top">
            <Hero />
            <Demos />
            <Models />
            <Linux />
            <Crew />
            <Schedules />
            <Gate />
            <Install />
            <Source />
            <Faq />
        </main>

        <Footer />
    </div>
    <Mascot />
</Base>
