---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Mascot from "../components/Mascot.astro";
import Hello from "../components/privacy/Hello.astro";
import ShortVersion from "../components/privacy/ShortVersion.astro";
import AppSends from "../components/privacy/AppSends.astro";
import NeverSends from "../components/privacy/NeverSends.astro";
import Controls from "../components/privacy/Controls.astro";
import Extras from "../components/privacy/Extras.astro";
import ThisSite from "../components/privacy/ThisSite.astro";
import Retention from "../components/privacy/Retention.astro";
import Elsewhere from "../components/privacy/Elsewhere.astro";
import Questions from "../components/privacy/Questions.astro";
import { site } from "../data/site";

// The privacy note: the plain-language twin of docs/telemetry.md (the
// published schema). Its copy lives in components/privacy/, one file per
// section; change it with that page. tce/AGENTS.md §5 says a new field ships
// with its docs. Section ids are A-01's scenes (data/mascot.ts).
---

<Base
    title={`Privacy · ${site.name}`}
    description="What PhoneCanDo sends home, what it never sends, where it is kept, and how to turn it off or delete it."
>
    <div class="page">
        <Nav />

        <main class="privacy">
            <Hello />
            <ShortVersion />
            <AppSends />
            <NeverSends />
            <Controls />
            <Extras />
            <ThisSite />
            <Retention />
            <Elsewhere />
            <Questions />
        </main>

        <Footer />
    </div>
    <Mascot />
</Base>

<style is:global>
    /* What every section of the note shares: a numbered sticker slapped on
       at an angle, a mono kicker with the joke, then the plain heading.
       Each section's own look lives in its component. */
    .privacy {
      --pv-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .pv-sec {
      position: relative;
      padding: clamp(64px, 8vw, 104px) var(--pad);
      border-top: 1px solid var(--line);
      scroll-margin-top: 58px;
    }
    /* Graph paper, fading out from the top left. */
    .pv-paper::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(to right, var(--grid) 1px, transparent 1px),
        linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
      background-size: 32px 32px;
      -webkit-mask-image: radial-gradient(80% 90% at 20% 30%, #000 0%, transparent 80%);
      mask-image: radial-gradient(80% 90% at 20% 30%, #000 0%, transparent 80%);
      pointer-events: none;
    }
    .pv-paper > * { position: relative; }
    .pv-tint { background: var(--panel); }

    .pv-head {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(18px, 2.6vw, 30px);
      margin-bottom: clamp(32px, 4.6vw, 52px);
    }
    .pv-num {
      grid-row: span 2;
      display: grid;
      place-items: center;
      width: clamp(56px, 6vw, 74px);
      aspect-ratio: 1;
      background: var(--red);
      color: var(--on-primary);
      font: 400 clamp(30px, 3.4vw, 40px)/1 var(--serif);
      box-shadow: 4px 4px 0 var(--accent);
      rotate: -6deg;
      transition: rotate 0.35s var(--pv-spring), scale 0.35s var(--pv-spring);
    }
    .pv-sec:nth-child(odd) .pv-num { rotate: 5deg; }
    .pv-head:hover .pv-num { rotate: 0deg; scale: 1.08; }
    .pv-kicker {
      align-self: end;
      font: 500 10px/1.4 var(--mono);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent-ink);
    }
    .pv-head h2 {
      align-self: start;
      margin-top: 6px;
      font: 400 clamp(38px, 5.2vw, 66px)/0.98 var(--serif);
      letter-spacing: -0.02em;
    }
    .pv-head h2 em { font-style: italic; color: var(--red); }
    .pv-lead {
      grid-column: 2;
      margin-top: 16px;
      max-width: 60ch;
      font-size: 15px;
      line-height: 1.65;
      color: var(--muted);
      text-wrap: pretty;
    }
    .pv-lead b { color: var(--fg); font-weight: 500; }

    @media (max-width: 620px) {
      .pv-head { grid-template-columns: 1fr; row-gap: 12px; }
      .pv-num { grid-row: auto; width: 52px; font-size: 28px; }
      .pv-lead { grid-column: 1; margin-top: 4px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pv-num { transition: none; }
    }
</style>
