---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Base
  title={`404 — Page not found · ${site.name}`}
  description="That sheet was never printed."
  noindex
>
  <div class="page">
    <Nav />

    <main class="missing">
      <div class="miss-copy">
        <p class="eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Error 404 · Lookup failed
        </p>
        <h1>This sheet was <em>never printed.</em></h1>
        <p class="hero-sub">
          The address you followed doesn’t match a page in the manual. Nothing is broken and
          nothing left the device — <strong>the sheet just isn’t here.</strong>
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M11 6H1M4.5 2.5 1 6l3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            Back to the field manual
          </a>
          <a class="btn btn-ghost" href={site.repo} target="_blank" rel="noreferrer">
            GitHub
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 10 10 2M4 2h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <p class="miss-note">
          Or jump to <a href="/#demos">demos</a>, <a href="/#install">install</a> or{" "}
          <a href="/#faq">the FAQ</a>.
        </p>
      </div>

      <figure class="miss-plate">
        <div class="miss-head">
          <p class="fig-label">FIG. 404 — Requested sheet</p>
          <span class="stamp">Not on file</span>
        </div>
        <div class="miss-sheet">
          <p class="miss-code" aria-hidden="true">4<span>0</span>4</p>
          <dl class="miss-rows">
            <div>
              <dt>Request</dt>
              <dd id="miss-path">this page</dd>
            </div>
            <div>
              <dt>Response</dt>
              <dd class="miss-red">404 · not found</dd>
            </div>
            <div>
              <dt>Manual</dt>
              <dd>0 matching sheets</dd>
            </div>
          </dl>
        </div>
        <figcaption class="miss-foot">
          <span>FM-01 / A-01</span>
          <span>Plate 000 / missing</span>
        </figcaption>
      </figure>
    </main>

    <Footer />
  </div>

  <script is:inline>
    // A static 404 does not know the request; show the path the visitor hit.
    const path = location.pathname + location.search;
    const el = document.getElementById('miss-path');
    if (el) el.textContent = path;
  </script>
</Base>

<style is:global>
  .missing {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 400px);
    gap: clamp(36px, 6vw, 80px);
    align-items: center;
    padding: clamp(56px, 8vh, 92px) var(--pad) clamp(72px, 10vh, 112px);
    overflow: clip;
  }
  .missing::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(75% 95% at 30% 45%, #000 0%, transparent 78%);
    mask-image: radial-gradient(75% 95% at 30% 45%, #000 0%, transparent 78%);
    pointer-events: none;
  }
  .missing > * { position: relative; }
  .miss-note {
    margin-top: 20px;
    font: 500 9.5px/1.7 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .miss-note a {
    color: var(--muted);
    border-bottom: 1px solid var(--line-2);
  }
  .miss-note a:hover { color: var(--red); border-bottom-color: var(--red); }

  .miss-plate { width: 100%; max-width: 400px; margin: 0 0 0 auto; }
  .miss-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .miss-head .stamp { margin-top: 2px; }
  .miss-sheet {
    position: relative;
    padding: clamp(20px, 3vw, 28px) clamp(18px, 3vw, 26px) 22px;
    border: 1px solid var(--line-2);
    border-radius: 0;
    background-color: var(--panel-2);
    background-image:
      linear-gradient(to right, var(--grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
    background-size: 26px 26px;
    box-shadow: 5px 5px 0 var(--accent);
    overflow: hidden;
  }
  .miss-sheet::before,
  .miss-sheet::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--accent);
    pointer-events: none;
  }
  .miss-sheet::before { top: 7px; left: 7px; border-top: 1px solid; border-left: 1px solid; }
  .miss-sheet::after { right: 7px; bottom: 7px; border-right: 1px solid; border-bottom: 1px solid; }
  .miss-code {
    margin: 2px 0 22px;
    text-align: center;
    font: 400 clamp(104px, 13vw, 164px)/0.82 var(--serif);
    letter-spacing: -0.045em;
    color: var(--line-2);
    user-select: none;
  }
  .miss-code span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--red);
  }
  .miss-rows {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .miss-rows div {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .miss-rows dt {
    font: 500 8px/1.65 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .miss-rows dd {
    margin: 0;
    font: 400 10.5px/1.65 var(--mono);
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .miss-rows .miss-red { color: var(--red); }
  .miss-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    font: 500 8px/1.4 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (max-width: 980px) {
    .missing { grid-template-columns: minmax(0, 1fr) 320px; gap: 36px; }
  }
  @media (max-width: 860px) {
    .missing { grid-template-columns: 1fr; gap: 40px; }
    .miss-plate { max-width: 440px; width: 100%; margin-inline: auto; }
  }
</style>
