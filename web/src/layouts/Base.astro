---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import serifUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import serifItalicUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import "../styles/global.css";
import tokens from "../../../theme/tokens.json";
import { logoLoaderCss } from "../lib/logoLoaderCss";
import { hitUrl, site } from "../data/site";

interface Props {
    title?: string;
    description?: string;
    noindex?: boolean;
}
const {
    title = `${site.name} · ${site.tagline}`,
    description = "PhoneCanDo runs an AI agent on your Android. It reads the screen, uses the apps, and works in a full terminal. No PC, no cloud relay.",
    noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Cascade layer order for src/styles (see global.css). Inline and first in
// <head>, so it is declared before any bundled CSS and the minifier never
// touches it. Component <style>s stay unlayered and beat both.
const layerOrder = "@layer base, primitives;";

// The serif is the h1's face. Its files are found only once the CSS is in and
// the heading laid out, so the headline painted in Georgia and then swapped;
// preloading them starts the fetch with the page.
const fontPreloads = [serifUrl, serifItalicUrl];

// theme/tokens.json is the single source for the site and the app. Roles map
// onto the var names the stylesheets already use, so they need no renames
// when a token changes.
const VAR_NAMES: [keyof typeof tokens.dark, string][] = [
    ["bg", "bg"],
    ["panel", "panel"],
    ["panel2", "panel-2"],
    ["line", "line"],
    ["lineStrong", "line-2"],
    ["fg", "fg"],
    ["muted", "muted"],
    ["dim", "dim"],
    ["faint", "faint"],
    ["primary", "red"],
    ["primaryHi", "red-hi"],
    ["primarySoft", "red-soft"],
    ["onPrimary", "on-primary"],
    ["secondary", "accent"],
    ["secondaryInk", "accent-ink"],
    ["secondarySoft", "accent-soft"],
    ["secondaryLine", "accent-line"],
];
const vars = (t: typeof tokens.dark) =>
    VAR_NAMES.map(([role, name]) => `--${name}:${t[role]}`).join(";");
const themeCss = `:root{${vars(tokens.dark)}}[data-theme='light']{${vars(tokens.light)}}`;
const themeInit = `(() => {
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');
  const apply = (t) => {
    root.dataset.theme = t;
    if (meta) meta.content = t === 'light' ? '${tokens.light.bg}' : '${tokens.dark.bg}';
  };
  apply(matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element) || !e.target.closest('.theme-toggle')) return;
    apply(root.dataset.theme === 'light' ? 'dark' : 'light');
  });
})();`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        {fontPreloads.map((href) => (
            <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
        ))}
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta name="theme-color" content={tokens.dark.bg} />
        {noindex ? <meta name="robots" content="noindex" /> : null}
        <style is:inline set:html={layerOrder} />
        <style is:inline set:html={themeCss} />
        <style is:inline set:html={logoLoaderCss} />
        <script is:inline set:html={themeInit} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link
            rel="icon"
            href="/favicon-32x32.png"
            sizes="32x32"
            type="image/png"
        />
        <link
            rel="icon"
            href="/favicon-16x16.png"
            sizes="16x16"
            type="image/png"
        />
        <link
            rel="apple-touch-icon"
            href="/apple-touch-icon.png"
            sizes="180x180"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL("/og.png", Astro.site)} />
        <meta name="twitter:card" content="summary_large_image" />
    </head>
    <body>
        <slot />
        <script is:inline>
            // Drive the logo loader on media that is actually loading. Posters and
            // slates stay still; playback starts the loader, canplay hides it.
            (() => {
                for (const video of document.querySelectorAll("video")) {
                    const frame = video.closest("[data-media]");
                    if (!frame) continue;
                    const set = (on) => {
                        frame.dataset.loading = on ? "true" : "false";
                    };
                    video.addEventListener("loadstart", () => set(true));
                    video.addEventListener("waiting", () => set(true));
                    video.addEventListener("canplay", () => set(false));
                    video.addEventListener("playing", () => set(false));
                    video.addEventListener("error", () => set(false));
                    if (!video.paused) set(true);
                }
            })();
        </script>
        <script is:inline define:vars={{ hitUrl }}>
            // Page view, first party: one POST to our own Worker on the API
            // host (tce, POST /v1/hit) with the path (no query string) and the
            // referrer, of which only the host is kept. Sent as a string, so
            // text/plain: a JSON content type would make the cross-origin
            // beacon need a CORS preflight, which sendBeacon cannot do. No cookie, no id,
            // nothing stored in the browser; country comes from the edge.
            // Skipped under Do Not Track or Global Privacy Control, and
            // anywhere but a public https host, so the dev server, CI's static
            // server, Playwright and Lighthouse never send one.
            // docs/telemetry.md and /privacy describe it.
            (() => {
                const nav = navigator;
                if (nav.doNotTrack === "1" || nav.globalPrivacyControl === true) return;
                const host = location.hostname;
                if (location.protocol !== "https:") return;
                if (host === "localhost" || host === "127.0.0.1" || host === "[::1]") return;
                if (typeof nav.sendBeacon !== "function") return;
                nav.sendBeacon(hitUrl, JSON.stringify({ path: location.pathname, ref: document.referrer }));
            })();
        </script>
    </body>
</html>
