{
  "name": "phonecando-tce",
  "version": "0.1.0",
  "private": true,
  "description": "Telemetry Collection Engine: schema, operations, stores and hosts for PhoneCanDo usage data.",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "deps": "node scripts/check-deps.mjs",
    "check": "node scripts/typecheck.mjs && node scripts/check-deps.mjs",
    "test": "node --test --test-timeout=120000 \"core/**/*.test.ts\" \"client/**/*.test.ts\" \"stores/**/*.test.ts\" \"hosts/**/*.test.ts\" \"testkit/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "dev": "node hosts/node/main.ts",
    "cf:dev": "wrangler dev -c hosts/cloudflare/wrangler.jsonc --local --var API_HOSTS:localhost",
    "stats": "node scripts/stats.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "wrangler": "4.157.0"
  }
}
